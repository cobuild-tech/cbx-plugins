@@ -0,0 +1,38 @@
+import React, { useState, FormEvent } from 'react';
+import type { Collection, Model } from 'backbone';
+
+export interface NewItemFormProps {
+  collection: Collection<Model>;
+  /** Called after the server has accepted the new item (wait: true semantics). */
+  onSaved: (model: Model) => void;
+}
+
+export function NewItemForm({ collection, onSaved }: NewItemFormProps) {
+  const [name, setName] = useState('');
+  const [qty, setQty] = useState('1');
+  const [error, setError] = useState('');
+
+  const handleSubmit = (e: FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    collection.create(
+      { name, qty: Number(qty) },
+      {
+        wait: true,
+        success: (m: Model) => onSaved(m),
+        error: (_m: Model, xhr: JQuery.jqXHR) => {
+          const errors = xhr?.responseJSON?.errors;
+          setError(Array.isArray(errors) ? errors.join(', ') : '');
+        },
+      }
+    );
+  };
+
+  return (
+    <form className="new-item" onSubmit={handleSubmit}>
+      <input name="name" value={name} onChange={(e) => setName(e.target.value)} />
+      <input name="qty" type="number" value={qty} onChange={(e) => setQty(e.target.value)} />
+      <button>Add</button>
+      <p className="err">{error}</p>
+    </form>
+  );
+}
diff --git a/src/react/index.ts b/src/react/index.ts
