+++ b/src/react/index.ts
@@ -0,0 +1,20 @@
+import React from 'react';
+import { createRoot } from 'react-dom/client';
+import type { Collection, Model } from 'backbone';
+import { NewItemForm } from './NewItemForm';
+
+/**
+ * Bridge entry point for the remaining Backbone code.
+ * Mounts NewItemForm into `el` and returns a handle to re-render / unmount it.
+ */
+function mountNewItemForm(
+  el: HTMLElement,
+  props: { collection: Collection<Model>; onSaved: (m: Model) => void }
+) {
+  const root = createRoot(el);
+  const render = () => root.render(React.createElement(NewItemForm, props));
+  render();
+  return { render, unmount: () => root.unmount() };
+}
+
+(window as any).app.react = { mountNewItemForm };
