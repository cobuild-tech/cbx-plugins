-    print("processing", order["id"])
+import json
+
+
+def handle(event, context):
+    """SQS FIFO batch handler. Message bodies are the raw order JSON (SNS raw delivery)."""
+    failures = []
+    for record in event["Records"]:
+        if failures:
+            # Preserve per-group ordering: once one fails, retry everything after it.
+            failures.append({"itemIdentifier": record["messageId"]})
+            continue
+        try:
+            order = json.loads(record["body"])
+            print("processing", order["id"])
+        except Exception as exc:
+            print("failed", record["messageId"], exc)
+            failures.append({"itemIdentifier": record["messageId"]})
+    return {"batchItemFailures": failures}
diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..444c2f4
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,513 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = "~> 5.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+variable "project" {
+  type        = string
+  description = "Name prefix (replaces the GCP project id in resource names)"
+}
+variable "region" {
+  type    = string
+  default = "us-east-2" # closest to us-central1
+}
+variable "vpc_id" { type = string }
+variable "public_subnet_ids" { type = list(string) }
+variable "private_subnet_ids" { type = list(string) }
+
+data "aws_caller_identity" "me" {}
+
+# ---------------------------------------------------------------- S3 (GCS)
+resource "aws_s3_bucket" "uploads" {
+  bucket = "${var.project}-uploads"
+}
+
+resource "aws_s3_bucket_ownership_controls" "uploads" {
+  bucket = aws_s3_bucket.uploads.id
+  rule { object_ownership = "BucketOwnerEnforced" } # uniform bucket-level access
+}
+
+resource "aws_s3_bucket_public_access_block" "uploads" {
+  bucket                  = aws_s3_bucket.uploads.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_versioning" "uploads" {
+  bucket = aws_s3_bucket.uploads.id
+  versioning_configuration { status = "Enabled" }
+}
+
+resource "aws_s3_bucket_lifecycle_configuration" "uploads" {
+  bucket     = aws_s3_bucket.uploads.id
+  depends_on = [aws_s3_bucket_versioning.uploads]
+
+  rule {
+    id     = "tier-and-expire"
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 30
+      storage_class = "STANDARD_IA" # NEARLINE equivalent
+    }
+    expiration { days = 365 }
+    noncurrent_version_transition {
+      noncurrent_days = 30
+      storage_class   = "STANDARD_IA"
+    }
+    noncurrent_version_expiration { noncurrent_days = 365 }
+  }
+}
+
+# ------------------------------------------------- SNS + SQS FIFO (Pub/Sub)
+resource "aws_sns_topic" "orders" {
+  name                        = "orders.fifo"
+  fifo_topic                  = true
+  content_based_deduplication = false
+}
+
+resource "aws_sqs_queue" "orders_dlq" {
+  name       = "orders-dlq.fifo"
+  fifo_queue = true
+}
+
+resource "aws_sqs_queue" "orders_worker" {
+  name       = "orders-worker.fifo"
+  fifo_queue = true
+  # Lambda requires visibility timeout >= function timeout (540s); the GCP ack deadline was 60s.
+  visibility_timeout_seconds = 540
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.orders_dlq.arn
+    maxReceiveCount     = 5
+  })
+}
+
+data "aws_iam_policy_document" "orders_queue" {
+  statement {
+    actions   = ["sqs:SendMessage"]
+    resources = [aws_sqs_queue.orders_worker.arn]
+    principals {
+      type        = "Service"
+      identifiers = ["sns.amazonaws.com"]
+    }
+    condition {
+      test     = "ArnEquals"
+      variable = "aws:SourceArn"
+      values   = [aws_sns_topic.orders.arn]
+    }
+  }
+}
+
+resource "aws_sqs_queue_policy" "orders_worker" {
+  queue_url = aws_sqs_queue.orders_worker.id
+  policy    = data.aws_iam_policy_document.orders_queue.json
+}
+
+resource "aws_sns_topic_subscription" "orders_worker" {
+  topic_arn            = aws_sns_topic.orders.arn
+  protocol             = "sqs"
+  endpoint             = aws_sqs_queue.orders_worker.arn
+  raw_message_delivery = true
+}
+
+# ------------------------------------------------------ RDS Postgres (Cloud SQL)
+resource "aws_security_group" "db" {
+  name   = "app-db"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 5432
+    to_port         = 5432
+    protocol        = "tcp"
+    security_groups = [aws_security_group.api.id]
+  }
+}
+
+resource "aws_db_subnet_group" "db" {
+  name       = "app-db"
+  subnet_ids = var.private_subnet_ids
+}
+
+resource "aws_db_instance" "db" {
+  identifier                          = "app-db"
+  engine                              = "postgres"
+  engine_version                      = "15"
+  instance_class                      = "db.m6g.large" # 2 vCPU / 8 GiB ~ db-custom-2-7680
+  allocated_storage                   = 100
+  storage_encrypted                   = true
+  multi_az                            = true # availability_type = REGIONAL
+  iam_database_authentication_enabled = true
+  username                            = "postgres"
+  manage_master_user_password         = true
+  backup_retention_period             = 7 # enables automated backups + point-in-time recovery
+  db_subnet_group_name                = aws_db_subnet_group.db.name
+  vpc_security_group_ids              = [aws_security_group.db.id]
+  skip_final_snapshot                 = false
+  final_snapshot_identifier           = "app-db-final"
+}
+
+# ------------------------------------------------------------ IAM (service account)
+data "aws_iam_policy_document" "ecs_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "api" {
+  name               = "api-sa"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+
+data "aws_iam_policy_document" "api" {
+  statement { # roles/storage.objectAdmin
+    actions   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListBucket", "s3:GetObjectVersion", "s3:DeleteObjectVersion"]
+    resources = [aws_s3_bucket.uploads.arn, "${aws_s3_bucket.uploads.arn}/*"]
+  }
+  statement { # publish orders
+    actions   = ["sns:Publish"]
+    resources = [aws_sns_topic.orders.arn]
+  }
+  statement { # rollup job (BigQuery -> Athena)
+    actions = [
+      "athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults",
+      "glue:GetDatabase", "glue:GetTable", "glue:GetTables", "glue:GetPartitions",
+      "glue:CreateTable", "glue:DeleteTable", "glue:UpdateTable",
+    ]
+    resources = ["*"]
+  }
+  statement {
+    actions   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:AbortMultipartUpload"]
+    resources = [aws_s3_bucket.athena.arn, "${aws_s3_bucket.athena.arn}/*"]
+  }
+  statement { # cloudsql.iam_authentication
+    actions   = ["rds-db:connect"]
+    resources = ["arn:aws:rds-db:${var.region}:${data.aws_caller_identity.me.account_id}:dbuser:${aws_db_instance.db.resource_id}/*"]
+  }
+}
+
+resource "aws_iam_role_policy" "api" {
+  role   = aws_iam_role.api.id
+  policy = data.aws_iam_policy_document.api.json
+}
+
+# ------------------------------------------------- ECS Fargate + ALB (Cloud Run)
+resource "aws_ecr_repository" "api" {
+  name = "app/api"
+}
+
+resource "aws_cloudwatch_log_group" "api" {
+  name = "/ecs/api"
+}
+
+resource "aws_iam_role" "api_exec" {
+  name               = "api-exec"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "api_exec" {
+  role       = aws_iam_role.api_exec.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+resource "aws_ecs_cluster" "main" {
+  name = "app"
+}
+
+resource "aws_security_group" "alb" {
+  name   = "api-alb"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port   = 80
+    to_port     = 80
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_security_group" "api" {
+  name   = "api-tasks"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 8080
+    to_port         = 8080
+    protocol        = "tcp"
+    security_groups = [aws_security_group.alb.id]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_lb" "api" {
+  name               = "api"
+  load_balancer_type = "application"
+  subnets            = var.public_subnet_ids
+  security_groups    = [aws_security_group.alb.id]
+  idle_timeout       = 900 # Cloud Run request timeout
+}
+
+resource "aws_lb_target_group" "api" {
+  name        = "api"
+  port        = 8080
+  protocol    = "HTTP"
+  target_type = "ip"
+  vpc_id      = var.vpc_id
+  health_check {
+    path    = "/"
+    matcher = "200-404"
+  }
+}
+
+resource "aws_lb_listener" "http" {
+  load_balancer_arn = aws_lb.api.arn
+  port              = 80
+  protocol          = "HTTP"
+  default_action {
+    type             = "forward"
+    target_group_arn = aws_lb_target_group.api.arn
+  }
+}
+
+resource "aws_ecs_task_definition" "api" {
+  family                   = "api"
+  requires_compatibilities = ["FARGATE"]
+  network_mode             = "awsvpc"
+  cpu                      = "2048"
+  memory                   = "4096" # Fargate minimum for 2 vCPU (Cloud Run had 1Gi)
+  task_role_arn            = aws_iam_role.api.arn
+  execution_role_arn       = aws_iam_role.api_exec.arn
+  container_definitions = jsonencode([{
+    name         = "api"
+    image        = "${aws_ecr_repository.api.repository_url}:latest"
+    essential    = true
+    portMappings = [{ containerPort = 8080 }]
+    environment = [
+      { name = "BUCKET", value = aws_s3_bucket.uploads.bucket },
+      { name = "TOPIC_ARN", value = aws_sns_topic.orders.arn },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.analytics.name },
+      { name = "ATHENA_DATABASE", value = aws_glue_catalog_database.analytics.name },
+      { name = "ATHENA_OUTPUT_BUCKET", value = aws_s3_bucket.athena.bucket },
+      { name = "AWS_REGION", value = var.region },
+      { name = "DB_HOST", value = aws_db_instance.db.address },
+    ]
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        awslogs-group         = aws_cloudwatch_log_group.api.name
+        awslogs-region        = var.region
+        awslogs-stream-prefix = "api"
+      }
+    }
+  }])
+}
+
+resource "aws_ecs_service" "api" {
+  name            = "api"
+  cluster         = aws_ecs_cluster.main.id
+  task_definition = aws_ecs_task_definition.api.arn
+  desired_count   = 1
+  launch_type     = "FARGATE"
+  network_configuration {
+    subnets          = var.private_subnet_ids
+    security_groups  = [aws_security_group.api.id]
+    assign_public_ip = false # private subnets need NAT/VPC endpoints for ECR, S3, SNS, Athena
+  }
+  load_balancer {
+    target_group_arn = aws_lb_target_group.api.arn
+    container_name   = "api"
+    container_port   = 8080
+  }
+  depends_on = [aws_lb_listener.http]
+  lifecycle { ignore_changes = [desired_count] }
+}
+
+resource "aws_appautoscaling_target" "api" {
+  service_namespace  = "ecs"
+  resource_id        = "service/${aws_ecs_cluster.main.name}/${aws_ecs_service.api.name}"
+  scalable_dimension = "ecs:service:DesiredCount"
+  min_capacity       = 1
+  max_capacity       = 20
+}
+
+resource "aws_appautoscaling_policy" "api" {
+  name               = "api-requests"
+  service_namespace  = aws_appautoscaling_target.api.service_namespace
+  resource_id        = aws_appautoscaling_target.api.resource_id
+  scalable_dimension = aws_appautoscaling_target.api.scalable_dimension
+  policy_type        = "TargetTrackingScaling"
+  target_tracking_scaling_policy_configuration {
+    target_value = 80 # requests per task (~ Cloud Run concurrency of 80)
+    predefined_metric_specification {
+      predefined_metric_type = "ALBRequestCountPerTarget"
+      resource_label         = "${aws_lb.api.arn_suffix}/${aws_lb_target_group.api.arn_suffix}"
+    }
+  }
+}
+
+# ------------------------------------------------------- Lambda worker (Cloud Function)
+data "archive_file" "worker" {
+  type        = "zip"
+  source_file = "${path.module}/../app/worker.py"
+  output_path = "${path.module}/.build/worker.zip"
+}
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "worker" {
+  name               = "orders-worker"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "worker_sqs" {
+  role       = aws_iam_role.worker.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaSQSQueueExecutionRole"
+}
+
+resource "aws_lambda_function" "worker" {
+  function_name    = "orders-worker"
+  role             = aws_iam_role.worker.arn
+  runtime          = "python3.12"
+  handler          = "worker.handle"
+  timeout          = 540
+  memory_size      = 512
+  filename         = data.archive_file.worker.output_path
+  source_code_hash = data.archive_file.worker.output_base64sha256
+}
+
+resource "aws_lambda_event_source_mapping" "worker" {
+  event_source_arn        = aws_sqs_queue.orders_worker.arn
+  function_name           = aws_lambda_function.worker.arn
+  batch_size              = 10
+  function_response_types = ["ReportBatchItemFailures"]
+}
+
+# ------------------------------------------------------- Athena/Glue (BigQuery)
+resource "aws_glue_catalog_database" "analytics" {
+  name = "analytics"
+}
+
+resource "aws_s3_bucket" "athena" {
+  bucket = "${var.project}-athena"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena" {
+  bucket                  = aws_s3_bucket.athena.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_athena_workgroup" "analytics" {
+  name = "analytics"
+  configuration {
+    enforce_workgroup_configuration = true
+    engine_version { selected_engine_version = "Athena engine version 3" }
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena.bucket}/results/"
+    }
+  }
+}
+
+# ------------------------------------------------------- EventBridge Scheduler (Cloud Scheduler)
+# Scheduler cannot call arbitrary HTTP URLs directly (and API destinations time out at 5s),
+# so a small Lambda makes the long-running POST.
+data "archive_file" "trigger" {
+  type        = "zip"
+  source_file = "${path.module}/scheduler_trigger.py"
+  output_path = "${path.module}/.build/scheduler_trigger.zip"
+}
+
+resource "aws_iam_role" "trigger" {
+  name               = "nightly-rollup-trigger"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "trigger_logs" {
+  role       = aws_iam_role.trigger.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_lambda_function" "trigger" {
+  function_name    = "nightly-rollup-trigger"
+  role             = aws_iam_role.trigger.arn
+  runtime          = "python3.12"
+  handler          = "scheduler_trigger.handler"
+  timeout          = 900
+  filename         = data.archive_file.trigger.output_path
+  source_code_hash = data.archive_file.trigger.output_base64sha256
+  environment {
+    variables = { URL = "http://${aws_lb.api.dns_name}/jobs/rollup" }
+  }
+}
+
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "scheduler" {
+  name               = "nightly-rollup-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = "lambda:InvokeFunction"
+      Resource = aws_lambda_function.trigger.arn
+    }]
+  })
+}
+
+resource "aws_scheduler_schedule" "nightly" {
+  name                         = "nightly-rollup"
+  schedule_expression          = "cron(0 2 * * ? *)"
+  schedule_expression_timezone = "America/New_York"
+  flexible_time_window { mode = "OFF" }
+  target {
+    arn      = aws_lambda_function.trigger.arn
+    role_arn = aws_iam_role.scheduler.arn
+    retry_policy { maximum_retry_attempts = 0 }
+  }
+}
+
+output "api_url" {
+  value = "http://${aws_lb.api.dns_name}"
+}
diff --git a/aws/scheduler_trigger.py b/aws/scheduler_trigger.py
new file mode 100644
index 0000000..c9de1b0
--- /dev/null
+++ b/aws/scheduler_trigger.py
@@ -0,0 +1,8 @@
+import os
+import urllib.request
+
+
+def handler(event, context):
+    req = urllib.request.Request(os.environ["URL"], data=b"", method="POST")
+    with urllib.request.urlopen(req, timeout=890) as resp:
+        return {"status": resp.status}
