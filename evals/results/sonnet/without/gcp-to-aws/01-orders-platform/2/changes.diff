-import base64, json, functions_framework
-@functions_framework.cloud_event
-def handle(event):
-    order = json.loads(base64.b64decode(event.data["message"]["data"]))
-    print("processing", order["id"])
+import json
+
+
+def handle(event, context):
+    """SQS FIFO batch handler. On failure, also fail the rest of that message
+    group so per-customer ordering is preserved on redelivery."""
+    failures, failed_groups = [], set()
+    for rec in event["Records"]:
+        group = rec["attributes"].get("MessageGroupId")
+        if group in failed_groups:
+            failures.append({"itemIdentifier": rec["messageId"]})
+            continue
+        try:
+            order = json.loads(rec["body"])
+            print("processing", order["id"])
+        except Exception as e:
+            print("failed", rec["messageId"], e)
+            failed_groups.add(group)
+            failures.append({"itemIdentifier": rec["messageId"]})
+    return {"batchItemFailures": failures}
diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..f3ed1d6
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,492 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = "~> 5.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.0" }
+  }
+}
+
+provider "aws" { region = var.region }
+
+variable "project" { type = string } # used as name prefix (bucket names are global)
+variable "region" {
+  type    = string
+  default = "us-east-1"
+}
+variable "vpc_id" { type = string }
+variable "public_subnet_ids" { type = list(string) }  # ALB (>= 2 AZs)
+variable "private_subnet_ids" { type = list(string) } # ECS + RDS (>= 2 AZs, NAT or VPC endpoints for egress)
+
+data "aws_caller_identity" "me" {}
+
+# ---------------------------------------------------------------- Storage (GCS -> S3)
+resource "aws_s3_bucket" "uploads" { bucket = "${var.project}-uploads" }
+
+resource "aws_s3_bucket_public_access_block" "uploads" {
+  bucket                  = aws_s3_bucket.uploads.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_versioning" "uploads" {
+  bucket = aws_s3_bucket.uploads.id
+  versioning_configuration { status = "Enabled" }
+}
+
+resource "aws_s3_bucket_lifecycle_configuration" "uploads" {
+  bucket     = aws_s3_bucket.uploads.id
+  depends_on = [aws_s3_bucket_versioning.uploads]
+
+  rule {
+    id     = "tier-and-expire"
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 30
+      storage_class = "STANDARD_IA" # closest to NEARLINE
+    }
+    expiration { days = 365 }
+    noncurrent_version_transition {
+      noncurrent_days = 30
+      storage_class   = "STANDARD_IA"
+    }
+    noncurrent_version_expiration { noncurrent_days = 365 }
+  }
+}
+
+# ---------------------------------------------------------------- Messaging (Pub/Sub -> SNS FIFO + SQS FIFO)
+resource "aws_sns_topic" "orders" {
+  name                        = "orders.fifo"
+  fifo_topic                  = true
+  content_based_deduplication = false # publisher supplies dedup ids
+}
+
+resource "aws_sqs_queue" "orders_dlq" {
+  name       = "orders-dlq.fifo"
+  fifo_queue = true
+}
+
+resource "aws_sqs_queue" "orders_worker" {
+  name       = "orders-worker.fifo"
+  fifo_queue = true
+  # Lambda requires visibility timeout >= function timeout (540s); Pub/Sub ack deadline was 60s.
+  visibility_timeout_seconds = 540
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.orders_dlq.arn
+    maxReceiveCount     = 5
+  })
+}
+
+resource "aws_sqs_queue_policy" "orders_worker" {
+  queue_url = aws_sqs_queue.orders_worker.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "sns.amazonaws.com" }
+      Action    = "sqs:SendMessage"
+      Resource  = aws_sqs_queue.orders_worker.arn
+      Condition = { ArnEquals = { "aws:SourceArn" = aws_sns_topic.orders.arn } }
+    }]
+  })
+}
+
+resource "aws_sns_topic_subscription" "orders_worker" {
+  topic_arn            = aws_sns_topic.orders.arn
+  protocol             = "sqs"
+  endpoint             = aws_sqs_queue.orders_worker.arn
+  raw_message_delivery = true
+}
+
+# ---------------------------------------------------------------- Database (Cloud SQL -> RDS Postgres)
+resource "aws_db_subnet_group" "db" {
+  name       = "app-db"
+  subnet_ids = var.private_subnet_ids
+}
+
+resource "aws_security_group" "db" {
+  name   = "app-db"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 5432
+    to_port         = 5432
+    protocol        = "tcp"
+    security_groups = [aws_security_group.api.id]
+  }
+}
+
+resource "aws_db_instance" "db" {
+  identifier                          = "app-db"
+  engine                              = "postgres"
+  engine_version                      = "15"
+  instance_class                      = "db.m5.large" # 2 vCPU / 8 GiB ~ db-custom-2-7680
+  allocated_storage                   = 20
+  max_allocated_storage               = 100
+  multi_az                            = true # REGIONAL
+  iam_database_authentication_enabled = true
+  backup_retention_period             = 7 # enables backups + point-in-time recovery
+  username                            = "postgres"
+  manage_master_user_password         = true
+  db_subnet_group_name                = aws_db_subnet_group.db.name
+  vpc_security_group_ids              = [aws_security_group.db.id]
+  storage_encrypted                   = true
+  skip_final_snapshot                 = false
+  final_snapshot_identifier           = "app-db-final"
+}
+
+# ---------------------------------------------------------------- API (Cloud Run -> ECS Fargate + ALB)
+resource "aws_ecr_repository" "api" { name = "app/api" }
+
+resource "aws_cloudwatch_log_group" "api" {
+  name              = "/ecs/api"
+  retention_in_days = 30
+}
+
+data "aws_iam_policy_document" "ecs_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "api_exec" {
+  name               = "api-exec"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+resource "aws_iam_role_policy_attachment" "api_exec" {
+  role       = aws_iam_role.api_exec.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+resource "aws_iam_role" "api" { # api-sa
+  name               = "api-task"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+
+resource "aws_iam_role_policy" "api" {
+  role = aws_iam_role.api.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect   = "Allow" # objectAdmin
+        Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts"]
+        Resource = "${aws_s3_bucket.uploads.arn}/*"
+      },
+      { Effect = "Allow", Action = ["s3:ListBucket"], Resource = aws_s3_bucket.uploads.arn },
+      { Effect = "Allow", Action = ["sns:Publish"], Resource = aws_sns_topic.orders.arn },
+      {
+        Effect   = "Allow"
+        Action   = ["rds-db:connect"]
+        Resource = "arn:aws:rds-db:${var.region}:${data.aws_caller_identity.me.account_id}:dbuser:${aws_db_instance.db.resource_id}/*"
+      },
+      {
+        Effect   = "Allow" # nightly rollup
+        Action   = ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults", "athena:GetWorkGroup"]
+        Resource = aws_athena_workgroup.analytics.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["glue:GetDatabase", "glue:GetTable", "glue:GetTables", "glue:GetPartitions", "glue:CreateTable", "glue:DeleteTable", "glue:UpdateTable"]
+        Resource = "*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation"]
+        Resource = [aws_s3_bucket.analytics.arn, "${aws_s3_bucket.analytics.arn}/*"]
+      },
+    ]
+  })
+}
+
+resource "aws_security_group" "alb" {
+  name   = "api-alb"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port   = 80
+    to_port     = 80
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_security_group" "api" {
+  name   = "api-tasks"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 8080
+    to_port         = 8080
+    protocol        = "tcp"
+    security_groups = [aws_security_group.alb.id]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_lb" "api" {
+  name               = "api"
+  load_balancer_type = "application"
+  subnets            = var.public_subnet_ids
+  security_groups    = [aws_security_group.alb.id]
+  idle_timeout       = 900 # request timeout parity
+}
+
+resource "aws_lb_target_group" "api" {
+  name        = "api"
+  port        = 8080
+  protocol    = "HTTP"
+  target_type = "ip"
+  vpc_id      = var.vpc_id
+  health_check {
+    path    = "/"
+    matcher = "200-404"
+  }
+}
+
+resource "aws_lb_listener" "api" {
+  load_balancer_arn = aws_lb.api.arn
+  port              = 80
+  protocol          = "HTTP"
+  default_action {
+    type             = "forward"
+    target_group_arn = aws_lb_target_group.api.arn
+  }
+}
+
+resource "aws_ecs_cluster" "main" { name = "app" }
+
+resource "aws_ecs_task_definition" "api" {
+  family                   = "api"
+  requires_compatibilities = ["FARGATE"]
+  network_mode             = "awsvpc"
+  cpu                      = "2048"
+  memory                   = "4096" # Fargate minimum for 2 vCPU (Cloud Run had 1Gi)
+  execution_role_arn       = aws_iam_role.api_exec.arn
+  task_role_arn            = aws_iam_role.api.arn
+  container_definitions = jsonencode([{
+    name         = "api"
+    image        = "${aws_ecr_repository.api.repository_url}:latest"
+    essential    = true
+    portMappings = [{ containerPort = 8080 }]
+    environment = [
+      { name = "BUCKET", value = aws_s3_bucket.uploads.bucket },
+      { name = "TOPIC_ARN", value = aws_sns_topic.orders.arn },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.analytics.name },
+      { name = "ANALYTICS_BUCKET", value = aws_s3_bucket.analytics.bucket },
+      { name = "AWS_REGION", value = var.region },
+      { name = "DB_HOST", value = aws_db_instance.db.address },
+    ]
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        awslogs-group         = aws_cloudwatch_log_group.api.name
+        awslogs-region        = var.region
+        awslogs-stream-prefix = "api"
+      }
+    }
+  }])
+}
+
+resource "aws_ecs_service" "api" {
+  name            = "api"
+  cluster         = aws_ecs_cluster.main.id
+  task_definition = aws_ecs_task_definition.api.arn
+  desired_count   = 1
+  launch_type     = "FARGATE"
+  network_configuration {
+    subnets         = var.private_subnet_ids
+    security_groups = [aws_security_group.api.id]
+  }
+  load_balancer {
+    target_group_arn = aws_lb_target_group.api.arn
+    container_name   = "api"
+    container_port   = 8080
+  }
+  depends_on = [aws_lb_listener.api]
+  lifecycle { ignore_changes = [desired_count] }
+}
+
+resource "aws_appautoscaling_target" "api" {
+  service_namespace  = "ecs"
+  resource_id        = "service/${aws_ecs_cluster.main.name}/${aws_ecs_service.api.name}"
+  scalable_dimension = "ecs:service:DesiredCount"
+  min_capacity       = 1
+  max_capacity       = 20
+}
+
+resource "aws_appautoscaling_policy" "api" {
+  name               = "api-requests"
+  policy_type        = "TargetTrackingScaling"
+  service_namespace  = aws_appautoscaling_target.api.service_namespace
+  resource_id        = aws_appautoscaling_target.api.resource_id
+  scalable_dimension = aws_appautoscaling_target.api.scalable_dimension
+  target_tracking_scaling_policy_configuration {
+    target_value = 80 # approximates concurrency 80 (ALB counts requests/target/minute)
+    predefined_metric_specification {
+      predefined_metric_type = "ALBRequestCountPerTarget"
+      resource_label         = "${aws_lb.api.arn_suffix}/${aws_lb_target_group.api.arn_suffix}"
+    }
+  }
+}
+
+# ---------------------------------------------------------------- Worker (Cloud Function -> Lambda on SQS)
+data "archive_file" "worker" {
+  type        = "zip"
+  source_file = "${path.module}/../app/worker.py"
+  output_path = "${path.module}/worker.zip"
+}
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "worker" {
+  name               = "orders-worker"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+resource "aws_iam_role_policy_attachment" "worker_logs" {
+  role       = aws_iam_role.worker.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+resource "aws_iam_role_policy" "worker_sqs" {
+  role = aws_iam_role.worker.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
+      Resource = aws_sqs_queue.orders_worker.arn
+    }]
+  })
+}
+
+resource "aws_lambda_function" "worker" {
+  function_name    = "orders-worker"
+  runtime          = "python3.12"
+  handler          = "worker.handle"
+  role             = aws_iam_role.worker.arn
+  filename         = data.archive_file.worker.output_path
+  source_code_hash = data.archive_file.worker.output_base64sha256
+  timeout          = 540
+  memory_size      = 512
+}
+
+resource "aws_lambda_event_source_mapping" "worker" {
+  event_source_arn        = aws_sqs_queue.orders_worker.arn
+  function_name           = aws_lambda_function.worker.arn
+  batch_size              = 10
+  function_response_types = ["ReportBatchItemFailures"]
+}
+
+# ---------------------------------------------------------------- Analytics (BigQuery -> Glue + Athena)
+resource "aws_s3_bucket" "analytics" { bucket = "${var.project}-analytics" }
+
+resource "aws_s3_bucket_public_access_block" "analytics" {
+  bucket                  = aws_s3_bucket.analytics.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_glue_catalog_database" "analytics" { name = "analytics" }
+
+resource "aws_athena_workgroup" "analytics" {
+  name = "analytics"
+  configuration {
+    enforce_workgroup_configuration = true
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.analytics.bucket}/athena-results/"
+    }
+  }
+}
+
+# ---------------------------------------------------------------- Scheduler (Cloud Scheduler -> EventBridge Scheduler -> Lambda -> POST)
+# Scheduler cannot call an arbitrary HTTP URL directly, so a tiny Lambda issues the POST.
+data "archive_file" "cron" {
+  type        = "zip"
+  output_path = "${path.module}/cron.zip"
+  source {
+    filename = "cron.py"
+    content  = <<-PY
+      import os, urllib.request
+      def handler(event, context):
+          req = urllib.request.Request(os.environ["URL"], method="POST")
+          with urllib.request.urlopen(req, timeout=900) as r:
+              return r.status
+    PY
+  }
+}
+
+resource "aws_iam_role" "cron" {
+  name               = "nightly-rollup-cron"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+resource "aws_iam_role_policy_attachment" "cron_logs" {
+  role       = aws_iam_role.cron.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_lambda_function" "cron" {
+  function_name    = "nightly-rollup-trigger"
+  runtime          = "python3.12"
+  handler          = "cron.handler"
+  role             = aws_iam_role.cron.arn
+  filename         = data.archive_file.cron.output_path
+  source_code_hash = data.archive_file.cron.output_base64sha256
+  timeout          = 900
+  environment { variables = { URL = "http://${aws_lb.api.dns_name}/jobs/rollup" } }
+}
+
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "scheduler" {
+  name               = "nightly-rollup-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version   = "2012-10-17"
+    Statement = [{ Effect = "Allow", Action = "lambda:InvokeFunction", Resource = aws_lambda_function.cron.arn }]
+  })
+}
+
+resource "aws_scheduler_schedule" "nightly" {
+  name                         = "nightly-rollup"
+  schedule_expression          = "cron(0 2 * * ? *)"
+  schedule_expression_timezone = "America/New_York"
+  flexible_time_window { mode = "OFF" }
+  target {
+    arn      = aws_lambda_function.cron.arn
+    role_arn = aws_iam_role.scheduler.arn
+  }
+}
diff --git a/sql/rollup.sql b/sql/rollup.sql
index b79db8d..6e318b9 100644
--- a/sql/rollup.sql
+++ b/sql/rollup.sql
@@ -1,10 +1,22 @@
-CREATE OR REPLACE TABLE analytics.daily AS
-SELECT DATE(TIMESTAMP_TRUNC(created_at, DAY)) AS day,
-       customer_id,
-       SUM(SAFE_CAST(amount AS NUMERIC)) AS amount,
-       ARRAY_AGG(STRUCT(sku, qty) ORDER BY qty DESC LIMIT 3) AS top_items,
-       APPROX_COUNT_DISTINCT(session_id) AS sessions
-FROM `analytics.orders`, UNNEST(items)
-WHERE _PARTITIONDATE >= DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
-GROUP BY 1, 2
-QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) <= 100;
+-- Athena (Trino) dialect. Assumes analytics.orders is a Glue table partitioned by
+-- a date column `dt` (replaces BigQuery's _PARTITIONDATE) with items as array<row(sku, qty)>.
+-- Athena lacks CREATE OR REPLACE, ARRAY_AGG ... LIMIT and QUALIFY; the app drops the table first.
+CREATE TABLE analytics.daily
+WITH (format = 'PARQUET', external_location = 's3://{{ANALYTICS_BUCKET}}/tables/daily/') AS
+SELECT day, customer_id, amount, top_items, sessions
+FROM (
+  SELECT day, customer_id, amount, top_items, sessions,
+         ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rn
+  FROM (
+    SELECT CAST(date_trunc('day', o.created_at) AS date) AS day,
+           o.customer_id,
+           SUM(TRY_CAST(o.amount AS DECIMAL(38, 9))) AS amount,
+           slice(array_agg(CAST(ROW(i.sku, i.qty) AS ROW(sku VARCHAR, qty BIGINT)) ORDER BY i.qty DESC), 1, 3) AS top_items,
+           approx_distinct(o.session_id) AS sessions
+    FROM analytics.orders o
+    CROSS JOIN UNNEST(o.items) AS i (sku, qty)
+    WHERE o.dt >= date_add('day', -1, current_date)
+    GROUP BY 1, 2
+  )
+)
+WHERE rn <= 100
