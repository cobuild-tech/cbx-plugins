diff --git a/app/react/NotificationBell.tsx b/app/react/NotificationBell.tsx
new file mode 100644
index 0000000..854ae95
--- /dev/null
+++ b/app/react/NotificationBell.tsx
@@ -0,0 +1,59 @@
+import React, { useCallback, useEffect, useRef, useState } from 'react';
+
+export interface NotificationBellProps {
+  userId: string | null | undefined;
+  /** Resolves to the number of unread notifications for the user. */
+  fetchUnreadCount: (userId: string | null | undefined) => Promise<number>;
+  /** Called with the unread count when the user marks all as read. */
+  onRead: (count: number) => void;
+  pollIntervalMs?: number;
+  /** Poll once only (tests: otherwise settled() would never resolve). */
+  once?: boolean;
+}
+
+export default function NotificationBell({
+  userId,
+  fetchUnreadCount,
+  onRead,
+  pollIntervalMs = 20000,
+  once = false,
+}: NotificationBellProps) {
+  const [unread, setUnread] = useState(0);
+  const fetchRef = useRef(fetchUnreadCount);
+  fetchRef.current = fetchUnreadCount;
+
+  useEffect(() => {
+    let cancelled = false;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+
+    const tick = async () => {
+      try {
+        const count = await fetchRef.current(userId);
+        if (cancelled) return;
+        setUnread(count);
+      } catch {
+        // keep the previous count and retry on the next tick
+      }
+      if (!cancelled && !once) timer = setTimeout(tick, pollIntervalMs);
+    };
+    tick();
+
+    return () => {
+      cancelled = true;
+      if (timer) clearTimeout(timer);
+    };
+  }, [userId, pollIntervalMs, once]);
+
+  const markAllRead = useCallback(() => {
+    onRead(unread);
+    setUnread(0);
+  }, [onRead, unread]);
+
+  return (
+    <span className={unread > 0 ? 'bell bell--unread' : 'bell'}>
+      <button onClick={markAllRead}>
+        🔔 {unread > 0 && <b>{unread}</b>}
+      </button>
+    </span>
+  );
+}
