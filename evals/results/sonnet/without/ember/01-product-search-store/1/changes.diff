diff --git a/app/react/ProductSearch.tsx b/app/react/ProductSearch.tsx
new file mode 100644
index 0000000..c5edde5
--- /dev/null
+++ b/app/react/ProductSearch.tsx
@@ -0,0 +1,51 @@
+import { useEffect, useState } from 'react';
+
+export interface ProductSummary {
+  id: string;
+  name: string;
+  priceCents: number;
+}
+
+export interface ProductSearchProps {
+  /**
+   * Provided by the Ember host. Must run the query through the Ember Data
+   * store so results stay in the store (CompareTray relies on peekAll).
+   */
+  search: (q: string) => Promise<ProductSummary[]>;
+  debounceMs?: number;
+}
+
+export default function ProductSearch({ search, debounceMs = 250 }: ProductSearchProps) {
+  const [query, setQuery] = useState<string | null>(null);
+  const [results, setResults] = useState<ProductSummary[]>([]);
+
+  // Equivalent of ember-concurrency's restartableTask: each new query cancels
+  // the pending timer and discards any in-flight response.
+  useEffect(() => {
+    if (query === null) return;
+    let cancelled = false;
+    const timer = setTimeout(async () => {
+      try {
+        const next = await search(query);
+        if (!cancelled) setResults(next);
+      } catch (e) {
+        if (!cancelled) console.error('Product search failed', e);
+      }
+    }, debounceMs);
+    return () => {
+      cancelled = true;
+      clearTimeout(timer);
+    };
+  }, [query, search, debounceMs]);
+
+  return (
+    <div className="product-search">
+      <input value={query ?? ''} onChange={(e) => setQuery(e.target.value)} />
+      {results.map((p) => (
+        <div key={p.id} className="product-row">
+          {p.name} — ${(p.priceCents / 100).toFixed(2)}
+        </div>
+      ))}
+    </div>
+  );
+}
diff --git a/app/react/mount.tsx b/app/react/mount.tsx
new file mode 100644
index 0000000..d81a402
--- /dev/null
+++ b/app/react/mount.tsx
@@ -0,0 +1,11 @@
+import { createRoot } from 'react-dom/client';
+import ProductSearch, { type ProductSearchProps } from './ProductSearch';
+
+export function mountProductSearch(el: HTMLElement, props: ProductSearchProps) {
+  const root = createRoot(el);
+  root.render(<ProductSearch {...props} />);
+  return {
+    update: (next: ProductSearchProps) => root.render(<ProductSearch {...next} />),
+    unmount: () => root.unmount(),
+  };
+}
