+import { defineConfig } from 'vite';
+
+// Builds the cart bundle to public/js/dist/cart.js (served at /js/dist/cart.js).
+export default defineConfig({
+  publicDir: false,
+  build: {
+    outDir: 'public/js/dist',
+    emptyOutDir: true,
+    rollupOptions: {
+      input: 'src/main.tsx',
+      output: { entryFileNames: 'cart.js', format: 'iife' },
+    },
+  },
+  define: { 'process.env.NODE_ENV': '"production"' },
+});
