diff --git a/src/Cart.tsx b/src/Cart.tsx
new file mode 100644
index 0000000..f6c90e4
--- /dev/null
+++ b/src/Cart.tsx
@@ -0,0 +1,96 @@
+import { useEffect, useRef, useState } from 'react';
+
+export interface CartItem {
+  id: number;
+  name: string;
+  price: number;
+  qty: number;
+}
+
+// The rest of the site is still on jQuery. Analytics listens for a jQuery
+// 'cart:updated' event on document, which native events won't reach, so we
+// trigger it through jQuery.
+declare global {
+  interface Window {
+    jQuery?: (el: Document) => { trigger(event: string, args: unknown[]): void };
+  }
+}
+
+// Mirrors the X-CSRF-Token header that public/js/setup.js adds via $.ajaxSetup.
+function csrfToken(): string {
+  return document.querySelector<HTMLMetaElement>('meta[name=csrf-token]')?.content ?? '';
+}
+
+export function Cart({ initialItems }: { initialItems: CartItem[] }) {
+  const [items, setItems] = useState(initialItems);
+  // Quantities are kept as raw input strings, like the old <input> values.
+  const [qtys, setQtys] = useState<Record<number, string>>(
+    () => Object.fromEntries(initialItems.map((i) => [i.id, String(i.qty)])),
+  );
+
+  const total = items.reduce((sum, i) => sum + i.price * +qtys[i.id], 0);
+
+  // The old script's first updateTotal() ran before analytics.js registered
+  // its listener, so the initial total was never reported. Keep that: only
+  // emit on changes after mount.
+  const mounted = useRef(false);
+  useEffect(() => {
+    if (!mounted.current) {
+      mounted.current = true;
+      return;
+    }
+    window.jQuery?.(document).trigger('cart:updated', [total]);
+  }, [total]);
+
+  async function remove(id: number) {
+    const res = await fetch('/cart/remove', {
+      method: 'POST',
+      headers: {
+        'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
+        'X-CSRF-Token': csrfToken(),
+      },
+      body: new URLSearchParams({ id: String(id) }),
+      credentials: 'same-origin',
+    });
+    if (res.ok) setItems((prev) => prev.filter((i) => i.id !== id));
+  }
+
+  return (
+    <>
+      <table className="cart">
+        <tbody>
+          {items.map((i) => (
+            <tr key={i.id}>
+              <td>{i.name}</td>
+              <td>
+                <input
+                  className="qty"
+                  value={qtys[i.id]}
+                  onChange={(e) => setQtys((q) => ({ ...q, [i.id]: e.target.value }))}
+                />
+              </td>
+              <td>
+                <a
+                  href="#"
+                  className="remove"
+                  onClick={(e) => {
+                    e.preventDefault();
+                    void remove(i.id);
+                  }}
+                >
+                  Remove
+                </a>
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+      <p>
+        Total: <span id="total">{total.toFixed(2)}</span>
+      </p>
+      <button id="checkout" disabled={total === 0}>
+        Checkout
+      </button>
+    </>
+  );
+}
