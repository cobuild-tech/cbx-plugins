diff --git a/src/notifications/Notifications.tsx b/src/notifications/Notifications.tsx
new file mode 100644
index 0000000..1e5dd24
--- /dev/null
+++ b/src/notifications/Notifications.tsx
@@ -0,0 +1,71 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+interface ServerNotification {
+  id: number;
+  html: string;
+}
+
+interface Notification extends ServerNotification {
+  read: boolean;
+}
+
+// Network calls deliberately go through the global jQuery instance so the
+// behaviour set up in public/js/global.js (CSRF header, cache busting, spinner,
+// 401 -> /login redirect) keeps applying.
+interface JQueryStatic {
+  getJSON(
+    url: string,
+    data: Record<string, unknown>,
+    success: (items: ServerNotification[]) => void,
+  ): unknown;
+  post(url: string): unknown;
+}
+declare const $: JQueryStatic;
+
+const POLL_INTERVAL_MS = 15000;
+
+export function Notifications() {
+  const [items, setItems] = useState<Notification[]>([]);
+  const lastSeen = useRef(0);
+
+  const poll = useCallback(() => {
+    $.getJSON('/notifications', { since: lastSeen.current }, (incoming) => {
+      if (incoming.length === 0) return;
+      for (const n of incoming) lastSeen.current = Math.max(lastSeen.current, n.id);
+      // The original prepended each item in turn, so the last one ends up on top.
+      const fresh = incoming.map((n) => ({ ...n, read: false })).reverse();
+      setItems((prev) => [...fresh, ...prev]);
+    });
+  }, []);
+
+  useEffect(() => {
+    poll();
+    const timer = setInterval(poll, POLL_INTERVAL_MS);
+    return () => clearInterval(timer);
+  }, [poll]);
+
+  const markRead = (id: number) => {
+    $.post('/notifications/' + id + '/read');
+    setItems((prev) => prev.map((n) => (n.id === id ? { ...n, read: true } : n)));
+  };
+
+  return (
+    <>
+      <span id="notif-count" style={{ display: items.length > 0 ? undefined : 'none' }}>
+        {items.length}
+      </span>
+      <ul id="notif-list">
+        {items.map((n) => (
+          <li
+            key={n.id}
+            data-id={n.id}
+            className={n.read ? 'read' : undefined}
+            onClick={() => markRead(n.id)}
+            // Server-provided HTML, same trust model as the old string concatenation.
+            dangerouslySetInnerHTML={{ __html: n.html }}
+          />
+        ))}
+      </ul>
+    </>
+  );
+}
