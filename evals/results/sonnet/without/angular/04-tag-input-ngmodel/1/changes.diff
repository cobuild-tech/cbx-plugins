--- /dev/null
+++ b/src/react/tag-input.directive.tsx
@@ -0,0 +1,40 @@
+import React from 'react';
+import { createRoot } from 'react-dom/client';
+import { TagInput } from './TagInput';
+
+/**
+ * Thin AngularJS bridge: keeps <tag-input ng-model max required> working in
+ * contact-form.html (validators, $touched, $error) while rendering React.
+ */
+angular.module('crm').directive('tagInput', function () {
+  return {
+    require: 'ngModel',
+    restrict: 'E',
+    scope: { max: '<' },
+    link(scope: any, el: any, _attrs: any, ngModel: any) {
+      const root = createRoot(el[0]);
+
+      const render = () =>
+        root.render(
+          <TagInput
+            value={ngModel.$viewValue || []}
+            onChange={(tags) =>
+              scope.$apply(() => {
+                ngModel.$setViewValue(tags);
+                ngModel.$setTouched();
+                render();
+              })
+            }
+          />
+        );
+
+      ngModel.$render = render;
+      ngModel.$validators.maxTags = (v: string[] | undefined) => !v || v.length <= (scope.max || 5);
+      ngModel.$isEmpty = (v: string[] | undefined) => !v || v.length === 0;
+
+      scope.$watch('max', () => ngModel.$validate());
+      scope.$on('$destroy', () => root.unmount());
+      render();
+    },
+  };
+});
