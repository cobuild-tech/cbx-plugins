new file mode 100644
index 0000000..656303d
--- /dev/null
+++ b/src/react/TagInput.tsx
@@ -0,0 +1,31 @@
+import React, { useState } from 'react';
+
+export interface TagInputProps {
+  value: string[];
+  onChange: (tags: string[]) => void;
+}
+
+export function TagInput({ value, onChange }: TagInputProps) {
+  const [draft, setDraft] = useState('');
+
+  const onKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
+    const text = draft.trim();
+    if (e.key === 'Enter' && text) {
+      e.preventDefault();
+      setDraft('');
+      onChange([...value, text]);
+    }
+  };
+
+  return (
+    <>
+      {value.map((t, i) => (
+        <span className="tag" key={`${t}-${i}`}>
+          {t}{' '}
+          <a onClick={() => onChange(value.filter((_, j) => j !== i))}>×</a>
+        </span>
+      ))}
+      <input value={draft} onChange={(e) => setDraft(e.target.value)} onKeyDown={onKeyDown} />
+    </>
+  );
+}
diff --git a/src/react/tag-input.directive.tsx b/src/react/tag-input.directive.tsx
