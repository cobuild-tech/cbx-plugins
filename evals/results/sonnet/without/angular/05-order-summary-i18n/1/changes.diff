+import React from 'react';
+
+export interface Order {
+  placedAt: string;
+  total: number;
+  currency: string;
+  items: unknown[];
+}
+
+export interface OrderSummaryProps {
+  order: Order | null | undefined;
+  /** BCP-47 locale used for date/currency formatting (Angular LOCALE_ID). */
+  locale: string;
+  /** Translation function bridged from ngx-translate; re-rendered on language change. */
+  t: (key: string, params?: Record<string, unknown>) => string;
+}
+
+export function OrderSummary({ order, locale, t }: OrderSummaryProps) {
+  // The Angular parent passes `order$ | async`, which is null until the order loads.
+  if (!order) return null;
+
+  const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(new Date(order.placedAt));
+  const total = new Intl.NumberFormat(locale, { style: 'currency', currency: order.currency }).format(order.total);
+  const count = order.items.length;
+
+  return (
+    <>
+      <h3>{t('order.summary')}</h3>
+      <p>{t('order.placed', { date })}</p>
+      <p className="total">{total}</p>
+      <p>{count === 1 ? t('order.oneItem') : t('order.nItems', { n: count })}</p>
+    </>
+  );
+}
