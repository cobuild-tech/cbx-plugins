+++ b/src/react/cart-badge.directive.tsx
@@ -0,0 +1,22 @@
+import React from 'react';
+import { createRoot } from 'react-dom/client';
+import type { CartService } from '../app/cart.service';
+import { CartBadge } from './CartBadge';
+
+declare const angular: any;
+
+/**
+ * AngularJS directive that hosts the React CartBadge, so the existing
+ * `<cart-badge></cart-badge>` markup in the legacy header keeps working.
+ */
+angular.module('shop').directive('cartBadge', [
+  'cartService',
+  (cartService: CartService) => ({
+    restrict: 'E',
+    link(_scope: unknown, element: any) {
+      const root = createRoot(element[0]);
+      root.render(<CartBadge count$={cartService.count$} />);
+      element.on('$destroy', () => root.unmount());
+    },
+  }),
+]);
