diff --git a/src/react/CartBadge.tsx b/src/react/CartBadge.tsx
new file mode 100644
index 0000000..0b103a2
--- /dev/null
+++ b/src/react/CartBadge.tsx
@@ -0,0 +1,21 @@
+import React, { useEffect, useState } from 'react';
+import type { Observable } from 'rxjs';
+
+export interface CartBadgeProps {
+  count$: Observable<number>;
+}
+
+export function CartBadge({ count$ }: CartBadgeProps) {
+  const [count, setCount] = useState(0);
+
+  useEffect(() => {
+    const sub = count$.subscribe(setCount);
+    return () => sub.unsubscribe();
+  }, [count$]);
+
+  return (
+    <a href="/cart" className={count === 0 ? 'badge empty' : 'badge'}>
+      {count}
+    </a>
+  );
+}
diff --git a/src/react/cart-badge.directive.tsx b/src/react/cart-badge.directive.tsx
