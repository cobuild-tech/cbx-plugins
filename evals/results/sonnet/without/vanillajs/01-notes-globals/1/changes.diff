diff --git a/src/store.ts b/src/store.ts
new file mode 100644
index 0000000..78ddc60
--- /dev/null
+++ b/src/store.ts
@@ -0,0 +1,52 @@
+export interface Note { text: string; at: number }
+
+declare global {
+  interface Window {
+    notes: Note[];
+    save: () => void;
+    render: () => void;
+  }
+}
+
+const KEY = 'notes';
+const parse = (raw: string | null): Note[] => JSON.parse(raw || '[]');
+
+let notes: Note[] = parse(localStorage.getItem(KEY));
+let snapshot: Note[] = notes.slice();
+const listeners = new Set<() => void>();
+
+export function save(): void { localStorage.setItem(KEY, JSON.stringify(notes)); }
+
+// Notifies React; takes a fresh snapshot since legacy code may mutate `notes` in place.
+export function render(): void {
+  snapshot = notes.slice();
+  listeners.forEach((l) => l());
+}
+
+export function subscribe(l: () => void): () => void {
+  listeners.add(l);
+  return () => { listeners.delete(l); };
+}
+export const getSnapshot = (): Note[] => snapshot;
+
+export function addNote(text: string): void {
+  notes.push({ text, at: Date.now() });
+  save(); render();
+}
+export function removeNote(i: number): void {
+  notes.splice(i, 1);
+  save(); render();
+}
+
+window.addEventListener('storage', (e) => {
+  if (e.key === KEY) { notes = parse(e.newValue); render(); }
+});
+
+// Compatibility bridge: export.js (other team) relies on these globals.
+Object.defineProperty(window, 'notes', {
+  configurable: true,
+  get: () => notes,
+  set: (v: Note[]) => { notes = v; },
+});
+window.save = save;
+window.render = render;
