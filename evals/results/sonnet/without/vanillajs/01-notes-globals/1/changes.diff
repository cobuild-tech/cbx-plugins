--- /dev/null
+++ b/src/App.tsx
@@ -0,0 +1,29 @@
+import { FormEvent, useSyncExternalStore } from 'react';
+import { addNote, getSnapshot, removeNote, subscribe } from './store';
+
+export default function App() {
+  const notes = useSyncExternalStore(subscribe, getSnapshot);
+
+  const onSubmit = (e: FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    const form = e.currentTarget;
+    const t = (form.elements.namedItem('t') as HTMLInputElement).value.trim();
+    if (!t) return;
+    addNote(t);
+    form.reset();
+  };
+
+  return (
+    <>
+      <ul id="notes">
+        {notes.map((n, i) => (
+          <li key={`${n.at}-${i}`} onDoubleClick={() => removeNote(i)}>{n.text}</li>
+        ))}
+      </ul>
+      <form id="add" onSubmit={onSubmit}>
+        <input name="t" />
+        <button>Add</button>
+      </form>
+    </>
+  );
+}
