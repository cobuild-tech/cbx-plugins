diff --git a/src/Chat.tsx b/src/Chat.tsx
new file mode 100644
index 0000000..352e709
--- /dev/null
+++ b/src/Chat.tsx
@@ -0,0 +1,92 @@
+import { FormEvent, useCallback, useEffect, useRef, useState } from 'react';
+
+interface ChatMessage {
+  user: string;
+  text: string;
+}
+
+declare global {
+  interface Window {
+    Chat?: { send: (text: string) => void };
+  }
+}
+
+const MAX_RETRY_DELAY_MS = 30000;
+
+export function Chat() {
+  const [messages, setMessages] = useState<ChatMessage[]>([]);
+  const [draft, setDraft] = useState('');
+  const logRef = useRef<HTMLUListElement>(null);
+  const wsRef = useRef<WebSocket | null>(null);
+  const queueRef = useRef<string[]>([]);
+
+  const send = useCallback((text: string) => {
+    const payload = JSON.stringify({ text });
+    const ws = wsRef.current;
+    if (ws && ws.readyState === WebSocket.OPEN) ws.send(payload);
+    else queueRef.current.push(payload);
+  }, []);
+
+  useEffect(() => {
+    let retry = 0;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let disposed = false;
+
+    function connect() {
+      const ws = new WebSocket(`wss://${location.host}/chat`);
+      wsRef.current = ws;
+      ws.onopen = () => {
+        retry = 0;
+        queueRef.current.splice(0).forEach((m) => ws.send(m));
+      };
+      ws.onmessage = (e) => {
+        const m = JSON.parse(e.data) as ChatMessage;
+        setMessages((prev) => [...prev, { user: m.user, text: m.text }]);
+      };
+      ws.onclose = () => {
+        if (disposed) return;
+        timer = setTimeout(connect, Math.min(MAX_RETRY_DELAY_MS, 1000 * 2 ** retry++));
+      };
+    }
+
+    connect();
+    // Used by support-macros.js
+    window.Chat = { send };
+
+    return () => {
+      disposed = true;
+      clearTimeout(timer);
+      wsRef.current?.close();
+      wsRef.current = null;
+      delete window.Chat;
+    };
+  }, [send]);
+
+  // Keep the log scrolled to the newest message.
+  useEffect(() => {
+    const log = logRef.current;
+    if (log) log.scrollTop = log.scrollHeight;
+  }, [messages]);
+
+  function onSubmit(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    send(draft);
+    setDraft('');
+  }
+
+  return (
+    <>
+      <ul id="chat-log" ref={logRef}>
+        {messages.map((m, i) => (
+          <li key={i}>
+            {m.user}: {m.text}
+          </li>
+        ))}
+      </ul>
+      <form id="chat-form" onSubmit={onSubmit}>
+        <input name="msg" value={draft} onChange={(e) => setDraft(e.target.value)} />
+        <button>Send</button>
+      </form>
+    </>
+  );
+}
