diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..d307995
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,455 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = ">= 5.0" }
+    archive = { source = "hashicorp/archive", version = ">= 2.0" }
+  }
+}
+
+provider "aws" { region = "us-east-2" } # GCP us-central1 -> nearest AWS region
+
+variable "project" { type = string } # name prefix; keeps bucket names like GCP (${project}-uploads)
+variable "vpc_id" { type = string }
+variable "public_subnet_ids" { type = list(string) }  # ALB
+variable "private_subnet_ids" { type = list(string) } # Fargate tasks + RDS (>= 2 AZs)
+variable "certificate_arn" { type = string }          # ACM cert for api_hostname (Cloud Run gave HTTPS for free)
+variable "api_hostname" { type = string }             # DNS name pointing at the ALB; used by the nightly invoker
+
+data "aws_region" "current" {}
+data "aws_caller_identity" "current" {}
+
+# ---------------------------------------------------------------- Storage (GCS -> S3)
+resource "aws_s3_bucket" "uploads" { bucket = "${var.project}-uploads" }
+
+resource "aws_s3_bucket_ownership_controls" "uploads" { # ~ uniform_bucket_level_access
+  bucket = aws_s3_bucket.uploads.id
+  rule { object_ownership = "BucketOwnerEnforced" }
+}
+resource "aws_s3_bucket_public_access_block" "uploads" {
+  bucket                  = aws_s3_bucket.uploads.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+resource "aws_s3_bucket_versioning" "uploads" {
+  bucket = aws_s3_bucket.uploads.id
+  versioning_configuration { status = "Enabled" }
+}
+resource "aws_s3_bucket_lifecycle_configuration" "uploads" {
+  bucket     = aws_s3_bucket.uploads.id
+  depends_on = [aws_s3_bucket_versioning.uploads]
+  rule {
+    id     = "nearline-30d-delete-365d" # NEARLINE -> STANDARD_IA
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 30
+      storage_class = "STANDARD_IA"
+    }
+    expiration { days = 365 }
+    noncurrent_version_transition {
+      noncurrent_days = 30
+      storage_class   = "STANDARD_IA"
+    }
+    noncurrent_version_expiration { noncurrent_days = 365 }
+  }
+}
+
+# ---------------------------------------------------------------- Messaging (Pub/Sub -> SNS FIFO + SQS FIFO)
+resource "aws_sns_topic" "orders" {
+  name       = "orders.fifo"
+  fifo_topic = true
+}
+resource "aws_sqs_queue" "orders_dlq" {
+  name       = "orders-dlq.fifo"
+  fifo_queue = true
+}
+resource "aws_sqs_queue" "orders_worker" {
+  name                       = "orders-worker.fifo"
+  fifo_queue                 = true
+  visibility_timeout_seconds = 3240 # ack_deadline 60s -> must exceed Lambda timeout (540s); 6x per AWS guidance
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.orders_dlq.arn
+    maxReceiveCount     = 5
+  })
+}
+resource "aws_sqs_queue_policy" "orders_worker" {
+  queue_url = aws_sqs_queue.orders_worker.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "sns.amazonaws.com" }
+      Action    = "sqs:SendMessage"
+      Resource  = aws_sqs_queue.orders_worker.arn
+      Condition = { ArnEquals = { "aws:SourceArn" = aws_sns_topic.orders.arn } }
+    }]
+  })
+}
+resource "aws_sns_topic_subscription" "orders_worker" {
+  topic_arn            = aws_sns_topic.orders.arn
+  protocol             = "sqs"
+  endpoint             = aws_sqs_queue.orders_worker.arn
+  raw_message_delivery = true
+}
+
+# ---------------------------------------------------------------- Database (Cloud SQL -> RDS)
+resource "aws_db_subnet_group" "db" {
+  name       = "app-db"
+  subnet_ids = var.private_subnet_ids
+}
+resource "aws_security_group" "db" {
+  name   = "app-db"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 5432
+    to_port         = 5432
+    protocol        = "tcp"
+    security_groups = [aws_security_group.api.id]
+  }
+}
+resource "aws_db_instance" "db" {
+  identifier                          = "app-db"
+  engine                              = "postgres"
+  engine_version                      = "15"
+  instance_class                      = "db.m6g.large" # db-custom-2-7680 (2 vCPU / 7.5 GB) -> 2 vCPU / 8 GB
+  allocated_storage                   = 20
+  storage_type                        = "gp3"
+  multi_az                            = true # availability_type = REGIONAL
+  iam_database_authentication_enabled = true # cloudsql.iam_authentication
+  backup_retention_period             = 7    # enables automated backups + point-in-time recovery
+  manage_master_user_password         = true # password stored in Secrets Manager
+  username                            = "postgres"
+  db_subnet_group_name                = aws_db_subnet_group.db.name
+  vpc_security_group_ids              = [aws_security_group.db.id]
+  final_snapshot_identifier           = "app-db-final"
+}
+
+# ---------------------------------------------------------------- Analytics (BigQuery -> Athena + Glue + S3)
+resource "aws_s3_bucket" "analytics" { bucket = "${var.project}-analytics" }
+resource "aws_s3_bucket_public_access_block" "analytics" {
+  bucket                  = aws_s3_bucket.analytics.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+resource "aws_glue_catalog_database" "analytics" { name = "analytics" }
+resource "aws_athena_workgroup" "analytics" {
+  name = "analytics"
+  configuration {
+    result_configuration { output_location = "s3://${aws_s3_bucket.analytics.bucket}/athena-results/" }
+  }
+}
+
+# ---------------------------------------------------------------- IAM (service account -> task role)
+data "aws_iam_policy_document" "ecs_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+resource "aws_iam_role" "api" { # api-sa
+  name               = "api-sa"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+resource "aws_iam_role_policy" "api" {
+  role = aws_iam_role.api.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      { # roles/storage.objectAdmin on uploads
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:GetObjectVersion", "s3:DeleteObjectVersion", "s3:ListBucket", "s3:ListBucketVersions"]
+        Resource = [aws_s3_bucket.uploads.arn, "${aws_s3_bucket.uploads.arn}/*"]
+      },
+      { # needed by app code (publish orders, run rollup); implicit/unmanaged on GCP
+        Effect   = "Allow"
+        Action   = "sns:Publish"
+        Resource = aws_sns_topic.orders.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults"]
+        Resource = aws_athena_workgroup.analytics.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["glue:GetDatabase", "glue:GetTable", "glue:GetTables", "glue:GetPartitions", "glue:CreateTable", "glue:DeleteTable"]
+        Resource = ["arn:aws:glue:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:catalog",
+          aws_glue_catalog_database.analytics.arn,
+        "arn:aws:glue:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:table/analytics/*"]
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:AbortMultipartUpload", "s3:ListBucketMultipartUploads"]
+        Resource = [aws_s3_bucket.analytics.arn, "${aws_s3_bucket.analytics.arn}/*"]
+      },
+      { # connect to RDS with IAM auth
+        Effect   = "Allow"
+        Action   = "rds-db:connect"
+        Resource = "arn:aws:rds-db:${data.aws_region.current.name}:${data.aws_caller_identity.current.account_id}:dbuser:${aws_db_instance.db.resource_id}/*"
+      }
+    ]
+  })
+}
+resource "aws_iam_role" "api_exec" {
+  name               = "api-exec"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+resource "aws_iam_role_policy_attachment" "api_exec" {
+  role       = aws_iam_role.api_exec.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+# ---------------------------------------------------------------- API (Cloud Run -> ECS Fargate + ALB)
+# App Runner was rejected: its request timeout is fixed at 120s (Cloud Run: 900s).
+resource "aws_ecr_repository" "app" { name = "app/api" }
+resource "aws_cloudwatch_log_group" "api" { name = "/ecs/api" }
+
+resource "aws_security_group" "alb" {
+  name   = "api-alb"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port   = 443
+    to_port     = 443
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+resource "aws_security_group" "api" {
+  name   = "api-tasks"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 8080
+    to_port         = 8080
+    protocol        = "tcp"
+    security_groups = [aws_security_group.alb.id]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_lb" "api" {
+  name               = "api"
+  load_balancer_type = "application"
+  subnets            = var.public_subnet_ids
+  security_groups    = [aws_security_group.alb.id]
+  idle_timeout       = 900 # Cloud Run timeout = 900s
+}
+resource "aws_lb_target_group" "api" {
+  name        = "api"
+  port        = 8080
+  protocol    = "HTTP"
+  target_type = "ip"
+  vpc_id      = var.vpc_id
+  health_check { matcher = "200-499" } # app has no health route; any response = alive
+}
+resource "aws_lb_listener" "https" {
+  load_balancer_arn = aws_lb.api.arn
+  port              = 443
+  protocol          = "HTTPS"
+  certificate_arn   = var.certificate_arn
+  default_action {
+    type             = "forward"
+    target_group_arn = aws_lb_target_group.api.arn
+  }
+}
+
+resource "aws_ecs_cluster" "main" { name = "app" }
+resource "aws_ecs_task_definition" "api" {
+  family                   = "api"
+  requires_compatibilities = ["FARGATE"]
+  network_mode             = "awsvpc"
+  cpu                      = "2048"
+  memory                   = "4096" # Fargate minimum for 2 vCPU (Cloud Run: 1Gi)
+  task_role_arn            = aws_iam_role.api.arn
+  execution_role_arn       = aws_iam_role.api_exec.arn
+  container_definitions = jsonencode([{
+    name         = "api"
+    image        = "${aws_ecr_repository.app.repository_url}:latest"
+    essential    = true
+    portMappings = [{ containerPort = 8080 }]
+    environment = [
+      { name = "BUCKET", value = aws_s3_bucket.uploads.bucket },
+      { name = "ORDERS_TOPIC_ARN", value = aws_sns_topic.orders.arn },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.analytics.name },
+      { name = "ANALYTICS_BUCKET", value = aws_s3_bucket.analytics.bucket },
+    ]
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        awslogs-group         = aws_cloudwatch_log_group.api.name
+        awslogs-region        = data.aws_region.current.name
+        awslogs-stream-prefix = "api"
+      }
+    }
+  }])
+}
+resource "aws_ecs_service" "api" {
+  name            = "api"
+  cluster         = aws_ecs_cluster.main.id
+  task_definition = aws_ecs_task_definition.api.arn
+  desired_count   = 1
+  launch_type     = "FARGATE"
+  network_configuration {
+    subnets         = var.private_subnet_ids
+    security_groups = [aws_security_group.api.id]
+  }
+  load_balancer {
+    target_group_arn = aws_lb_target_group.api.arn
+    container_name   = "api"
+    container_port   = 8080
+  }
+  depends_on = [aws_lb_listener.https]
+  lifecycle { ignore_changes = [desired_count] }
+}
+resource "aws_appautoscaling_target" "api" {
+  service_namespace  = "ecs"
+  resource_id        = "service/${aws_ecs_cluster.main.name}/${aws_ecs_service.api.name}"
+  scalable_dimension = "ecs:service:DesiredCount"
+  min_capacity       = 1
+  max_capacity       = 20
+}
+resource "aws_appautoscaling_policy" "api" {
+  name               = "api-requests"
+  policy_type        = "TargetTrackingScaling"
+  service_namespace  = aws_appautoscaling_target.api.service_namespace
+  resource_id        = aws_appautoscaling_target.api.resource_id
+  scalable_dimension = aws_appautoscaling_target.api.scalable_dimension
+  target_tracking_scaling_policy_configuration {
+    target_value = 80 # ~ max_instance_request_concurrency (ALB metric is requests/target/min, not concurrent)
+    predefined_metric_specification {
+      predefined_metric_type = "ALBRequestCountPerTarget"
+      resource_label         = "${aws_lb.api.arn_suffix}/${aws_lb_target_group.api.arn_suffix}"
+    }
+  }
+}
+
+# ---------------------------------------------------------------- Worker (Cloud Functions -> Lambda on SQS)
+data "archive_file" "worker" {
+  type        = "zip"
+  source_file = "${path.module}/../app/worker.py"
+  output_path = "${path.module}/worker.zip"
+}
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+resource "aws_iam_role" "worker" {
+  name               = "orders-worker"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+resource "aws_iam_role_policy_attachment" "worker_logs" {
+  role       = aws_iam_role.worker.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+resource "aws_iam_role_policy" "worker_sqs" {
+  role = aws_iam_role.worker.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
+      Resource = aws_sqs_queue.orders_worker.arn
+    }]
+  })
+}
+resource "aws_lambda_function" "worker" {
+  function_name    = "orders-worker"
+  role             = aws_iam_role.worker.arn
+  runtime          = "python3.12"
+  handler          = "worker.handle"
+  timeout          = 540
+  memory_size      = 512
+  filename         = data.archive_file.worker.output_path
+  source_code_hash = data.archive_file.worker.output_base64sha256
+}
+resource "aws_lambda_event_source_mapping" "worker" {
+  event_source_arn = aws_sqs_queue.orders_worker.arn
+  function_name    = aws_lambda_function.worker.arn
+  batch_size       = 1 # one message per invocation, like the CloudEvent trigger
+}
+
+# ---------------------------------------------------------------- Scheduler (Cloud Scheduler -> EventBridge Scheduler)
+# EventBridge HTTP destinations time out at 5s, so a small Lambda makes the long-running POST.
+data "archive_file" "invoker" {
+  type        = "zip"
+  output_path = "${path.module}/rollup_invoker.zip"
+  source {
+    filename = "invoker.py"
+    content  = <<-EOT
+      import os, urllib.request
+      def handler(event, context):
+          req = urllib.request.Request(f"https://{os.environ['API_HOSTNAME']}/jobs/rollup", method="POST")
+          with urllib.request.urlopen(req, timeout=880) as r:
+              return r.status
+    EOT
+  }
+}
+resource "aws_iam_role" "invoker" {
+  name               = "nightly-rollup-invoker"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+resource "aws_iam_role_policy_attachment" "invoker_logs" {
+  role       = aws_iam_role.invoker.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+resource "aws_lambda_function" "invoker" {
+  function_name    = "nightly-rollup-invoker"
+  role             = aws_iam_role.invoker.arn
+  runtime          = "python3.12"
+  handler          = "invoker.handler"
+  timeout          = 900
+  filename         = data.archive_file.invoker.output_path
+  source_code_hash = data.archive_file.invoker.output_base64sha256
+  environment { variables = { API_HOSTNAME = var.api_hostname } }
+}
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+resource "aws_iam_role" "scheduler" {
+  name               = "nightly-rollup-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version   = "2012-10-17"
+    Statement = [{ Effect = "Allow", Action = "lambda:InvokeFunction", Resource = aws_lambda_function.invoker.arn }]
+  })
+}
+resource "aws_scheduler_schedule" "nightly" {
+  name                         = "nightly-rollup"
+  schedule_expression          = "cron(0 2 * * ? *)"
+  schedule_expression_timezone = "America/New_York"
+  flexible_time_window { mode = "OFF" }
+  target {
+    arn      = aws_lambda_function.invoker.arn
+    role_arn = aws_iam_role.scheduler.arn
+  }
+}
diff --git a/sql/rollup.sql b/sql/rollup.sql
index b79db8d..7fd935d 100644
--- a/sql/rollup.sql
+++ b/sql/rollup.sql
@@ -1,10 +1,21 @@
-CREATE OR REPLACE TABLE analytics.daily AS
-SELECT DATE(TIMESTAMP_TRUNC(created_at, DAY)) AS day,
-       customer_id,
-       SUM(SAFE_CAST(amount AS NUMERIC)) AS amount,
-       ARRAY_AGG(STRUCT(sku, qty) ORDER BY qty DESC LIMIT 3) AS top_items,
-       APPROX_COUNT_DISTINCT(session_id) AS sessions
-FROM `analytics.orders`, UNNEST(items)
-WHERE _PARTITIONDATE >= DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
-GROUP BY 1, 2
-QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) <= 100;
+-- Athena (Trino) version. Assumes analytics.orders is a Glue table with items array<row(sku varchar, qty bigint)>
+-- and a Hive partition column `partition_date` (date) replacing BigQuery's _PARTITIONDATE.
+CREATE TABLE analytics.daily
+WITH (format = 'PARQUET', external_location = 's3://{{analytics_bucket}}/analytics/daily/') AS
+SELECT day, customer_id, amount, top_items, sessions
+FROM (
+  SELECT day, customer_id, amount, top_items, sessions,
+         ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rn
+  FROM (
+    SELECT CAST(date_trunc('day', created_at) AS date) AS day,
+           customer_id,
+           SUM(TRY_CAST(amount AS DECIMAL(38, 9))) AS amount,
+           SLICE(ARRAY_AGG(CAST(ROW(sku, qty) AS ROW(sku VARCHAR, qty BIGINT)) ORDER BY qty DESC), 1, 3) AS top_items,
+           approx_distinct(session_id) AS sessions
+    FROM analytics.orders
+    CROSS JOIN UNNEST(items) AS t (sku, qty)
+    WHERE partition_date >= date_add('day', -1, current_date)
+    GROUP BY 1, 2
+  )
+)
+WHERE rn <= 100
