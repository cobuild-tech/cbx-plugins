-import base64, json, functions_framework
-@functions_framework.cloud_event
-def handle(event):
-    order = json.loads(base64.b64decode(event.data["message"]["data"]))
-    print("processing", order["id"])
+import json
+
+
+def handle(event, context=None):
+    # SQS (FIFO) event source; SNS raw message delivery => body is the order JSON.
+    failures = []
+    for i, record in enumerate(event["Records"]):
+        try:
+            order = json.loads(record["body"])
+            print("processing", order["id"])
+        except Exception:
+            # FIFO: fail this and every later record so ordering is preserved on retry.
+            failures = [{"itemIdentifier": r["messageId"]} for r in event["Records"][i:]]
+            break
+    return {"batchItemFailures": failures}
