diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..a2c5092
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,524 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = "~> 5.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.0" }
+  }
+}
+
+provider "aws" { region = var.region }
+
+variable "project" {
+  type        = string
+  description = "Prefix for globally-unique names (S3 buckets). Same value as the GCP project var."
+}
+variable "region" {
+  type    = string
+  default = "us-east-2" # GCP us-central1 -> nearest AWS region
+}
+variable "vpc_id" { type = string }
+variable "public_subnet_ids" {
+  type        = list(string)
+  description = "Subnets for the ALB (>= 2 AZs)"
+}
+variable "private_subnet_ids" {
+  type        = list(string)
+  description = "Subnets for ECS tasks and RDS (>= 2 AZs, outbound internet/NAT or VPC endpoints required)"
+}
+
+data "aws_caller_identity" "me" {}
+
+# ---------------------------------------------------------------- Storage
+# google_storage_bucket.uploads
+resource "aws_s3_bucket" "uploads" { bucket = "${var.project}-uploads" }
+
+resource "aws_s3_bucket_ownership_controls" "uploads" {
+  bucket = aws_s3_bucket.uploads.id
+  rule { object_ownership = "BucketOwnerEnforced" } # uniform_bucket_level_access
+}
+resource "aws_s3_bucket_public_access_block" "uploads" {
+  bucket                  = aws_s3_bucket.uploads.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+resource "aws_s3_bucket_versioning" "uploads" {
+  bucket = aws_s3_bucket.uploads.id
+  versioning_configuration { status = "Enabled" }
+}
+resource "aws_s3_bucket_lifecycle_configuration" "uploads" {
+  bucket     = aws_s3_bucket.uploads.id
+  depends_on = [aws_s3_bucket_versioning.uploads]
+
+  rule {
+    id     = "tier-and-expire"
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 30
+      storage_class = "STANDARD_IA" # NEARLINE
+    }
+    expiration { days = 365 }
+    noncurrent_version_transition {
+      noncurrent_days = 30
+      storage_class   = "STANDARD_IA"
+    }
+    noncurrent_version_expiration { noncurrent_days = 365 }
+  }
+  rule {
+    id     = "clean-delete-markers"
+    status = "Enabled"
+    filter {}
+    expiration { expired_object_delete_marker = true }
+  }
+}
+
+# ---------------------------------------------------------------- Messaging
+# Pub/Sub topic "orders" (ordering enabled) -> SNS FIFO topic
+resource "aws_sns_topic" "orders" {
+  name                        = "orders.fifo"
+  fifo_topic                  = true
+  content_based_deduplication = false # publisher sets MessageDeduplicationId
+}
+
+# google_pubsub_topic.orders_dlq -> FIFO queue (SQS has no DLQ "topic")
+resource "aws_sqs_queue" "orders_dlq" {
+  name                      = "orders-dlq.fifo"
+  fifo_queue                = true
+  message_retention_seconds = 604800
+}
+
+# google_pubsub_subscription.orders_worker (ack 60s, ordering, DLQ after 5 attempts)
+resource "aws_sqs_queue" "orders_worker" {
+  name                       = "orders-worker.fifo"
+  fifo_queue                 = true
+  visibility_timeout_seconds = 60
+  message_retention_seconds  = 604800
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.orders_dlq.arn
+    maxReceiveCount     = 5
+  })
+}
+
+# Subscription Eventarc creates implicitly for the Cloud Function trigger (retry, no DLQ)
+resource "aws_sqs_queue" "orders_trigger" {
+  name                       = "orders-worker-trigger.fifo"
+  fifo_queue                 = true
+  visibility_timeout_seconds = 540 # must be >= Lambda timeout
+  message_retention_seconds  = 604800
+}
+
+locals {
+  fanout_queues = {
+    worker  = aws_sqs_queue.orders_worker
+    trigger = aws_sqs_queue.orders_trigger
+  }
+}
+
+resource "aws_sns_topic_subscription" "orders" {
+  for_each             = local.fanout_queues
+  topic_arn            = aws_sns_topic.orders.arn
+  protocol             = "sqs"
+  endpoint             = each.value.arn
+  raw_message_delivery = true
+}
+
+resource "aws_sqs_queue_policy" "from_sns" {
+  for_each  = local.fanout_queues
+  queue_url = each.value.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "sns.amazonaws.com" }
+      Action    = "sqs:SendMessage"
+      Resource  = each.value.arn
+      Condition = { ArnEquals = { "aws:SourceArn" = aws_sns_topic.orders.arn } }
+    }]
+  })
+}
+
+# ---------------------------------------------------------------- Network security
+resource "aws_security_group" "alb" {
+  name   = "api-alb"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port   = 80
+    to_port     = 80
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+resource "aws_security_group" "api" {
+  name   = "api-svc"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 8080
+    to_port         = 8080
+    protocol        = "tcp"
+    security_groups = [aws_security_group.alb.id]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+resource "aws_security_group" "db" {
+  name   = "app-db"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 5432
+    to_port         = 5432
+    protocol        = "tcp"
+    security_groups = [aws_security_group.api.id]
+  }
+}
+
+# ---------------------------------------------------------------- Database
+# google_sql_database_instance.db (POSTGRES_15, db-custom-2-7680, REGIONAL, IAM auth, PITR)
+resource "aws_db_subnet_group" "db" {
+  name       = "app-db"
+  subnet_ids = var.private_subnet_ids
+}
+resource "aws_db_instance" "db" {
+  identifier                          = "app-db"
+  engine                              = "postgres"
+  engine_version                      = "15"
+  instance_class                      = "db.m5.large" # 2 vCPU / 8 GiB ~ db-custom-2-7680
+  allocated_storage                   = 20
+  max_allocated_storage               = 100
+  storage_type                        = "gp3"
+  storage_encrypted                   = true
+  username                            = "postgres"
+  manage_master_user_password         = true # stored in Secrets Manager
+  multi_az                            = true # availability_type = REGIONAL
+  iam_database_authentication_enabled = true # cloudsql.iam_authentication
+  backup_retention_period             = 7    # enables automated backups + PITR
+  db_subnet_group_name                = aws_db_subnet_group.db.name
+  vpc_security_group_ids              = [aws_security_group.db.id]
+  publicly_accessible                 = false
+  final_snapshot_identifier           = "app-db-final"
+  skip_final_snapshot                 = false
+}
+
+# ---------------------------------------------------------------- Analytics
+# google_bigquery_dataset.analytics -> Glue database + Athena
+resource "aws_s3_bucket" "analytics" { bucket = "${var.project}-analytics" }
+resource "aws_s3_bucket_public_access_block" "analytics" {
+  bucket                  = aws_s3_bucket.analytics.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+resource "aws_glue_catalog_database" "analytics" { name = "analytics" }
+resource "aws_athena_workgroup" "analytics" {
+  name = "analytics"
+  configuration {
+    enforce_workgroup_configuration = true
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.analytics.bucket}/athena-results/"
+    }
+  }
+}
+
+# ---------------------------------------------------------------- IAM (api-sa)
+data "aws_iam_policy_document" "ecs_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+resource "aws_iam_role" "api" {
+  name               = "api-sa"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+resource "aws_iam_role" "api_exec" {
+  name               = "api-sa-exec"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+resource "aws_iam_role_policy_attachment" "api_exec" {
+  role       = aws_iam_role.api_exec.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+# roles/storage.objectAdmin on the uploads bucket
+data "aws_iam_policy_document" "api" {
+  statement {
+    sid = "UploadsObjectAdmin"
+    actions = [
+      "s3:GetObject", "s3:GetObjectVersion", "s3:PutObject",
+      "s3:DeleteObject", "s3:DeleteObjectVersion", "s3:AbortMultipartUpload",
+      "s3:ListMultipartUploadParts",
+    ]
+    resources = ["${aws_s3_bucket.uploads.arn}/*"]
+  }
+  statement {
+    sid       = "UploadsList"
+    actions   = ["s3:ListBucket", "s3:ListBucketVersions", "s3:ListBucketMultipartUploads", "s3:GetBucketLocation"]
+    resources = [aws_s3_bucket.uploads.arn]
+  }
+  # Not in the GCP Terraform (granted out-of-band there); the app code needs them.
+  statement {
+    sid       = "PublishOrders"
+    actions   = ["sns:Publish"]
+    resources = [aws_sns_topic.orders.arn]
+  }
+  statement {
+    sid       = "DbIamConnect" # roles/cloudsql.client equivalent
+    actions   = ["rds-db:connect"]
+    resources = ["arn:aws:rds-db:${var.region}:${data.aws_caller_identity.me.account_id}:dbuser:${aws_db_instance.db.resource_id}/*"]
+  }
+  statement {
+    sid       = "AthenaRun"
+    actions   = ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults"]
+    resources = [aws_athena_workgroup.analytics.arn]
+  }
+  statement {
+    sid = "GlueCatalog"
+    actions = [
+      "glue:GetDatabase", "glue:GetTable", "glue:GetTables", "glue:GetPartitions",
+      "glue:CreateTable", "glue:UpdateTable", "glue:DeleteTable",
+    ]
+    resources = [
+      "arn:aws:glue:${var.region}:${data.aws_caller_identity.me.account_id}:catalog",
+      aws_glue_catalog_database.analytics.arn,
+      "arn:aws:glue:${var.region}:${data.aws_caller_identity.me.account_id}:table/${aws_glue_catalog_database.analytics.name}/*",
+    ]
+  }
+  statement {
+    sid = "AnalyticsData"
+    actions = [
+      "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket",
+      "s3:GetBucketLocation", "s3:AbortMultipartUpload",
+    ]
+    resources = [aws_s3_bucket.analytics.arn, "${aws_s3_bucket.analytics.arn}/*"]
+  }
+}
+resource "aws_iam_role_policy" "api" {
+  name   = "api"
+  role   = aws_iam_role.api.id
+  policy = data.aws_iam_policy_document.api.json
+}
+
+# ---------------------------------------------------------------- API (Cloud Run -> ECS Fargate + ALB)
+resource "aws_ecr_repository" "api" { name = "app/api" }
+
+resource "aws_cloudwatch_log_group" "api" {
+  name              = "/ecs/api"
+  retention_in_days = 30
+}
+
+resource "aws_ecs_cluster" "main" { name = "app" }
+
+resource "aws_ecs_task_definition" "api" {
+  family                   = "api"
+  requires_compatibilities = ["FARGATE"]
+  network_mode             = "awsvpc"
+  cpu                      = "2048"
+  memory                   = "4096" # Fargate minimum for 2 vCPU (Cloud Run had 1Gi)
+  execution_role_arn       = aws_iam_role.api_exec.arn
+  task_role_arn            = aws_iam_role.api.arn
+  container_definitions = jsonencode([{
+    name         = "api"
+    image        = "${aws_ecr_repository.api.repository_url}:latest"
+    essential    = true
+    portMappings = [{ containerPort = 8080 }]
+    environment = [
+      { name = "PORT", value = "8080" },
+      { name = "AWS_REGION", value = var.region },
+      { name = "BUCKET", value = aws_s3_bucket.uploads.bucket },
+      { name = "TOPIC_ARN", value = aws_sns_topic.orders.arn },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.analytics.name },
+      { name = "ANALYTICS_LOCATION", value = "s3://${aws_s3_bucket.analytics.bucket}/tables" },
+      { name = "DB_HOST", value = aws_db_instance.db.address },
+    ]
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        awslogs-group         = aws_cloudwatch_log_group.api.name
+        awslogs-region        = var.region
+        awslogs-stream-prefix = "api"
+      }
+    }
+  }])
+}
+
+resource "aws_lb" "api" {
+  name               = "api"
+  load_balancer_type = "application"
+  subnets            = var.public_subnet_ids
+  security_groups    = [aws_security_group.alb.id]
+  idle_timeout       = 900 # Cloud Run request timeout 900s
+}
+resource "aws_lb_target_group" "api" {
+  name        = "api"
+  port        = 8080
+  protocol    = "HTTP"
+  target_type = "ip"
+  vpc_id      = var.vpc_id
+  health_check {
+    path    = "/"
+    matcher = "200-499" # app has no GET route; any HTTP answer = alive
+  }
+}
+resource "aws_lb_listener" "http" {
+  load_balancer_arn = aws_lb.api.arn
+  port              = 80
+  protocol          = "HTTP"
+  default_action {
+    type             = "forward"
+    target_group_arn = aws_lb_target_group.api.arn
+  }
+}
+
+resource "aws_ecs_service" "api" {
+  name            = "api"
+  cluster         = aws_ecs_cluster.main.id
+  task_definition = aws_ecs_task_definition.api.arn
+  launch_type     = "FARGATE"
+  desired_count   = 1
+  network_configuration {
+    subnets         = var.private_subnet_ids
+    security_groups = [aws_security_group.api.id]
+  }
+  load_balancer {
+    target_group_arn = aws_lb_target_group.api.arn
+    container_name   = "api"
+    container_port   = 8080
+  }
+  lifecycle { ignore_changes = [desired_count] }
+  depends_on = [aws_lb_listener.http]
+}
+
+resource "aws_appautoscaling_target" "api" {
+  service_namespace  = "ecs"
+  scalable_dimension = "ecs:service:DesiredCount"
+  resource_id        = "service/${aws_ecs_cluster.main.name}/${aws_ecs_service.api.name}"
+  min_capacity       = 1
+  max_capacity       = 20
+}
+resource "aws_appautoscaling_policy" "api" {
+  name               = "api-requests"
+  policy_type        = "TargetTrackingScaling"
+  service_namespace  = aws_appautoscaling_target.api.service_namespace
+  scalable_dimension = aws_appautoscaling_target.api.scalable_dimension
+  resource_id        = aws_appautoscaling_target.api.resource_id
+  target_tracking_scaling_policy_configuration {
+    target_value = 80 # ~ max_instance_request_concurrency (requests/target/min, not concurrent)
+    predefined_metric_specification {
+      predefined_metric_type = "ALBRequestCountPerTarget"
+      resource_label         = "${aws_lb.api.arn_suffix}/${aws_lb_target_group.api.arn_suffix}"
+    }
+  }
+}
+
+# ---------------------------------------------------------------- Worker (Cloud Function -> Lambda)
+data "archive_file" "worker" {
+  type        = "zip"
+  source_file = "${path.module}/../app/worker.py"
+  output_path = "${path.module}/.build/worker.zip"
+}
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+resource "aws_iam_role" "worker" {
+  name               = "orders-worker"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+resource "aws_iam_role_policy_attachment" "worker" {
+  role       = aws_iam_role.worker.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaSQSQueueExecutionRole"
+}
+resource "aws_lambda_function" "worker" {
+  function_name    = "orders-worker"
+  role             = aws_iam_role.worker.arn
+  runtime          = "python3.12"
+  handler          = "worker.handle"
+  filename         = data.archive_file.worker.output_path
+  source_code_hash = data.archive_file.worker.output_base64sha256
+  timeout          = 540
+  memory_size      = 512
+}
+resource "aws_lambda_event_source_mapping" "worker" {
+  event_source_arn        = aws_sqs_queue.orders_trigger.arn
+  function_name           = aws_lambda_function.worker.arn
+  batch_size              = 10
+  function_response_types = ["ReportBatchItemFailures"]
+}
+
+# ---------------------------------------------------------------- Scheduler (Cloud Scheduler -> EventBridge Scheduler)
+# EventBridge Scheduler cannot call an arbitrary HTTP URL directly; a tiny Lambda does the POST.
+data "archive_file" "rollup_trigger" {
+  type        = "zip"
+  source_file = "${path.module}/lambda/rollup_trigger.py"
+  output_path = "${path.module}/.build/rollup_trigger.zip"
+}
+resource "aws_iam_role" "rollup_trigger" {
+  name               = "nightly-rollup-trigger"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+resource "aws_iam_role_policy_attachment" "rollup_trigger" {
+  role       = aws_iam_role.rollup_trigger.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+resource "aws_lambda_function" "rollup_trigger" {
+  function_name    = "nightly-rollup-trigger"
+  role             = aws_iam_role.rollup_trigger.arn
+  runtime          = "python3.12"
+  handler          = "rollup_trigger.handler"
+  filename         = data.archive_file.rollup_trigger.output_path
+  source_code_hash = data.archive_file.rollup_trigger.output_base64sha256
+  timeout          = 900
+  environment {
+    variables = { URL = "http://${aws_lb.api.dns_name}/jobs/rollup" }
+  }
+}
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+resource "aws_iam_role" "scheduler" {
+  name               = "nightly-rollup-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version   = "2012-10-17"
+    Statement = [{ Effect = "Allow", Action = "lambda:InvokeFunction", Resource = aws_lambda_function.rollup_trigger.arn }]
+  })
+}
+resource "aws_scheduler_schedule" "nightly" {
+  name                         = "nightly-rollup"
+  schedule_expression          = "cron(0 2 * * ? *)"
+  schedule_expression_timezone = "America/New_York"
+  flexible_time_window { mode = "OFF" }
+  target {
+    arn      = aws_lambda_function.rollup_trigger.arn
+    role_arn = aws_iam_role.scheduler.arn
+    retry_policy { maximum_retry_attempts = 0 }
+  }
+}
