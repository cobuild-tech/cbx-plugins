+-- Athena (Trino) version. Run via app/api.py, which first drops analytics.daily.
+-- Assumes analytics.orders has: partition_date DATE (was _PARTITIONDATE),
+-- items ARRAY(ROW(sku VARCHAR, qty BIGINT)), amount, customer_id, session_id, created_at.
+CREATE TABLE analytics.daily
+WITH (table_type = 'ICEBERG', format = 'PARQUET', location = '${ANALYTICS_LOCATION}/daily') AS
+WITH agg AS (
+  SELECT CAST(date_trunc('day', created_at) AS DATE) AS day,
+         customer_id,
+         SUM(TRY_CAST(amount AS DECIMAL(38, 9))) AS amount,
+         slice(array_agg(CAST(ROW(sku, qty) AS ROW(sku VARCHAR, qty BIGINT)) ORDER BY qty DESC), 1, 3) AS top_items,
