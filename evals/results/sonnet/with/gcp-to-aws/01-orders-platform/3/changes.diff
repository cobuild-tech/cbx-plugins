 @app.post("/orders")
 def create_order():
     o = request.json
-    pub.publish(TOPIC, json.dumps(o).encode(), ordering_key=o["customer_id"]).result()
+    sns.publish(
+        TopicArn=TOPIC_ARN,
+        Message=json.dumps(o),
+        MessageGroupId=str(o["customer_id"]),  # ordering_key
+        MessageDeduplicationId=uuid.uuid4().hex,
+    )
     return {"ok": True}
 
+def _athena(sql, timeout=850):
+    qid = athena.start_query_execution(
+        QueryString=sql, WorkGroup=os.environ["ATHENA_WORKGROUP"]
+    )["QueryExecutionId"]
+    deadline = time.time() + timeout
+    while time.time() < deadline:
+        st = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+        if st["State"] == "SUCCEEDED":
+            return
+        if st["State"] in ("FAILED", "CANCELLED"):
+            raise RuntimeError(f"athena {st['State']}: {st.get('StateChangeReason')}")
+        time.sleep(2)
+    raise TimeoutError("athena query timed out")
