+         ARRAY_AGG(i.sku IGNORE NULLS ORDER BY i.qty DESC LIMIT 3) AS top_skus,
+         APPROX_COUNT_DISTINCT(o.session_id) AS sessions,
+         ROW_NUMBER() OVER (PARTITION BY o.customer_id ORDER BY SUM(SAFE_CAST(o.amount AS NUMERIC(18, 2))) DESC) AS rn
