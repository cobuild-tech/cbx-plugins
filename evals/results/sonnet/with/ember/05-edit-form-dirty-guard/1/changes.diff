@@ -0,0 +1,31 @@
+import { createRoot, type Root } from 'react-dom/client';
+import { setModifierManager, capabilities } from '@ember/modifier';
+import ProjectEditForm, { type ProjectEditFormProps } from './ProjectEditForm';
+
+interface State {
+  root: Root | null;
+}
+
+// Minimal modifier: create the root once on install, re-render on arg change,
+// unmount on destroy. (No ember-modifier / render-modifiers dependency.)
+const manager = {
+  capabilities: capabilities('3.22', { disableAutoTracking: false }),
+  createModifier(): State {
+    return { root: null };
+  },
+  installModifier(state: State, element: HTMLElement, args: { positional: [ProjectEditFormProps] }) {
+    state.root = createRoot(element);
+    state.root.render(<ProjectEditForm {...args.positional[0]} />);
+  },
+  updateModifier(state: State, args: { positional: [ProjectEditFormProps] }) {
+    state.root?.render(<ProjectEditForm {...args.positional[0]} />);
+  },
+  destroyModifier(state: State) {
+    const root = state.root;
+    state.root = null;
+    // Defer: React forbids unmounting synchronously during another render.
+    queueMicrotask(() => root?.unmount());
+  },
+};
+
+export default setModifierManager(() => manager, class {});
