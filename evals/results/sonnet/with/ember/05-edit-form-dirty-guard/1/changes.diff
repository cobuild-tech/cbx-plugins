@@ -0,0 +1,55 @@
+import { useState } from 'react';
+
+export interface ProjectEditFormProps {
+  initialName: string;
+  initialDescription: string;
+  nameErrors: string[];
+  isSaving: boolean;
+  onNameChange(value: string): void;
+  onDescriptionChange(value: string): void;
+  onSave(): void;
+  onCancel(): void;
+}
+
+export default function ProjectEditForm(props: ProjectEditFormProps) {
+  // Local state keeps the controlled inputs synchronous; every change is also
+  // written through to the Ember Data record so hasDirtyAttributes stays true.
+  const [name, setName] = useState(props.initialName);
+  const [description, setDescription] = useState(props.initialDescription);
+
+  return (
+    <form
+      onSubmit={(e) => {
+        e.preventDefault();
+        props.onSave();
+      }}
+    >
+      <input
+        type="text"
+        value={name}
+        onChange={(e) => {
+          setName(e.target.value);
+          props.onNameChange(e.target.value);
+        }}
+      />
+      {props.nameErrors.map((message, i) => (
+        <p key={i} className="err">
+          {message}
+        </p>
+      ))}
+      <textarea
+        value={description}
+        onChange={(e) => {
+          setDescription(e.target.value);
+          props.onDescriptionChange(e.target.value);
+        }}
+      />
+      <button type="submit" disabled={props.isSaving}>
+        Save
+      </button>
+      <button type="button" onClick={() => props.onCancel()}>
+        Cancel
+      </button>
+    </form>
+  );
+}
