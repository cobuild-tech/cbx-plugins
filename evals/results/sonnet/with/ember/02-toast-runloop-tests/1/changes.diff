+++ b/app/react/toasts/ToastStack.tsx
@@ -0,0 +1,15 @@
+import { useSyncExternalStore } from 'react';
+import { toastStore } from './store';
+
+export function ToastStack() {
+  const items = useSyncExternalStore(toastStore.subscribe, toastStore.getSnapshot);
+  return (
+    <ul className="toasts">
+      {items.map((t) => (
+        <li key={t.id} onClick={() => toastStore.dismiss(t)}>
+          {t.text}
+        </li>
+      ))}
+    </ul>
+  );
+}
diff --git a/app/react/toasts/store.ts b/app/react/toasts/store.ts
new file mode 100644
index 0000000..ff8f426
--- /dev/null
+++ b/app/react/toasts/store.ts
@@ -0,0 +1,54 @@
+// Framework-agnostic toast store. Shared by React (useSyncExternalStore) and
+// the Ember `toasts` service wrapper. Temporary bridge: delete the wrapper
+// once no Ember code calls `this.toasts.show`.
+
+export interface Toast {
+  id: number;
+  text: string;
+  timer: unknown;
+}
+
+export interface Scheduler {
+  later(fn: () => void, ms: number): unknown;
+  cancel(timer: unknown): void;
+}
+
+// Default: plain timers. The Ember service swaps in the run loop's
+// later/cancel so `settled()` keeps waiting for toast expiry in tests.
+let scheduler: Scheduler = {
+  later: (fn, ms) => setTimeout(fn, ms),
+  cancel: (timer) => clearTimeout(timer as ReturnType<typeof setTimeout>),
+};
+
+export function setScheduler(next: Scheduler): void {
+  scheduler = next;
+}
+
+let snapshot: readonly Toast[] = [];
+const listeners = new Set<() => void>();
+
+function publish(next: readonly Toast[]): void {
+  snapshot = next;
+  listeners.forEach((l) => l());
+}
+
+export const toastStore = {
+  subscribe(listener: () => void): () => void {
+    listeners.add(listener);
+    return () => {
+      listeners.delete(listener);
+    };
+  },
+  getSnapshot(): readonly Toast[] {
+    return snapshot; // same reference until items change
+  },
+  show(text: string, ms = 4000): void {
+    const t: Toast = { text, id: Math.random(), timer: null };
+    t.timer = scheduler.later(() => toastStore.dismiss(t), ms);
+    publish([...snapshot, t]);
+  },
+  dismiss(t: Toast): void {
+    scheduler.cancel(t.timer);
+    publish(snapshot.filter((x) => x !== t));
+  },
+};
