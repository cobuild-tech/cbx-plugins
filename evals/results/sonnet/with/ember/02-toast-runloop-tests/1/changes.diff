@@ -0,0 +1,11 @@
+import { modifier } from 'ember-modifier';
+import { createRoot } from 'react-dom/client';
+import { createElement } from 'react';
+import { ToastStack } from '../react/toasts/ToastStack';
+
+// Creates the React root once on insert; unmounts on teardown.
+export default modifier((element) => {
+  const root = createRoot(element);
+  root.render(createElement(ToastStack));
+  return () => root.unmount();
+});
