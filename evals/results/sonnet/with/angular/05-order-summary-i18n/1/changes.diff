+export class OrderSummaryComponent implements AfterViewInit, OnChanges, OnDestroy {
+  @Input() order!: Order | null;
+
+  private root: Root | null = null;
+  private sub?: Subscription;
+
+  constructor(
+    private host: ElementRef<HTMLElement>,
+    private translate: TranslateService,
+    @Inject(LOCALE_ID) private locale: string,
+  ) {}
+
+  ngAfterViewInit() {
+    this.root = createRoot(this.host.nativeElement);
+    this.render();
+    // Runtime language switches / late-loaded translations must re-render (the old pipe was impure).
+    this.sub = merge(
+      this.translate.onLangChange,
+      this.translate.onTranslationChange,
+      this.translate.onDefaultLangChange,
+    ).subscribe(() => this.render());
+  }
+
+  ngOnChanges() {
+    this.render(); // first call precedes ngAfterViewInit, hence the guard
+  }
+
+  ngOnDestroy() {
+    this.sub?.unsubscribe();
+    this.root?.unmount();
+    this.root = null;
+  }
+
+  private render() {
+    this.root?.render(
+      createElement(OrderSummary, {
+        order: this.order,
+        locale: this.locale,
+        t: (key, params) => this.translate.instant(key, params),
+      }),
+    );
+  }
