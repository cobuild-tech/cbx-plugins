@@ -0,0 +1,41 @@
+import React from 'react';
+
+export interface Order {
+  placedAt: string;
+  total: number;
+  currency: string;
+  items: unknown[];
+}
+
+export interface OrderSummaryProps {
+  order: Order | null;
+  /** Angular LOCALE_ID (e.g. 'de-DE'). */
+  locale: string;
+  /** Bridges to ngx-translate's TranslateService.instant (same instance, same runtime language). */
+  t: (key: string, params?: Record<string, unknown>) => string;
+}
+
+// Angular's DatePipe treats a date-only ISO string (yyyy-MM-dd) as a LOCAL date;
+// `new Date('2026-11-03')` would be UTC and can shift the day.
+function toDate(value: string): Date {
+  const m = /^(\d{4})-(\d{1,2})-(\d{1,2})$/.exec(value);
+  return m ? new Date(+m[1], +m[2] - 1, +m[3]) : new Date(value);
+}
+
+export function OrderSummary({ order, locale, t }: OrderSummaryProps) {
+  // Angular's `order$ | async` emits null first; render nothing until the order arrives.
+  if (!order) return null;
+
+  const date = new Intl.DateTimeFormat(locale, { dateStyle: 'long' }).format(toDate(order.placedAt));
+  const total = new Intl.NumberFormat(locale, { style: 'currency', currency: order.currency }).format(order.total);
+
+  return (
+    <>
+      <h3>{t('order.summary')}</h3>
+      <p>{t('order.placed', { date })}</p>
+      <p className="total">{total}</p>
+      {order.items.length === 1 && <p>{t('order.oneItem')}</p>}
+      {order.items.length !== 1 && <p>{t('order.nItems', { n: order.items.length })}</p>}
+    </>
+  );
+}
