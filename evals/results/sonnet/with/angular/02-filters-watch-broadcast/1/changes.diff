@@ -0,0 +1,46 @@
+import { createRoot, type Root } from 'react-dom/client';
+import { FiltersPanel, type Filters } from './FiltersPanel';
+
+declare const angular: any; // AngularJS global (script-tag build)
+
+/**
+ * AngularJS wrapper: <filters-panel></filters-panel> replaces
+ * <div ng-controller="FiltersCtrl"> + filters.html.
+ * Still owns the AngularJS side: $location (URL) and the 'filters:changed'
+ * broadcast that ResultsCtrl listens to.
+ */
+angular.module('catalog').component('filtersPanel', {
+  controller: [
+    '$element', '$location', '$rootScope',
+    class FiltersPanelCtrl {
+      private root: Root | null = null;
+      constructor(
+        private $element: any,
+        private $location: any,
+        private $rootScope: any,
+      ) {}
+
+      $postLink() {
+        const initial: Filters = angular.extend(
+          { q: '', brands: [], inStock: false },
+          this.$location.search(),
+        );
+        this.root = createRoot(this.$element[0]);
+        this.root.render(<FiltersPanel initial={initial} onChange={this.onChange} />);
+      }
+
+      // Fires from a setTimeout (outside a digest), mirroring $timeout's trailing digest.
+      private onChange = (nv: Filters) => {
+        this.$rootScope.$apply(() => {
+          this.$location.search(nv); // keeps URL shareable
+          this.$rootScope.$broadcast('filters:changed', angular.copy(nv));
+        });
+      };
+
+      $onDestroy() {
+        this.root?.unmount();
+        this.root = null;
+      }
+    },
+  ],
+});
