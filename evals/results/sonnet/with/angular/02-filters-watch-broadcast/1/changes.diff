+++ b/src/react/FiltersPanel.tsx
@@ -0,0 +1,69 @@
+import { useEffect, useRef, useState } from 'react';
+
+export interface Filters {
+  q: string;
+  brands: string[];
+  inStock: boolean;
+  [key: string]: unknown; // extra keys from $location.search() are carried through, as before
+}
+
+export interface FiltersPanelProps {
+  /** Defaults merged with $location.search(), computed by the AngularJS wrapper. */
+  initial: Filters;
+  /** Called 300ms after the last change (debounced), never for the initial value. */
+  onChange: (filters: Filters) => void;
+}
+
+const BRANDS = ['Acme', 'Globex', 'Initech'];
+const DEBOUNCE_MS = 300;
+
+export function FiltersPanel({ initial, onChange }: FiltersPanelProps) {
+  const [filters, setFilters] = useState<Filters>(initial);
+  const initialRef = useRef(filters);
+  const onChangeRef = useRef(onChange);
+  onChangeRef.current = onChange;
+
+  // Replaces $watch('filters', ..., true) + $timeout debounce.
+  useEffect(() => {
+    if (filters === initialRef.current) return; // nv === ov
+    const t = setTimeout(() => onChangeRef.current(filters), DEBOUNCE_MS);
+    return () => clearTimeout(t); // $timeout.cancel(pending)
+  }, [filters]);
+
+  const brands = Array.isArray(filters.brands) ? filters.brands : [];
+
+  const toggleBrand = (b: string, checked: boolean) =>
+    setFilters(f => {
+      const cur = Array.isArray(f.brands) ? f.brands : [];
+      const next = checked ? (cur.includes(b) ? cur : [...cur, b]) : cur.filter(x => x !== b);
+      return { ...f, brands: next };
+    });
+
+  return (
+    <div>
+      <input
+        placeholder="Search"
+        value={String(filters.q ?? '')}
+        onChange={e => setFilters(f => ({ ...f, q: e.target.value }))}
+      />
+      {BRANDS.map(b => (
+        <label key={b}>
+          <input
+            type="checkbox"
+            checked={brands.includes(b)}
+            onChange={e => toggleBrand(b, e.target.checked)}
+          />
+          {b}
+        </label>
+      ))}
+      <label>
+        <input
+          type="checkbox"
+          checked={!!filters.inStock}
+          onChange={e => setFilters(f => ({ ...f, inStock: e.target.checked }))}
+        />{' '}
+        In stock
+      </label>
+    </div>
+  );
+}
