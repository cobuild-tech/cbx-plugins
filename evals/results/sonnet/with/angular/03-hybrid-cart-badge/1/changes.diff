@@ -0,0 +1,26 @@
+import { createRoot, type Root } from 'react-dom/client';
+import { CartBadge } from './CartBadge';
+
+declare const angular: any;
+
+// AngularJS wrapper: keeps the <cart-badge> element used by legacy/header.html.
+// The downgraded Angular CartService is injected, so React reads the same
+// instance (and the same BehaviorSubject) as the AngularJS controllers.
+angular.module('shop').component('cartBadge', {
+  controller: [
+    '$element',
+    'cartService',
+    class CartBadgeCtrl {
+      private root: Root | null = null;
+      constructor(private $element: any, private cartService: any) {}
+      $postLink() {
+        this.root = createRoot(this.$element[0]);
+        this.root.render(<CartBadge count$={this.cartService.count$} />);
+      }
+      $onDestroy() {
+        this.root?.unmount();
+        this.root = null;
+      }
+    },
+  ],
+});
