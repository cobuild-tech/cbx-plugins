@@ -0,0 +1,35 @@
+import React, { useState } from 'react';
+
+export interface TagInputProps {
+  value: string[];
+  onChange: (tags: string[]) => void;
+}
+
+export function TagInput({ value, onChange }: TagInputProps) {
+  const [draft, setDraft] = useState('');
+
+  const onKeyDown = (e: React.KeyboardEvent<HTMLInputElement>) => {
+    const text = draft.trim();
+    if (e.key === 'Enter' && text) {
+      e.preventDefault();
+      setDraft('');
+      onChange([...value, text]);
+    }
+  };
+
+  return (
+    <>
+      {value.map((t, i) => (
+        <span className="tag" key={`${t}-${i}`}>
+          {t}{' '}
+          <a onClick={() => onChange(value.filter((_, j) => j !== i))}>×</a>
+        </span>
+      ))}
+      <input
+        value={draft}
+        onChange={(e) => setDraft(e.target.value)}
+        onKeyDown={onKeyDown}
+      />
+    </>
+  );
+}
diff --git a/src/react/tag-input.bridge.tsx b/src/react/tag-input.bridge.tsx
new file mode 100644
index 0000000..7040a3d
--- /dev/null
+++ b/src/react/tag-input.bridge.tsx
@@ -0,0 +1,47 @@
+import React from 'react';
+import { createRoot } from 'react-dom/client';
+import { TagInput } from './TagInput';
+
+declare const angular: any;
+
+// Thin AngularJS adapter: keeps <tag-input ng-model max required> working in
+// contact-form.html (ngModel, validators, $touched, form registration) while
+// the UI itself is the React <TagInput>. react2angular can't be used because
+// it has no ngModel support.
+angular.module('crm').directive('tagInput', () => ({
+  require: 'ngModel',
+  restrict: 'E',
+  scope: { max: '<' },
+  link(scope: any, el: any, _attrs: any, ngModel: any) {
+    const root = createRoot(el[0]);
+    let tags: string[] = [];
+
+    const render = () =>
+      root.render(
+        <TagInput
+          value={tags}
+          onChange={(next) => {
+            // React events fire outside the Angular digest.
+            scope.$apply(() => {
+              tags = next;
+              ngModel.$setViewValue(next.slice());
+              ngModel.$setTouched();
+            });
+            render();
+          }}
+        />
+      );
+
+    ngModel.$render = () => {
+      tags = (ngModel.$viewValue || []).slice();
+      render();
+    };
+    ngModel.$validators.maxTags = (v: string[] | undefined) =>
+      !v || v.length <= (scope.max || 5);
+    ngModel.$isEmpty = (v: string[] | undefined) => !v || v.length === 0;
+
+    scope.$watch('max', () => ngModel.$validate());
+    scope.$on('$destroy', () => root.unmount());
+    render();
+  },
+}));
