diff --git a/src/BookingForm.tsx b/src/BookingForm.tsx
new file mode 100644
index 0000000..8eb901b
--- /dev/null
+++ b/src/BookingForm.tsx
@@ -0,0 +1,128 @@
+import { useEffect, useRef, useState } from 'react';
+import type { FormEvent, KeyboardEvent } from 'react';
+
+type Slot = { id: string | number; label: string };
+type Field = 'name' | 'ship_date';
+
+// Same messages jquery-validate produced for these rules.
+const REQUIRED = 'This field is required.';
+const SHIP_DATE_MESSAGE = 'Pick a weekday from tomorrow onward'; // overrides every ship_date rule
+
+function validateField(field: Field, value: string): string | null {
+  // jquery-validate "required" trims; "minlength" uses the raw length.
+  if (value.trim().length === 0) return field === 'ship_date' ? SHIP_DATE_MESSAGE : REQUIRED;
+  if (field === 'name' && value.length < 2) return 'Please enter at least 2 characters.';
+  return null;
+}
+
+// Keys jquery-validate ignores on keyup.
+const EXCLUDED_KEYS = [16, 17, 18, 20, 35, 36, 37, 38, 39, 40, 45, 144, 225];
+
+export function BookingForm() {
+  const [name, setName] = useState('');
+  const [shipDate, setShipDate] = useState('');
+  const [slots, setSlots] = useState<Slot[]>([]);
+  const [slot, setSlot] = useState('');
+  const [errors, setErrors] = useState<Partial<Record<Field, string>>>({});
+  // Mirrors jquery-validate's `submitted` map: fields that failed at a submit attempt.
+  const submitted = useRef<Set<Field>>(new Set());
+  const nameRef = useRef<HTMLInputElement>(null);
+  const dateRef = useRef<HTMLInputElement>(null);
+
+  const values: Record<Field, string> = { name, ship_date: shipDate };
+
+  function checkField(field: Field, value: string) {
+    const message = validateField(field, value);
+    setErrors((prev) => {
+      const next = { ...prev };
+      if (message) next[field] = message;
+      else delete next[field];
+      return next;
+    });
+  }
+
+  // jQuery UI datepicker stays (same options as widgets.js). Its selection and the
+  // original jQuery 'change' handler both go through jQuery events, so bind there.
+  useEffect(() => {
+    const $input = window.jQuery(dateRef.current);
+    $input.datepicker({
+      dateFormat: 'dd/mm/yy',
+      minDate: 1,
+      beforeShowDay: window.jQuery.datepicker.noWeekends,
+    });
+    $input.on('change', () => {
+      const value = dateRef.current!.value;
+      setShipDate(value); // datepicker writes the DOM value without a React event
+      // Still $.getJSON on purpose: same headers/encoding, and it keeps firing ajaxComplete.
+      window.jQuery.getJSON('/slots', { date: value }, (result: Slot[]) => {
+        setSlots(result);
+        setSlot(result.length ? String(result[0].id) : ''); // browser selects first option
+      });
+    });
+    return () => {
+      $input.off('change');
+      $input.datepicker('destroy');
+    };
+  }, []);
+
+  function onSubmit(e: FormEvent<HTMLFormElement>) {
+    const next: Partial<Record<Field, string>> = {};
+    (['name', 'ship_date'] as Field[]).forEach((f) => {
+      const message = validateField(f, values[f]);
+      if (message) next[f] = message;
+    });
+    setErrors(next);
+    const failed = Object.keys(next) as Field[];
+    if (failed.length) {
+      e.preventDefault();
+      failed.forEach((f) => submitted.current.add(f));
+      (failed.includes('name') ? nameRef : dateRef).current?.focus();
+    }
+    // Valid: let the browser post the form natively, as before.
+  }
+
+  function onBlur(field: Field) {
+    // jquery-validate: validate on blur if previously submitted or non-empty.
+    if (submitted.current.has(field) || values[field].trim().length > 0) checkField(field, values[field]);
+  }
+
+  function onKeyUp(field: Field, e: KeyboardEvent<HTMLInputElement>) {
+    if ((e.which === 9 && values[field] === '') || EXCLUDED_KEYS.includes(e.which)) return;
+    if (submitted.current.has(field) || errors[field]) checkField(field, e.currentTarget.value);
+  }
+
+  return (
+    <form id="booking" action="/bookings" method="post" onSubmit={onSubmit}>
+      <input
+        ref={nameRef}
+        name="name"
+        id="name"
+        className={errors.name ? 'error' : undefined}
+        value={name}
+        onChange={(e) => setName(e.target.value)}
+        onBlur={() => onBlur('name')}
+        onKeyUp={(e) => onKeyUp('name', e)}
+      />
+      {errors.name && <label id="name-error" className="error" htmlFor="name">{errors.name}</label>}
+      <input
+        ref={dateRef}
+        name="ship_date"
+        id="ship-date"
+        className={errors.ship_date ? 'error' : undefined}
+        value={shipDate}
+        onChange={(e) => setShipDate(e.target.value)}
+        onBlur={() => onBlur('ship_date')}
+        onKeyUp={(e) => onKeyUp('ship_date', e)}
+      />
+      {errors.ship_date && (
+        <label id="ship-date-error" className="error" htmlFor="ship-date">{errors.ship_date}</label>
+      )}
+      <select name="slot" id="slot" value={slot} onChange={(e) => setSlot(e.target.value)}>
+        {slots.map((s) => (
+          <option key={s.id} value={s.id}>{s.label}</option>
+        ))}
+      </select>
+      <button type="submit">Book</button>
+    </form>
+  );
+}
