diff --git a/src/notifications/Notifications.tsx b/src/notifications/Notifications.tsx
new file mode 100644
index 0000000..9f55411
--- /dev/null
+++ b/src/notifications/Notifications.tsx
@@ -0,0 +1,67 @@
+import { useEffect, useRef, useState } from 'react';
+import { fetchNotifications, markRead, type Notification } from './api';
+
+interface Item extends Notification {
+  key: number; // unique per received item; server ids could repeat
+  read: boolean;
+}
+
+const POLL_MS = 15000;
+
+export function Notifications() {
+  // Newest first, matching the original's prepend().
+  const [items, setItems] = useState<Item[]>([]);
+  // false until the first successful response (count span starts empty/visible).
+  const [loaded, setLoaded] = useState(false);
+  const lastSeen = useRef(0);
+  const nextKey = useRef(0);
+
+  useEffect(() => {
+    function poll() {
+      fetchNotifications(lastSeen.current).then(
+        (incoming) => {
+          const added: Item[] = [];
+          for (const n of incoming) {
+            added.unshift({ ...n, key: nextKey.current++, read: false });
+            lastSeen.current = Math.max(lastSeen.current, n.id);
+          }
+          setItems((prev) => [...added, ...prev]);
+          setLoaded(true);
+        },
+        () => {
+          /* original ignored failures (global ajaxError still runs) */
+        },
+      );
+    }
+    poll();
+    // Original: setInterval first, then an immediate poll. Overlapping polls
+    // are not cancelled there either.
+    const timer = setInterval(poll, POLL_MS);
+    return () => clearInterval(timer);
+  }, []);
+
+  function handleClick(key: number, id: number) {
+    markRead(id);
+    setItems((prev) => prev.map((i) => (i.key === key ? { ...i, read: true } : i)));
+  }
+
+  return (
+    <>
+      <span id="notif-count" style={{ display: loaded && items.length === 0 ? 'none' : undefined }}>
+        {loaded ? items.length : ''}
+      </span>
+      <ul id="notif-list">
+        {items.map((i) => (
+          <li
+            key={i.key}
+            data-id={i.id}
+            className={i.read ? 'read' : undefined}
+            onClick={() => handleClick(i.key, i.id)}
+            // n.html is server-provided HTML, injected raw as before.
+            dangerouslySetInnerHTML={{ __html: i.html }}
+          />
+        ))}
+      </ul>
+    </>
+  );
+}
diff --git a/src/notifications/api.ts b/src/notifications/api.ts
new file mode 100644
index 0000000..9b3f350
--- /dev/null
+++ b/src/notifications/api.ts
@@ -0,0 +1,23 @@
+// Deliberately still goes through jQuery's $.getJSON/$.post (global, loaded by
+// a <script> tag). That keeps global.js's $.ajaxSetup (CSRF header, cache:false),
+// the #spinner ajaxStart/ajaxStop hooks, the 401 -> /login redirect, and the
+// X-Requested-With header working for these requests. Remove when global.js
+// is migrated.
+
+export interface Notification {
+  id: number;
+  html: string;
+}
+
+export function fetchNotifications(since: number): Promise<Notification[]> {
+  return new Promise((resolve, reject) => {
+    $.getJSON('/notifications', { since })
+      .done((items: Notification[]) => resolve(items))
+      .fail((_xhr, _status, err) => reject(err));
+  });
+}
+
+export function markRead(id: number): void {
+  // Fire-and-forget, like the original.
+  $.post('/notifications/' + id + '/read');
+}
