diff --git a/src/Chat.tsx b/src/Chat.tsx
new file mode 100644
index 0000000..9649e78
--- /dev/null
+++ b/src/Chat.tsx
@@ -0,0 +1,47 @@
+import { FormEvent, useEffect, useRef, useState } from 'react';
+import { useChatSocket } from './useChatSocket';
+
+declare global {
+  interface Window {
+    Chat?: { send: (text: string) => void };
+  }
+}
+
+export function Chat() {
+  const { messages, send } = useChatSocket();
+  const [draft, setDraft] = useState('');
+  const logRef = useRef<HTMLUListElement>(null);
+
+  // Legacy bridge: support-macros.js calls window.Chat.send
+  useEffect(() => {
+    window.Chat = { send };
+    return () => {
+      delete window.Chat;
+    };
+  }, [send]);
+
+  useEffect(() => {
+    const log = logRef.current;
+    if (log) log.scrollTop = log.scrollHeight;
+  }, [messages]);
+
+  const onSubmit = (e: FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    send(draft);
+    setDraft('');
+  };
+
+  return (
+    <>
+      <ul id="chat-log" ref={logRef}>
+        {messages.map((m, i) => (
+          <li key={i}>{m.user + ': ' + m.text}</li>
+        ))}
+      </ul>
+      <form id="chat-form" onSubmit={onSubmit}>
+        <input name="msg" value={draft} onChange={(e) => setDraft(e.target.value)} />
+        <button>Send</button>
+      </form>
+    </>
+  );
+}
