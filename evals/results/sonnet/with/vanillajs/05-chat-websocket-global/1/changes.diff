diff --git a/src/useChatSocket.ts b/src/useChatSocket.ts
new file mode 100644
index 0000000..f2da0af
--- /dev/null
+++ b/src/useChatSocket.ts
@@ -0,0 +1,51 @@
+import { useCallback, useEffect, useRef, useState } from 'react';
+
+export interface ChatMessage {
+  user: string;
+  text: string;
+}
+
+export function useChatSocket() {
+  const [messages, setMessages] = useState<ChatMessage[]>([]);
+  const wsRef = useRef<WebSocket | null>(null);
+  const queueRef = useRef<string[]>([]);
+
+  useEffect(() => {
+    let retry = 0;
+    let timer: ReturnType<typeof setTimeout> | undefined;
+    let disposed = false;
+
+    const connect = () => {
+      const ws = new WebSocket('wss://' + location.host + '/chat');
+      wsRef.current = ws;
+      ws.onopen = () => {
+        retry = 0;
+        queueRef.current.splice(0).forEach((m) => ws.send(m));
+      };
+      ws.onmessage = (e) => {
+        const m = JSON.parse(e.data) as ChatMessage;
+        setMessages((prev) => [...prev, m]);
+      };
+      ws.onclose = () => {
+        if (disposed) return;
+        timer = setTimeout(connect, Math.min(30000, 1000 * Math.pow(2, retry++)));
+      };
+    };
+
+    connect();
+    return () => {
+      disposed = true;
+      clearTimeout(timer);
+      wsRef.current?.close();
+    };
+  }, []);
+
+  const send = useCallback((text: string) => {
+    const m = JSON.stringify({ text });
+    const ws = wsRef.current;
+    if (ws && ws.readyState === WebSocket.OPEN) ws.send(m);
+    else queueRef.current.push(m);
+  }, []);
+
+  return { messages, send };
+}
