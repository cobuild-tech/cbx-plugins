new file mode 100644
index 0000000..ab0bf06
--- /dev/null
+++ b/src/App.tsx
@@ -0,0 +1,33 @@
+import { FormEvent, useSyncExternalStore } from 'react';
+import { addNote, getNotes, getVersion, removeNote, subscribe } from './notesStore';
+
+export function App() {
+  useSyncExternalStore(subscribe, getVersion);
+  const notes = getNotes();
+
+  function onSubmit(e: FormEvent<HTMLFormElement>) {
+    e.preventDefault();
+    const form = e.currentTarget;
+    const input = form.elements.namedItem('t') as HTMLInputElement;
+    const t = input.value.trim();
+    if (!t) return;
+    addNote(t);
+    form.reset();
+  }
+
+  return (
+    <>
+      <ul id="notes">
+        {notes.map((n, i) => (
+          <li key={i} onDoubleClick={() => removeNote(i)}>
+            {n.text}
+          </li>
+        ))}
+      </ul>
+      <form id="add" onSubmit={onSubmit}>
+        <input name="t" />
+        <button>Add</button>
+      </form>
+    </>
+  );
+}
