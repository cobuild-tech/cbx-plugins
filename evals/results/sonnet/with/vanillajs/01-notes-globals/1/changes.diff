diff --git a/src/notesStore.ts b/src/notesStore.ts
new file mode 100644
index 0000000..7e7214f
--- /dev/null
+++ b/src/notesStore.ts
@@ -0,0 +1,64 @@
+export interface Note {
+  text: string;
+  at: number;
+}
+
+let notes: Note[] = JSON.parse(localStorage.getItem('notes') || '[]');
+let version = 0;
+const listeners = new Set<() => void>();
+
+export const getNotes = (): Note[] => notes;
+export const getVersion = (): number => version;
+
+export function subscribe(l: () => void): () => void {
+  listeners.add(l);
+  return () => listeners.delete(l);
+}
+
+export function save(): void {
+  localStorage.setItem('notes', JSON.stringify(notes));
+}
+
+// Notifies React that `notes` changed (also used by legacy callers that mutate in place).
+export function render(): void {
+  version++;
+  listeners.forEach((l) => l());
+}
+
+export function addNote(text: string): void {
+  notes.push({ text, at: Date.now() });
+  save();
+  render();
+}
+
+export function removeNote(i: number): void {
+  notes.splice(i, 1);
+  save();
+  render();
+}
+
+window.addEventListener('storage', (e) => {
+  if (e.key === 'notes') {
+    notes = JSON.parse(e.newValue || '[]');
+    render();
+  }
+});
+
+// Bridge for export.js (other team, unchanged): it reads the global `notes`
+// and calls the globals `save()` and `render()` from window.importNotes.
+declare global {
+  interface Window {
+    notes: Note[];
+    save: () => void;
+    render: () => void;
+  }
+}
+Object.defineProperty(window, 'notes', {
+  get: () => notes,
+  set: (v: Note[]) => {
+    notes = v;
+  },
+  configurable: true,
+});
+window.save = save;
+window.render = render;
