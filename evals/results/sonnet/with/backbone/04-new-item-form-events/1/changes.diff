+import { useState, type FormEvent } from 'react';
+import type { Collection, Model } from 'backbone';
+
+export interface NewItemFormProps {
+  /** The shared app.items instance (not copied; saved to via create). */
+  collection: Collection<Model>;
+  /** Called after a successful, server-confirmed create. */
+  onSaved: (model: Model) => void;
+}
+
+/** Same markup as the old Backbone template: form.new-item > input, input, button, p.err */
+export function NewItemForm({ collection, onSaved }: NewItemFormProps) {
+  const [name, setName] = useState('');
+  const [qty, setQty] = useState('1');
+  const [err, setErr] = useState('');
+
+  const onSubmit = (e: FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    collection.create(
+      { name, qty: +qty },
+      {
+        wait: true,
+        success: (m: Model) => onSaved(m),
+        error: (_m: Model, xhr: JQuery.jqXHR) =>
+          setErr(((xhr.responseJSON && xhr.responseJSON.errors) || []).join(', ')),
+      },
+    );
+  };
+
+  return (
+    <form className="new-item" onSubmit={onSubmit}>
+      <input name="name" value={name} onChange={(e) => setName(e.target.value)} />
+      <input name="qty" type="number" value={qty} onChange={(e) => setQty(e.target.value)} />
+      <button>Add</button>
+      <p className="err">{err}</p>
+    </form>
+  );
+}
diff --git a/src/react/NewItemView.tsx b/src/react/NewItemView.tsx
new file mode 100644
index 0000000..465590b
--- /dev/null
+++ b/src/react/NewItemView.tsx
@@ -0,0 +1,36 @@
+import Backbone from 'backbone';
+import { createRoot, type Root } from 'react-dom/client';
+import { NewItemForm } from './NewItemForm';
+
+declare const app: { NewItemView: unknown };
+
+/**
+ * Temporary Backbone shell so ItemsPage keeps working unchanged:
+ * same constructor options, render() returning this, 'saved' event, remove().
+ * Delete once ItemsPage is React.
+ */
+export class NewItemView extends Backbone.View {
+  private root: Root | null = null;
+
+  render() {
+    this.root ??= createRoot(this.el);
+    this.root.render(
+      <NewItemForm
+        collection={this.collection}
+        onSaved={(m) => {
+          this.trigger('saved', m);
+          Backbone.history.navigate('items/' + m.id, { trigger: true });
+        }}
+      />,
+    );
+    return this;
+  }
+
+  remove() {
+    this.root?.unmount();
+    this.root = null;
+    return super.remove();
+  }
+}
+
+app.NewItemView = NewItemView;
