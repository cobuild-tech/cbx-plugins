diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..3148b1b
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,298 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = "~> 5.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.4" }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+# GCP project_id was only used to make the bucket name unique. S3 names are global.
+variable "name_prefix" { type = string }
+
+# us-central1 -> us-east-2 (Ohio), the nearest central-US region.
+variable "region" {
+  type    = string
+  default = "us-east-2"
+}
+
+data "aws_caller_identity" "current" {}
+
+locals {
+  incoming_bucket = "${var.name_prefix}-media-incoming"
+}
+
+# ---------------------------------------------------------------- storage
+
+resource "aws_s3_bucket" "incoming" {
+  bucket = local.incoming_bucket
+}
+
+# Uniform bucket-level access -> ACLs disabled + no public access.
+resource "aws_s3_bucket_ownership_controls" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  rule { object_ownership = "BucketOwnerEnforced" }
+}
+
+resource "aws_s3_bucket_public_access_block" "incoming" {
+  bucket                  = aws_s3_bucket.incoming.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# GCS "generation" has no S3 equivalent without versioning: the S3 versionId
+# is the generation. Needed so a re-upload can be told apart from the original.
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration { status = "Enabled" }
+}
+
+# GCS (unversioned) kept only the live object. Drop replaced versions fast.
+resource "aws_s3_bucket_lifecycle_configuration" "incoming" {
+  bucket     = aws_s3_bucket.incoming.id
+  depends_on = [aws_s3_bucket_versioning.incoming]
+  rule {
+    id     = "expire-noncurrent"
+    status = "Enabled"
+    filter {}
+    noncurrent_version_expiration { noncurrent_days = 1 }
+  }
+}
+
+# ---------------------------------------------------------------- events
+
+# google_pubsub_topic.media_events (7-day retention) -> Kinesis stream, 168 h.
+# Pub/Sub attributes (12, SNS/SQS allow 10) travel in the JSON record body.
+resource "aws_kinesis_stream" "media_events" {
+  name             = "media-events"
+  retention_period = 168
+
+  stream_mode_details { stream_mode = "ON_DEMAND" }
+}
+
+# google_cloud_tasks_queue.transcode -> one-time EventBridge Scheduler
+# schedules in a group (the hold is 2 h, beyond SQS's 15 min delay).
+resource "aws_scheduler_schedule_group" "transcode" {
+  name = "transcode"
+}
+
+# ---------------------------------------------------------------- IAM
+# One GCP service account -> one role per function.
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "ingest" {
+  name               = "media-pipeline-ingest"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "ingest_logs" {
+  role       = aws_iam_role.ingest.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+data "aws_iam_policy_document" "ingest" {
+  statement {
+    actions   = ["s3:GetObject", "s3:GetObjectVersion"]
+    resources = ["${aws_s3_bucket.incoming.arn}/*"]
+  }
+  statement {
+    actions   = ["scheduler:CreateSchedule"]
+    resources = ["arn:aws:scheduler:${var.region}:${data.aws_caller_identity.current.account_id}:schedule/${aws_scheduler_schedule_group.transcode.name}/*"]
+  }
+  statement {
+    actions   = ["iam:PassRole"]
+    resources = [aws_iam_role.scheduler.arn]
+  }
+  statement {
+    actions   = ["kinesis:PutRecord"]
+    resources = [aws_kinesis_stream.media_events.arn]
+  }
+}
+
+resource "aws_iam_role_policy" "ingest" {
+  role   = aws_iam_role.ingest.id
+  policy = data.aws_iam_policy_document.ingest.json
+}
+
+resource "aws_iam_role" "transcode" {
+  name               = "media-pipeline-transcode"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "transcode_logs" {
+  role       = aws_iam_role.transcode.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+# Read-only, as the code does today. Add a write grant for wherever the
+# ffmpeg renditions go once that code exists.
+data "aws_iam_policy_document" "transcode" {
+  statement {
+    actions   = ["s3:GetObject", "s3:GetObjectVersion"]
+    resources = ["${aws_s3_bucket.incoming.arn}/*"]
+  }
+  # Without ListBucket a missing key returns 403 instead of 404.
+  statement {
+    actions   = ["s3:ListBucket"]
+    resources = [aws_s3_bucket.incoming.arn]
+  }
+}
+
+resource "aws_iam_role_policy" "transcode" {
+  role   = aws_iam_role.transcode.id
+  policy = data.aws_iam_policy_document.transcode.json
+}
+
+# Role EventBridge Scheduler assumes to call the transcoder
+# (replaces the Cloud Tasks OIDC token).
+resource "aws_iam_role" "scheduler" {
+  name               = "media-pipeline-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = "lambda:InvokeFunction"
+      Resource = aws_lambda_function.transcode.arn
+    }]
+  })
+}
+
+# ---------------------------------------------------------------- functions
+
+data "archive_file" "ingest" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/ingest"
+  output_path = "${path.module}/.build/ingest.zip"
+}
+
+data "archive_file" "transcode" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/transcode"
+  output_path = "${path.module}/.build/transcode.zip"
+}
+
+resource "aws_lambda_function" "ingest" {
+  function_name    = "media-ingest"
+  runtime          = "python3.12"
+  handler          = "main.on_upload"
+  filename         = data.archive_file.ingest.output_path
+  source_code_hash = data.archive_file.ingest.output_base64sha256
+  timeout          = 60
+  role             = aws_iam_role.ingest.arn
+
+  environment {
+    variables = {
+      SCHEDULE_GROUP     = aws_scheduler_schedule_group.transcode.name
+      SCHEDULER_ROLE_ARN = aws_iam_role.scheduler.arn
+      TRANSCODE_ARN      = aws_lambda_function.transcode.arn
+      EVENTS_STREAM      = aws_kinesis_stream.media_events.name
+    }
+  }
+}
+
+# RETRY_POLICY_DO_NOT_RETRY
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+# NOTE: Lambda caps at 900 s; the GCP function ran up to 1800 s.
+resource "aws_lambda_function" "transcode" {
+  function_name    = "media-transcode"
+  runtime          = "python3.12"
+  handler          = "main.transcode"
+  filename         = data.archive_file.transcode.output_path
+  source_code_hash = data.archive_file.transcode.output_base64sha256
+  timeout          = 900
+  memory_size      = 4096
+  role             = aws_iam_role.transcode.arn
+
+  # Cloud Tasks max_concurrent_dispatches = 3. Needs >= 10 unreserved
+  # concurrency left in the account.
+  reserved_concurrent_executions = 3
+}
+
+# Cloud Tasks max_attempts = 4 -> 1 try + 2 retries (Lambda's maximum).
+resource "aws_lambda_function_event_invoke_config" "transcode" {
+  function_name          = aws_lambda_function.transcode.function_name
+  maximum_retry_attempts = 2
+}
+
+# ---------------------------------------------------------------- trigger
+
+resource "aws_lambda_permission" "s3_invoke_ingest" {
+  statement_id   = "AllowS3Invoke"
+  action         = "lambda:InvokeFunction"
+  function_name  = aws_lambda_function.ingest.function_name
+  principal      = "s3.amazonaws.com"
+  source_arn     = aws_s3_bucket.incoming.arn
+  source_account = data.aws_caller_identity.current.account_id
+}
+
+# object.finalized: new objects and overwrites.
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+  depends_on = [aws_lambda_permission.s3_invoke_ingest]
+}
+
+# ---------------------------------------------------------------- analytics
+# google_bigquery_dataset.media -> Glue database + Athena workgroup.
+# The media.uploads table is not defined in this repo; create it (and load
+# its data) separately.
+
+resource "aws_glue_catalog_database" "media" {
+  name = "media"
+}
+
+resource "aws_s3_bucket" "athena_results" {
+  bucket = "${var.name_prefix}-media-athena-results"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena_results" {
+  bucket                  = aws_s3_bucket.athena_results.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_athena_workgroup" "media" {
+  name = "media"
+  configuration {
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena_results.bucket}/"
+    }
+  }
+}
