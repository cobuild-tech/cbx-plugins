+  count_if(day_of_week(uploaded_at) IN (6, 7)) AS weekend_uploads
 FROM media.uploads
-WHERE uploaded_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 56 DAY)
