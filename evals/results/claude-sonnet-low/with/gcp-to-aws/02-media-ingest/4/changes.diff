diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..9b4c457
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,298 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = "~> 5.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.4" }
+  }
+}
+
+# us-central1 (Iowa) -> us-east-2 (Ohio), the nearest AWS region.
+variable "region" {
+  type    = string
+  default = "us-east-2"
+}
+
+# Was var.project_id; only used to build globally unique bucket names.
+variable "name_prefix" { type = string }
+
+provider "aws" {
+  region = var.region
+}
+
+data "aws_caller_identity" "current" {}
+
+locals {
+  account_id = data.aws_caller_identity.current.account_id
+}
+
+# ---------------------------------------------------------------- storage
+
+resource "aws_s3_bucket" "incoming" {
+  bucket = "${var.name_prefix}-media-incoming"
+}
+
+# GCS uniform_bucket_level_access -> ACLs disabled + no public access.
+resource "aws_s3_bucket_ownership_controls" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  rule { object_ownership = "BucketOwnerEnforced" }
+}
+
+resource "aws_s3_bucket_public_access_block" "incoming" {
+  bucket                  = aws_s3_bucket.incoming.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# Needed so every overwrite gets a version ID, which replaces the GCS
+# "generation" used to detect a replaced file.
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration { status = "Enabled" }
+}
+
+# GCS overwrites left no old copy; don't keep replaced versions around.
+resource "aws_s3_bucket_lifecycle_configuration" "incoming" {
+  bucket     = aws_s3_bucket.incoming.id
+  depends_on = [aws_s3_bucket_versioning.incoming]
+  rule {
+    id     = "expire-noncurrent"
+    status = "Enabled"
+    filter {}
+    noncurrent_version_expiration { noncurrent_days = 1 }
+  }
+}
+
+# ------------------------------------------------------- events / queues
+
+# Pub/Sub topic media-events. SNS keeps no messages (the 7-day
+# message_retention_duration has no equivalent) and no subscribers are
+# defined here.
+resource "aws_sns_topic" "media_events" {
+  name = "media-events"
+}
+
+# Cloud Tasks queue "transcode" -> SQS + Lambda consumer.
+resource "aws_sqs_queue" "transcode_dlq" {
+  name                      = "transcode-dlq"
+  message_retention_seconds = 1209600
+}
+
+resource "aws_sqs_queue" "transcode" {
+  name = "transcode"
+  # >= consumer timeout (900 s). Retries come back after this delay.
+  visibility_timeout_seconds = 960
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.transcode_dlq.arn
+    maxReceiveCount     = 4 # was retry_config.max_attempts
+  })
+}
+
+# Delivers each task to the queue at its scheduled time (2 h hold exceeds
+# SQS DelaySeconds' 15 min limit).
+resource "aws_iam_role" "scheduler" {
+  name = "media-pipeline-scheduler"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "scheduler.amazonaws.com" }
+      Action    = "sts:AssumeRole"
+      Condition = { StringEquals = { "aws:SourceAccount" = local.account_id } }
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = "sqs:SendMessage"
+      Resource = aws_sqs_queue.transcode.arn
+    }]
+  })
+}
+
+# --------------------------------------------------------------- functions
+
+data "archive_file" "ingest" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/ingest"
+  output_path = "${path.module}/build/ingest.zip"
+}
+
+data "archive_file" "transcode" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/transcode"
+  output_path = "${path.module}/build/transcode.zip"
+}
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+# The single service account "media-pipeline" becomes one role per function.
+resource "aws_iam_role" "ingest" {
+  name               = "media-ingest"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "ingest_logs" {
+  role       = aws_iam_role.ingest.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_iam_role_policy" "ingest" {
+  role = aws_iam_role.ingest.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket"]
+        Resource = [aws_s3_bucket.incoming.arn, "${aws_s3_bucket.incoming.arn}/*"]
+      },
+      {
+        Effect   = "Allow"
+        Action   = "scheduler:CreateSchedule"
+        Resource = "arn:aws:scheduler:${var.region}:${local.account_id}:schedule/default/*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = "iam:PassRole"
+        Resource = aws_iam_role.scheduler.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = "sns:Publish"
+        Resource = aws_sns_topic.media_events.arn
+      },
+    ]
+  })
+}
+
+resource "aws_lambda_function" "ingest" {
+  function_name    = "media-ingest"
+  runtime          = "python3.12"
+  handler          = "main.on_upload"
+  filename         = data.archive_file.ingest.output_path
+  source_code_hash = data.archive_file.ingest.output_base64sha256
+  role             = aws_iam_role.ingest.arn
+  timeout          = 60
+  memory_size      = 256
+
+  environment {
+    variables = {
+      TASKS_QUEUE_ARN    = aws_sqs_queue.transcode.arn
+      SCHEDULER_ROLE_ARN = aws_iam_role.scheduler.arn
+      EVENTS_TOPIC       = aws_sns_topic.media_events.arn
+    }
+  }
+}
+
+# RETRY_POLICY_DO_NOT_RETRY: S3 invokes asynchronously, which retries twice
+# by default.
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_lambda_permission" "ingest_from_s3" {
+  statement_id   = "AllowS3Invoke"
+  action         = "lambda:InvokeFunction"
+  function_name  = aws_lambda_function.ingest.function_name
+  principal      = "s3.amazonaws.com"
+  source_arn     = aws_s3_bucket.incoming.arn
+  source_account = local.account_id
+}
+
+# Fires on every new object and on every overwrite of an existing name.
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket     = aws_s3_bucket.incoming.id
+  depends_on = [aws_lambda_permission.ingest_from_s3]
+
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+}
+
+resource "aws_iam_role" "transcode" {
+  name               = "media-transcode"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "transcode_sqs" {
+  role       = aws_iam_role.transcode.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaSQSQueueExecutionRole"
+}
+
+resource "aws_iam_role_policy" "transcode" {
+  role = aws_iam_role.transcode.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket"]
+      Resource = [aws_s3_bucket.incoming.arn, "${aws_s3_bucket.incoming.arn}/*"]
+    }]
+  })
+}
+
+resource "aws_lambda_function" "transcode" {
+  function_name    = "media-transcode"
+  runtime          = "python3.12"
+  handler          = "main.transcode"
+  filename         = data.archive_file.transcode.output_path
+  source_code_hash = data.archive_file.transcode.output_base64sha256
+  role             = aws_iam_role.transcode.arn
+  timeout          = 900 # Lambda maximum; was 1800 s
+  memory_size      = 4096
+}
+
+resource "aws_lambda_event_source_mapping" "transcode" {
+  event_source_arn        = aws_sqs_queue.transcode.arn
+  function_name           = aws_lambda_function.transcode.arn
+  batch_size              = 1
+  function_response_types = ["ReportBatchItemFailures"]
+  scaling_config {
+    maximum_concurrency = 3 # was max_concurrent_dispatches
+  }
+}
+
+# -------------------------------------------------------------- analytics
+
+# BigQuery dataset "media" -> Glue database + Athena workgroup.
+resource "aws_s3_bucket" "analytics" {
+  bucket = "${var.name_prefix}-media-analytics"
+}
+
+resource "aws_s3_bucket_public_access_block" "analytics" {
+  bucket                  = aws_s3_bucket.analytics.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_glue_catalog_database" "media" {
+  name         = "media"
+  location_uri = "s3://${aws_s3_bucket.analytics.bucket}/warehouse/"
+}
+
+resource "aws_athena_workgroup" "media" {
+  name = "media"
+  configuration {
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.analytics.bucket}/athena-results/"
+    }
+  }
+}
