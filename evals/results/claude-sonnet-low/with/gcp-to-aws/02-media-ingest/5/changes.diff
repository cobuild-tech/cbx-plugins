-import functions_framework
-from flask import Request
-from google.cloud import storage
+import json
+import os
+import sys
 
-gcs = storage.Client()
+import boto3
+from botocore.exceptions import ClientError
 
+s3 = boto3.client("s3")
 
-@functions_framework.http
-def transcode(request: Request):
-    job = request.get_json()
-    blob = gcs.bucket(job["bucket"]).get_blob(job["name"])
-    if blob is None or str(blob.generation) != str(job["generation"]):
-        return ("stale", 200)               # file was replaced or deleted
+
+def transcode(job):
+    try:
+        head = s3.head_object(Bucket=job["bucket"], Key=job["name"])
+    except ClientError as e:
+        if e.response["Error"]["Code"] in ("404", "NoSuchKey", "NotFound"):
+            return ("stale", 200)           # file was deleted
+        raise
+    if str(head.get("VersionId")) != str(job["generation"]):
+        return ("stale", 200)               # file was replaced
     # ... run ffmpeg, write renditions ...
     return ("ok", 200)
+
+
+if __name__ == "__main__":
+    # Runs as a Fargate task (exceeds Lambda's 15 min); the job arrives in $JOB.
+    body, status = transcode(json.loads(os.environ["JOB"]))
+    print(status, body)
+    sys.exit(0 if status == 200 else 1)
diff --git a/sql/weekly_report.athena.sql b/sql/weekly_report.athena.sql
new file mode 100644
index 0000000..fd5a281
--- /dev/null
+++ b/sql/weekly_report.athena.sql
@@ -0,0 +1,14 @@
+-- Weekly editor report (Athena / Trino). Weeks run Sunday to Saturday, as the editors' schedule does.
+-- Assumes media.uploads.uploaded_at is a zone-less timestamp holding UTC (BigQuery TIMESTAMP semantics).
+SELECT
+  -- Trino date_trunc('week') starts Monday; shift back to Sunday (day_of_week: Mon=1 .. Sun=7)
+  date_add('day', -(day_of_week(CAST(uploaded_at AS date)) % 7), CAST(uploaded_at AS date)) AS week_start,
+  uploader,
+  COUNT(*) AS uploads,
+  CAST(SUM(transcode_seconds) AS double) / NULLIF(COUNT(*), 0) AS avg_transcode_s,
+  -- Trino day_of_week: Sat=6, Sun=7 (BigQuery DAYOFWEEK Sun=1, Sat=7)
+  count_if(day_of_week(uploaded_at) IN (6, 7)) AS weekend_uploads
+FROM media.uploads
+WHERE uploaded_at >= current_timestamp - INTERVAL '56' DAY
+GROUP BY 1, 2
+ORDER BY week_start DESC, uploads DESC;
