diff --git a/functions/transcode/main.py b/functions/transcode/main.py
index a41489d..df4b934 100644
--- a/functions/transcode/main.py
+++ b/functions/transcode/main.py
@@ -1,15 +1,33 @@
-import functions_framework
-from flask import Request
-from google.cloud import storage
+import json
 
-gcs = storage.Client()
+import boto3
+from botocore.exceptions import ClientError
 
+s3 = boto3.client("s3")
 
-@functions_framework.http
-def transcode(request: Request):
-    job = request.get_json()
-    blob = gcs.bucket(job["bucket"]).get_blob(job["name"])
-    if blob is None or str(blob.generation) != str(job["generation"]):
-        return ("stale", 200)               # file was replaced or deleted
+
+def transcode(job):
+    try:
+        head = s3.head_object(Bucket=job["bucket"], Key=job["name"])
+    except ClientError as e:
+        if e.response["Error"]["Code"] in ("404", "NoSuchKey", "NotFound"):
+            return ("stale", 200)           # file was deleted
+        raise
+    if head.get("VersionId") != str(job["generation"]):
+        return ("stale", 200)               # file was replaced
     # ... run ffmpeg, write renditions ...
     return ("ok", 200)
+
+
+def handler(event, context):
+    # SQS event source mapping with ReportBatchItemFailures: a non-2xx result
+    # or exception leaves the message to be retried (then the DLQ).
+    failed = []
+    for record in event["Records"]:
+        try:
+            _, status = transcode(json.loads(record["body"]))
+            if not 200 <= status < 300:
+                raise RuntimeError(status)
+        except Exception:
+            failed.append({"itemIdentifier": record["messageId"]})
+    return {"batchItemFailures": failed}
diff --git a/sql/weekly_report.sql b/sql/weekly_report.sql
