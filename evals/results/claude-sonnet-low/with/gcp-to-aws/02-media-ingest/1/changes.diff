diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..7b9f0a5
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,272 @@
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = "~> 5.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region # us-central1 (Iowa) -> us-east-2 (Ohio), nearest equivalent
+}
+
+variable "region" {
+  type    = string
+  default = "us-east-2"
+}
+
+# Was var.project_id. Only used as a globally-unique S3 name prefix now.
+variable "name_prefix" { type = string }
+
+locals {
+  fn_src_bucket = "${var.name_prefix}-fn-src" # pre-existing bucket holding ingest.zip / transcode.zip
+}
+
+data "aws_caller_identity" "current" {}
+
+# ---------------------------------------------------------------- storage
+
+resource "aws_s3_bucket" "incoming" {
+  bucket = "${var.name_prefix}-media-incoming"
+}
+
+resource "aws_s3_bucket_ownership_controls" "incoming" { # uniform_bucket_level_access
+  bucket = aws_s3_bucket.incoming.id
+  rule { object_ownership = "BucketOwnerEnforced" }
+}
+
+resource "aws_s3_bucket_public_access_block" "incoming" {
+  bucket                  = aws_s3_bucket.incoming.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# GCS "generation" -> S3 versionId. Needed so a replaced file can be told from
+# the version that was queued.
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration { status = "Enabled" }
+}
+
+resource "aws_s3_bucket_lifecycle_configuration" "incoming" {
+  bucket     = aws_s3_bucket.incoming.id
+  depends_on = [aws_s3_bucket_versioning.incoming]
+  rule {
+    id     = "expire-noncurrent"
+    status = "Enabled"
+    filter {}
+    noncurrent_version_expiration { noncurrent_days = 7 }
+  }
+}
+
+# ---------------------------------------------------------------- identity
+
+# google_service_account.media -> one shared role, as before.
+resource "aws_iam_role" "media" {
+  name = "media-pipeline"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "lambda.amazonaws.com" }
+      Action    = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "media_logs" {
+  role       = aws_iam_role.media.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_iam_role_policy" "media" {
+  name = "media-pipeline"
+  role = aws_iam_role.media.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        # ListBucket so a missing/deleted key is a 404 (stale), not a 403.
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:GetObjectVersion"]
+        Resource = "${aws_s3_bucket.incoming.arn}/*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["s3:ListBucket"]
+        Resource = aws_s3_bucket.incoming.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["scheduler:CreateSchedule"]
+        Resource = "arn:aws:scheduler:${var.region}:${data.aws_caller_identity.current.account_id}:schedule/${aws_scheduler_schedule_group.transcode.name}/*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["iam:PassRole"]
+        Resource = aws_iam_role.scheduler.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["kinesis:PutRecord"]
+        Resource = aws_kinesis_stream.media_events.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
+        Resource = aws_sqs_queue.transcode.arn
+      },
+    ]
+  })
+}
+
+# ---------------------------------------------------------------- events
+
+# google_pubsub_topic.media_events (7-day retention) -> Kinesis stream, 168 h.
+resource "aws_kinesis_stream" "media_events" {
+  name             = "media-events"
+  retention_period = 168
+  stream_mode_details { stream_mode = "ON_DEMAND" }
+}
+
+# ---------------------------------------------------------------- transcode queue
+# google_cloud_tasks_queue.transcode -> EventBridge Scheduler (2 h hold) -> SQS -> Lambda
+
+resource "aws_sqs_queue" "transcode_dlq" {
+  name                      = "transcode-dlq"
+  message_retention_seconds = 1209600
+}
+
+resource "aws_sqs_queue" "transcode" {
+  name                       = "transcode"
+  visibility_timeout_seconds = 1800 # >= Lambda timeout (900)
+  message_retention_seconds  = 345600
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.transcode_dlq.arn
+    maxReceiveCount     = 4 # retry_config.max_attempts
+  })
+}
+
+resource "aws_scheduler_schedule_group" "transcode" {
+  name = "media-transcode"
+}
+
+resource "aws_iam_role" "scheduler" {
+  name = "media-transcode-scheduler"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "scheduler.amazonaws.com" }
+      Action    = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  name = "send-to-transcode-queue"
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["sqs:SendMessage"]
+      Resource = aws_sqs_queue.transcode.arn
+    }]
+  })
+}
+
+# ---------------------------------------------------------------- functions
+
+resource "aws_lambda_function" "ingest" {
+  function_name = "media-ingest"
+  runtime       = "python3.12"
+  handler       = "main.on_upload"
+  s3_bucket     = local.fn_src_bucket
+  s3_key        = "ingest.zip"
+  timeout       = 60
+  memory_size   = 256
+  role          = aws_iam_role.media.arn
+
+  environment {
+    variables = {
+      TRANSCODE_QUEUE_ARN = aws_sqs_queue.transcode.arn
+      SCHEDULE_GROUP      = aws_scheduler_schedule_group.transcode.name
+      SCHEDULER_ROLE_ARN  = aws_iam_role.scheduler.arn
+      EVENTS_STREAM       = aws_kinesis_stream.media_events.name
+    }
+  }
+}
+
+# RETRY_POLICY_DO_NOT_RETRY
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_lambda_permission" "ingest_s3" {
+  statement_id  = "AllowS3Invoke"
+  action        = "lambda:InvokeFunction"
+  function_name = aws_lambda_function.ingest.function_name
+  principal     = "s3.amazonaws.com"
+  source_arn    = aws_s3_bucket.incoming.arn
+}
+
+# object.finalized: new objects and overwrites.
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+  depends_on = [aws_lambda_permission.ingest_s3]
+}
+
+resource "aws_lambda_function" "transcode" {
+  function_name = "media-transcode"
+  runtime       = "python3.12"
+  handler       = "main.handler"
+  s3_bucket     = local.fn_src_bucket
+  s3_key        = "transcode.zip"
+  timeout       = 900 # Lambda maximum; was 1800 s on GCP. NEEDS DECISION.
+  memory_size   = 4096
+  role          = aws_iam_role.media.arn
+}
+
+resource "aws_lambda_event_source_mapping" "transcode" {
+  event_source_arn        = aws_sqs_queue.transcode.arn
+  function_name           = aws_lambda_function.transcode.arn
+  batch_size              = 1
+  function_response_types = ["ReportBatchItemFailures"]
+  scaling_config {
+    maximum_concurrency = 3 # max_concurrent_dispatches
+  }
+}
+
+# ---------------------------------------------------------------- analytics
+# google_bigquery_dataset.media -> Glue database + Athena workgroup
+
+resource "aws_glue_catalog_database" "media" {
+  name = "media"
+}
+
+resource "aws_s3_bucket" "athena_results" {
+  bucket = "${var.name_prefix}-media-athena-results"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena_results" {
+  bucket                  = aws_s3_bucket.athena_results.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_athena_workgroup" "media" {
+  name = "media"
+  configuration {
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena_results.bucket}/"
+    }
+  }
+}
