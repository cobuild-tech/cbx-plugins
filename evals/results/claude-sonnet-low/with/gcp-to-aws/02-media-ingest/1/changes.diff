--- a/sql/weekly_report.sql
+++ b/sql/weekly_report.sql
@@ -1,11 +1,14 @@
 -- Weekly editor report. Weeks run Sunday to Saturday, as the editors' schedule does.
+-- Athena (Trino). Assumes uploaded_at holds UTC instants, as BigQuery TIMESTAMP did.
 SELECT
-  DATE_TRUNC(DATE(uploaded_at), WEEK) AS week_start,
+  -- Trino weeks start Monday; shift back to Sunday (day_of_week: Mon=1 .. Sun=7)
+  date_add('day', -(day_of_week(CAST(uploaded_at AS DATE)) % 7), CAST(uploaded_at AS DATE)) AS week_start,
   uploader,
   COUNT(*) AS uploads,
-  SAFE_DIVIDE(SUM(transcode_seconds), COUNT(*)) AS avg_transcode_s,
-  COUNTIF(EXTRACT(DAYOFWEEK FROM uploaded_at) IN (1, 7)) AS weekend_uploads
+  CAST(SUM(transcode_seconds) AS DOUBLE) / NULLIF(COUNT(*), 0) AS avg_transcode_s,
+  -- BigQuery DAYOFWEEK IN (1, 7) = Sun, Sat  ->  Trino day_of_week IN (7, 6)
+  COUNT_IF(day_of_week(uploaded_at) IN (6, 7)) AS weekend_uploads
 FROM media.uploads
-WHERE uploaded_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 56 DAY)
-GROUP BY week_start, uploader
+WHERE uploaded_at >= current_timestamp - INTERVAL '56' DAY
+GROUP BY 1, 2
 ORDER BY week_start DESC, uploads DESC;
