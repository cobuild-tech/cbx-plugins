diff --git a/functions/transcode/main.py b/functions/transcode/main.py
index a41489d..154f84f 100644
--- a/functions/transcode/main.py
+++ b/functions/transcode/main.py
@@ -1,15 +1,63 @@
-import functions_framework
-from flask import Request
-from google.cloud import storage
+import json
+import os
+import signal
 
-gcs = storage.Client()
+import boto3
+from botocore.exceptions import ClientError
 
+s3 = boto3.client("s3")
+sqs = boto3.client("sqs")
 
-@functions_framework.http
-def transcode(request: Request):
-    job = request.get_json()
-    blob = gcs.bucket(job["bucket"]).get_blob(job["name"])
-    if blob is None or str(blob.generation) != str(job["generation"]):
-        return ("stale", 200)               # file was replaced or deleted
+QUEUE_URL = os.environ["QUEUE_URL"]
+running = True
+
+
+def transcode(job):
+    try:
+        head = s3.head_object(Bucket=job["bucket"], Key=job["name"])
+    except ClientError as e:
+        if e.response["Error"]["Code"] in ("404", "NoSuchKey", "NotFound"):
+            return "stale"                  # file was deleted
+        raise
+    if head.get("VersionId") != str(job["generation"]):
+        return "stale"                      # file was replaced
     # ... run ffmpeg, write renditions ...
-    return ("ok", 200)
+    return "ok"
+
+
+def backoff(receive_count):
+    # Cloud Tasks retry_config: min 30 s, max 600 s, 3 doublings.
+    return min(30 * 2 ** (receive_count - 1), 600)
+
+
+def main():
+    def stop(*_):
+        global running
+        running = False
+
+    signal.signal(signal.SIGTERM, stop)
+
+    while running:
+        resp = sqs.receive_message(
+            QueueUrl=QUEUE_URL,
+            MaxNumberOfMessages=1,
+            WaitTimeSeconds=20,
+            MessageSystemAttributeNames=["ApproximateReceiveCount"],
+        )
+        for msg in resp.get("Messages", []):
+            try:
+                transcode(json.loads(msg["Body"]))
+            except Exception:
+                count = int(msg["Attributes"]["ApproximateReceiveCount"])
+                sqs.change_message_visibility(
+                    QueueUrl=QUEUE_URL,
+                    ReceiptHandle=msg["ReceiptHandle"],
+                    VisibilityTimeout=backoff(count),
+                )
+                print(f"transcode failed (attempt {count})", flush=True)
+                continue
+            sqs.delete_message(QueueUrl=QUEUE_URL, ReceiptHandle=msg["ReceiptHandle"])
+
+
+if __name__ == "__main__":
+    main()
