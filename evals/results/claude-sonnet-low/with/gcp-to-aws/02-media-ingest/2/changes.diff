diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..63e6ea1
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,359 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = "~> 5.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.0" }
+  }
+}
+
+provider "aws" {
+  region = var.aws_region
+}
+
+variable "name_prefix" {
+  type        = string
+  description = "Replaces the GCP project_id in bucket names (S3 names are global)."
+}
+variable "aws_region" {
+  type    = string
+  default = "us-east-2" # nearest to us-central1
+}
+variable "vpc_id" { type = string }
+variable "subnet_ids" { type = list(string) }
+variable "assign_public_ip" {
+  type        = bool
+  default     = false
+  description = "Tasks need to reach ECR, SQS, S3 and CloudWatch: NAT, VPC endpoints, or true here."
+}
+variable "transcode_image_tag" {
+  type    = string
+  default = "latest"
+}
+
+data "aws_caller_identity" "current" {}
+
+locals {
+  account_id = data.aws_caller_identity.current.account_id
+}
+
+# ---------------------------------------------------------------- storage
+
+resource "aws_s3_bucket" "incoming" {
+  bucket = "${var.name_prefix}-media-incoming"
+}
+
+# Versioning gives each upload an id (versionId) to stand in for the GCS generation.
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration { status = "Enabled" }
+}
+
+resource "aws_s3_bucket_public_access_block" "incoming" {
+  bucket                  = aws_s3_bucket.incoming.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# ---------------------------------------------------------------- messaging
+
+# Pub/Sub topic media-events. SNS has no retention setting (was 7 days).
+resource "aws_sns_topic" "media_events" {
+  name = "media-events"
+}
+
+# Cloud Tasks queue "transcode": SQS holds the task, EventBridge Scheduler
+# delivers it after the 2 hour hold (SQS DelaySeconds tops out at 15 minutes).
+resource "aws_sqs_queue" "transcode_dlq" {
+  name                      = "transcode-dlq"
+  message_retention_seconds = 1209600
+}
+
+resource "aws_sqs_queue" "transcode" {
+  name                       = "transcode"
+  visibility_timeout_seconds = 1800 # was dispatch_deadline 1800s
+  message_retention_seconds  = 1209600
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.transcode_dlq.arn
+    maxReceiveCount     = 4 # was max_attempts = 4
+  })
+}
+
+# ---------------------------------------------------------------- IAM
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+    condition {
+      test     = "StringEquals"
+      variable = "aws:SourceAccount"
+      values   = [local.account_id]
+    }
+  }
+}
+
+data "aws_iam_policy_document" "ecs_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+# Role EventBridge Scheduler uses to drop the delayed message on the queue.
+resource "aws_iam_role" "scheduler" {
+  name               = "media-pipeline-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = "sqs:SendMessage"
+      Resource = aws_sqs_queue.transcode.arn
+    }]
+  })
+}
+
+# media-ingest
+resource "aws_iam_role" "ingest" {
+  name               = "media-pipeline-ingest"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "ingest_logs" {
+  role       = aws_iam_role.ingest.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_iam_role_policy" "ingest" {
+  role = aws_iam_role.ingest.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:GetObjectVersion"]
+        Resource = "${aws_s3_bucket.incoming.arn}/*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = "scheduler:CreateSchedule"
+        Resource = "arn:aws:scheduler:${var.aws_region}:${local.account_id}:schedule/default/*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = "iam:PassRole"
+        Resource = aws_iam_role.scheduler.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = "sns:Publish"
+        Resource = aws_sns_topic.media_events.arn
+      },
+    ]
+  })
+}
+
+# media-transcode
+resource "aws_iam_role" "transcode_execution" {
+  name               = "media-pipeline-transcode-exec"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "transcode_execution" {
+  role       = aws_iam_role.transcode_execution.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+resource "aws_iam_role" "transcode" {
+  name               = "media-pipeline-transcode"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+
+resource "aws_iam_role_policy" "transcode" {
+  role = aws_iam_role.transcode.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:GetObjectVersion"]
+        Resource = "${aws_s3_bucket.incoming.arn}/*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:ChangeMessageVisibility", "sqs:GetQueueAttributes"]
+        Resource = aws_sqs_queue.transcode.arn
+      },
+    ]
+  })
+}
+
+# ---------------------------------------------------------------- media-ingest
+
+data "archive_file" "ingest" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/ingest"
+  output_path = "${path.module}/build/ingest.zip"
+}
+
+resource "aws_lambda_function" "ingest" {
+  function_name    = "media-ingest"
+  runtime          = "python3.12"
+  handler          = "main.on_upload"
+  filename         = data.archive_file.ingest.output_path
+  source_code_hash = data.archive_file.ingest.output_base64sha256
+  role             = aws_iam_role.ingest.arn
+  timeout          = 60
+  memory_size      = 256
+
+  environment {
+    variables = {
+      TRANSCODE_QUEUE_ARN = aws_sqs_queue.transcode.arn
+      SCHEDULER_ROLE_ARN  = aws_iam_role.scheduler.arn
+      EVENTS_TOPIC        = aws_sns_topic.media_events.arn
+    }
+  }
+}
+
+# RETRY_POLICY_DO_NOT_RETRY
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_lambda_permission" "ingest_s3" {
+  statement_id   = "AllowS3Invoke"
+  action         = "lambda:InvokeFunction"
+  function_name  = aws_lambda_function.ingest.function_name
+  principal      = "s3.amazonaws.com"
+  source_arn     = aws_s3_bucket.incoming.arn
+  source_account = local.account_id
+}
+
+# Fires on every new object and on every overwrite of an existing name.
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+  depends_on = [aws_lambda_permission.ingest_s3]
+}
+
+# ---------------------------------------------------------------- media-transcode
+# 1800 s exceeds Lambda's 15 minute limit, so this runs as a Fargate worker
+# polling the transcode queue. desired_count = 3 matches max_concurrent_dispatches.
+
+resource "aws_ecr_repository" "transcode" {
+  name = "media-transcode"
+}
+
+resource "aws_cloudwatch_log_group" "transcode" {
+  name = "/ecs/media-transcode"
+}
+
+resource "aws_ecs_cluster" "media" {
+  name = "media-pipeline"
+}
+
+resource "aws_security_group" "transcode" {
+  name   = "media-transcode"
+  vpc_id = var.vpc_id
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_ecs_task_definition" "transcode" {
+  family                   = "media-transcode"
+  requires_compatibilities = ["FARGATE"]
+  network_mode             = "awsvpc"
+  cpu                      = 2048
+  memory                   = 4096 # was available_memory 4Gi
+  execution_role_arn       = aws_iam_role.transcode_execution.arn
+  task_role_arn            = aws_iam_role.transcode.arn
+
+  container_definitions = jsonencode([{
+    name      = "transcode"
+    image     = "${aws_ecr_repository.transcode.repository_url}:${var.transcode_image_tag}"
+    essential = true
+    environment = [
+      { name = "QUEUE_URL", value = aws_sqs_queue.transcode.url },
+    ]
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        awslogs-group         = aws_cloudwatch_log_group.transcode.name
+        awslogs-region        = var.aws_region
+        awslogs-stream-prefix = "transcode"
+      }
+    }
+  }])
+}
+
+resource "aws_ecs_service" "transcode" {
+  name            = "media-transcode"
+  cluster         = aws_ecs_cluster.media.id
+  task_definition = aws_ecs_task_definition.transcode.arn
+  desired_count   = 3
+  launch_type     = "FARGATE"
+
+  network_configuration {
+    subnets          = var.subnet_ids
+    security_groups  = [aws_security_group.transcode.id]
+    assign_public_ip = var.assign_public_ip
+  }
+}
+
+# ---------------------------------------------------------------- analytics
+# BigQuery dataset "media" -> Glue database queried by Athena. The
+# media.uploads table schema is not in the repo, so it is not defined here.
+
+resource "aws_s3_bucket" "athena_results" {
+  bucket = "${var.name_prefix}-media-athena-results"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena_results" {
+  bucket                  = aws_s3_bucket.athena_results.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_glue_catalog_database" "media" {
+  name = "media"
+}
+
+resource "aws_athena_workgroup" "media" {
+  name = "media"
+  configuration {
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena_results.bucket}/"
+    }
+  }
+}
