+-- Redshift port. analytics.orders: items is SUPER; created_at is TIMESTAMP(TZ) in UTC;
+-- ingest_date DATE replaces BigQuery's _PARTITIONDATE (must be added/populated on load).
+DROP TABLE IF EXISTS analytics.daily;
+
+CREATE TABLE analytics.daily AS
+WITH base AS (
+  SELECT TRUNC(o.created_at) AS "day",
+         o.customer_id,
+         o.session_id,
+         -- SAFE_CAST(amount AS NUMERIC): NULL instead of an error on bad input
+         CASE WHEN CAST(o.amount AS VARCHAR) ~ '^-?[0-9]+([.][0-9]+)?$'
+              THEN CAST(o.amount AS DECIMAL(38,9)) END AS amount,
+         i.sku::VARCHAR AS sku,
+         i.qty::BIGINT AS qty
+  FROM analytics.orders AS o, o.items AS i
+  WHERE o.ingest_date >= DATEADD(day, -1, CURRENT_DATE)
+),
+ranked AS (
+  SELECT base.*,
+         ROW_NUMBER() OVER (PARTITION BY "day", customer_id ORDER BY qty DESC NULLS LAST) AS rn
+  FROM base
+),
+agg AS (
+  SELECT "day",
+         customer_id,
+         SUM(amount) AS amount,
+         -- ARRAY_AGG(STRUCT(sku, qty) ORDER BY qty DESC LIMIT 3)
+         JSON_PARSE('[' || COALESCE(
+           LISTAGG(CASE WHEN rn <= 3 THEN JSON_SERIALIZE(OBJECT('sku', sku, 'qty', qty)) END, ',')
+             WITHIN GROUP (ORDER BY qty DESC NULLS LAST), '') || ']') AS top_items,
+         APPROXIMATE COUNT(DISTINCT session_id) AS sessions
+  FROM ranked
+  GROUP BY 1, 2
+)
+SELECT "day", customer_id, amount, top_items, sessions
+FROM agg
+QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC NULLS LAST) <= 100;
