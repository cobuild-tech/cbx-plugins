diff --git a/app/rollup.py b/app/rollup.py
new file mode 100644
index 0000000..a2d5692
--- /dev/null
+++ b/app/rollup.py
@@ -0,0 +1,19 @@
+import os, time, boto3
+
+def run_rollup():
+    sql = open("sql/rollup.sql").read()
+    statements = [s.strip() for s in sql.split(";") if s.strip()]
+    rs = boto3.client("redshift-data")
+    # One batch call runs all statements in a single transaction (replaces CREATE OR REPLACE).
+    stmt_id = rs.batch_execute_statement(
+        WorkgroupName=os.environ["REDSHIFT_WORKGROUP"],
+        Database=os.environ["REDSHIFT_DATABASE"],
+        Sqls=statements,
+    )["Id"]
+    while True:  # equivalent of .result(): block until done, raise on failure
+        d = rs.describe_statement(Id=stmt_id)
+        if d["Status"] == "FINISHED":
+            return
+        if d["Status"] in ("FAILED", "ABORTED"):
+            raise RuntimeError(f"rollup {d['Status']}: {d.get('Error')}")
+        time.sleep(2)
