diff --git a/app/worker.py b/app/worker.py
index 762334b..f5c999f 100644
--- a/app/worker.py
+++ b/app/worker.py
@@ -1,5 +1,21 @@
-import base64, json, functions_framework
-@functions_framework.cloud_event
-def handle(event):
-    order = json.loads(base64.b64decode(event.data["message"]["data"]))
-    print("processing", order["id"])
+import json
+
+
+def handle(event, context):
+    """SQS FIFO event source (SNS raw delivery): record["body"] is the order JSON."""
+    failed = []
+    failed_groups = set()
+    for record in event["Records"]:
+        group = record["attributes"].get("MessageGroupId")
+        # Keep per-customer order: once a message fails, don't process later ones in its group.
+        if group in failed_groups:
+            failed.append({"itemIdentifier": record["messageId"]})
+            continue
+        try:
+            order = json.loads(record["body"])
+            print("processing", order["id"])
+        except Exception:
+            print("failed", record["messageId"])
+            failed_groups.add(group)
+            failed.append({"itemIdentifier": record["messageId"]})
+    return {"batchItemFailures": failed}
diff --git a/aws/analytics.tf b/aws/analytics.tf
new file mode 100644
index 0000000..65aa333
--- /dev/null
+++ b/aws/analytics.tf
@@ -0,0 +1,112 @@
+# BigQuery dataset "analytics" -> Redshift Serverless (schema "analytics", see sql/setup.sql)
+resource "aws_security_group" "redshift" {
+  name   = "analytics-redshift"
+  vpc_id = var.vpc_id
+  # No ingress: the API reaches Redshift through the Data API, not the network.
+}
+
+resource "aws_redshiftserverless_namespace" "analytics" {
+  namespace_name        = "analytics"
+  db_name               = "analytics"
+  manage_admin_password = true
+}
+
+resource "aws_redshiftserverless_workgroup" "analytics" {
+  namespace_name      = aws_redshiftserverless_namespace.analytics.namespace_name
+  workgroup_name      = "analytics"
+  base_capacity       = 8 # minimum RPUs
+  publicly_accessible = false
+  subnet_ids          = var.private_subnet_ids
+  security_group_ids  = [aws_security_group.redshift.id]
+}
+
+resource "aws_redshiftserverless_usage_limit" "analytics" {
+  resource_arn = aws_redshiftserverless_workgroup.analytics.arn
+  usage_type   = "serverless-compute"
+  amount       = var.redshift_max_rpu_hours_per_month
+  period       = "monthly"
+  breach_action = "log"
+}
+
+# Cloud Scheduler "nightly-rollup" -> EventBridge Scheduler -> Lambda -> POST /jobs/rollup
+data "archive_file" "rollup_trigger" {
+  type        = "zip"
+  source_file = "${path.module}/lambda/rollup_trigger.py"
+  output_path = "${path.module}/build/rollup_trigger.zip"
+}
+
+resource "aws_iam_role" "rollup_trigger" {
+  name = "nightly-rollup-trigger"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "lambda.amazonaws.com" }
+      Action    = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "rollup_trigger_logs" {
+  role       = aws_iam_role.rollup_trigger.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_lambda_function" "rollup_trigger" {
+  function_name    = "nightly-rollup-trigger"
+  runtime          = "python3.12"
+  handler          = "rollup_trigger.handler"
+  role             = aws_iam_role.rollup_trigger.arn
+  timeout          = 180 # Cloud Scheduler's default attempt deadline
+  filename         = data.archive_file.rollup_trigger.output_path
+  source_code_hash = data.archive_file.rollup_trigger.output_base64sha256
+
+  environment {
+    variables = { URL = "https://${var.api_domain_name}/jobs/rollup" }
+  }
+}
+
+# Cloud Scheduler job did not retry; keep async invokes from retrying too.
+resource "aws_lambda_function_event_invoke_config" "rollup_trigger" {
+  function_name          = aws_lambda_function.rollup_trigger.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_iam_role" "scheduler" {
+  name = "nightly-rollup-scheduler"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "scheduler.amazonaws.com" }
+      Action    = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = "lambda:InvokeFunction"
+      Resource = aws_lambda_function.rollup_trigger.arn
+    }]
+  })
+}
+
+resource "aws_scheduler_schedule" "nightly" {
+  name                         = "nightly-rollup"
+  schedule_expression          = "cron(0 2 * * ? *)"
+  schedule_expression_timezone = "America/New_York"
+
+  flexible_time_window { mode = "OFF" }
+
+  target {
+    arn      = aws_lambda_function.rollup_trigger.arn
+    role_arn = aws_iam_role.scheduler.arn
+
+    retry_policy { maximum_retry_attempts = 0 } # default would retry for 24 h
+  }
+}
diff --git a/aws/api.tf b/aws/api.tf
new file mode 100644
index 0000000..e7f6c52
--- /dev/null
+++ b/aws/api.tf
@@ -0,0 +1,222 @@
+# Cloud Run service "api" -> ECS Fargate behind an ALB (ALB idle timeout replaces the 900 s request timeout)
+resource "aws_ecr_repository" "api" {
+  name = "api" # was us-docker.pkg.dev/<project>/app/api
+}
+
+resource "aws_cloudwatch_log_group" "api" {
+  name = "/ecs/api"
+}
+
+# Service account api-sa -> task role
+resource "aws_iam_role" "api_task" {
+  name = "api-task"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "ecs-tasks.amazonaws.com" }
+      Action    = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "api_task" {
+  role = aws_iam_role.api_task.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      { # roles/storage.objectAdmin on the uploads bucket
+        Effect = "Allow"
+        Action = [
+          "s3:GetObject", "s3:GetObjectVersion", "s3:PutObject",
+          "s3:DeleteObject", "s3:DeleteObjectVersion",
+          "s3:AbortMultipartUpload", "s3:ListMultipartUploadParts",
+        ]
+        Resource = "${aws_s3_bucket.uploads.arn}/*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["s3:ListBucket", "s3:ListBucketVersions", "s3:ListBucketMultipartUploads"]
+        Resource = aws_s3_bucket.uploads.arn
+      },
+      { # app publishes orders
+        Effect   = "Allow"
+        Action   = "sns:Publish"
+        Resource = aws_sns_topic.orders.arn
+      },
+      { # app runs the rollup
+        Effect   = "Allow"
+        Action   = ["redshift-data:BatchExecuteStatement", "redshift-data:DescribeStatement"]
+        Resource = "*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = "redshift-serverless:GetCredentials"
+        Resource = aws_redshiftserverless_workgroup.analytics.arn
+      },
+    ]
+  })
+}
+
+resource "aws_iam_role" "api_execution" {
+  name = "api-execution"
+  assume_role_policy = aws_iam_role.api_task.assume_role_policy
+}
+
+resource "aws_iam_role_policy_attachment" "api_execution" {
+  role       = aws_iam_role.api_execution.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+resource "aws_security_group" "alb" {
+  name   = "api-alb"
+  vpc_id = var.vpc_id
+
+  ingress {
+    from_port   = 443
+    to_port     = 443
+    protocol    = "tcp"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_security_group" "api" {
+  name   = "api"
+  vpc_id = var.vpc_id
+
+  ingress {
+    from_port       = local.container_port
+    to_port         = local.container_port
+    protocol        = "tcp"
+    security_groups = [aws_security_group.alb.id]
+  }
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_lb" "api" {
+  name               = "api"
+  load_balancer_type = "application"
+  subnets            = var.public_subnet_ids
+  security_groups    = [aws_security_group.alb.id]
+  idle_timeout       = 900 # timeout = "900s"
+}
+
+resource "aws_lb_target_group" "api" {
+  name        = "api"
+  port        = local.container_port
+  protocol    = "HTTP"
+  target_type = "ip"
+  vpc_id      = var.vpc_id
+
+  health_check {
+    path    = "/"
+    matcher = "200-404" # app has no health route; any HTTP answer means alive
+  }
+}
+
+resource "aws_lb_listener" "https" {
+  load_balancer_arn = aws_lb.api.arn
+  port              = 443
+  protocol          = "HTTPS"
+  certificate_arn   = var.certificate_arn
+
+  default_action {
+    type             = "forward"
+    target_group_arn = aws_lb_target_group.api.arn
+  }
+}
+
+resource "aws_ecs_cluster" "main" {
+  name = "app"
+}
+
+resource "aws_ecs_task_definition" "api" {
+  family                   = "api"
+  requires_compatibilities = ["FARGATE"]
+  network_mode             = "awsvpc"
+  cpu                      = 2048 # 2 vCPU
+  memory                   = 4096 # Fargate minimum for 2 vCPU (was 1Gi)
+  task_role_arn            = aws_iam_role.api_task.arn
+  execution_role_arn       = aws_iam_role.api_execution.arn
+
+  container_definitions = jsonencode([{
+    name         = "api"
+    image        = "${aws_ecr_repository.api.repository_url}:latest"
+    essential    = true
+    portMappings = [{ containerPort = local.container_port }]
+    environment = [
+      { name = "BUCKET", value = aws_s3_bucket.uploads.bucket },
+      { name = "ORDERS_TOPIC_ARN", value = aws_sns_topic.orders.arn },
+      { name = "REDSHIFT_WORKGROUP", value = aws_redshiftserverless_workgroup.analytics.workgroup_name },
+      { name = "REDSHIFT_DATABASE", value = aws_redshiftserverless_namespace.analytics.db_name },
+      { name = "DB_HOST", value = aws_db_instance.db.address }, # replaces the Cloud SQL socket volume
+      { name = "DB_PORT", value = "5432" },
+    ]
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        awslogs-group         = aws_cloudwatch_log_group.api.name
+        awslogs-region        = data.aws_region.current.name
+        awslogs-stream-prefix = "api"
+      }
+    }
+  }])
+}
+
+resource "aws_ecs_service" "api" {
+  name            = "api"
+  cluster         = aws_ecs_cluster.main.id
+  task_definition = aws_ecs_task_definition.api.arn
+  launch_type     = "FARGATE"
+  desired_count   = 1 # min_instance_count
+
+  network_configuration {
+    subnets         = var.private_subnet_ids
+    security_groups = [aws_security_group.api.id]
+  }
+
+  load_balancer {
+    target_group_arn = aws_lb_target_group.api.arn
+    container_name   = "api"
+    container_port   = local.container_port
+  }
+
+  lifecycle { ignore_changes = [desired_count] } # autoscaling owns it
+
+  depends_on = [aws_lb_listener.https]
+}
+
+resource "aws_appautoscaling_target" "api" {
+  service_namespace  = "ecs"
+  scalable_dimension = "ecs:service:DesiredCount"
+  resource_id        = "service/${aws_ecs_cluster.main.name}/${aws_ecs_service.api.name}"
+  min_capacity       = 1
+  max_capacity       = 20
+}
+
+# Cloud Run scaled on 80 concurrent requests per instance; ECS has no such metric.
+resource "aws_appautoscaling_policy" "api_cpu" {
+  name               = "api-cpu"
+  policy_type        = "TargetTrackingScaling"
+  service_namespace  = aws_appautoscaling_target.api.service_namespace
+  scalable_dimension = aws_appautoscaling_target.api.scalable_dimension
+  resource_id        = aws_appautoscaling_target.api.resource_id
+
+  target_tracking_scaling_policy_configuration {
+    target_value = 60
+    predefined_metric_specification {
+      predefined_metric_type = "ECSServiceAverageCPUUtilization"
+    }
+  }
+}
diff --git a/aws/database.tf b/aws/database.tf
new file mode 100644
index 0000000..f8396a3
--- /dev/null
+++ b/aws/database.tf
@@ -0,0 +1,40 @@
+resource "aws_db_subnet_group" "db" {
+  name       = "app-db"
+  subnet_ids = var.private_subnet_ids
+}
+
+resource "aws_security_group" "db" {
+  name   = "app-db"
+  vpc_id = var.vpc_id
+
+  ingress {
+    from_port       = 5432
+    to_port         = 5432
+    protocol        = "tcp"
+    security_groups = [aws_security_group.api.id]
+  }
+}
+
+resource "aws_db_instance" "db" {
+  identifier     = "app-db"
+  engine         = "postgres"
+  engine_version = "15"
+  instance_class = "db.m6g.large" # 2 vCPU / 8 GiB, nearest to db-custom-2-7680
+
+  allocated_storage = 20
+  storage_type      = "gp3"
+  storage_encrypted = true
+
+  multi_az                            = true # availability_type = REGIONAL
+  iam_database_authentication_enabled = true # cloudsql.iam_authentication
+  backup_retention_period             = 7    # enables point-in-time recovery
+
+  manage_master_user_password = true # password in Secrets Manager, never in state/code
+  username                    = "postgres"
+
+  db_subnet_group_name   = aws_db_subnet_group.db.name
+  vpc_security_group_ids = [aws_security_group.db.id]
+  publicly_accessible    = false
+
+  final_snapshot_identifier = "app-db-final"
+}
diff --git a/aws/lambda/rollup_trigger.py b/aws/lambda/rollup_trigger.py
new file mode 100644
index 0000000..3d28a22
--- /dev/null
+++ b/aws/lambda/rollup_trigger.py
@@ -0,0 +1,10 @@
+import os
+import urllib.request
+
+
+def handler(event, context):
+    """POST to the API's /jobs/rollup (what the Cloud Scheduler HTTP target did).
+    Non-2xx raises HTTPError, so the invocation fails visibly."""
+    req = urllib.request.Request(os.environ["URL"], data=b"", method="POST")
+    with urllib.request.urlopen(req, timeout=170) as resp:
+        print("rollup status", resp.status)
diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..e7a5387
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,48 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = ">= 5.80, < 7.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.4" }
+  }
+}
+
+provider "aws" {
+  region = var.region # was us-central1
+}
+
+data "aws_region" "current" {}
+
+variable "project" {
+  type        = string
+  description = "Name prefix. Bucket is ${"$"}{project}-uploads; S3 names are global, so this may need to change."
+}
+
+variable "region" {
+  type    = string
+  default = "us-east-2" # closest to us-central1
+}
+
+# Base network is a separate unit; these are its outputs.
+variable "vpc_id" { type = string }
+variable "public_subnet_ids" { type = list(string) }
+# Private subnets need egress to ECR/CloudWatch/SNS/Redshift Data API (NAT or VPC endpoints).
+# Redshift Serverless needs subnets in at least 3 AZs.
+variable "private_subnet_ids" { type = list(string) }
+
+variable "certificate_arn" {
+  type        = string
+  description = "ACM certificate for the API ALB HTTPS listener"
+}
+
+variable "api_domain_name" {
+  type        = string
+  description = "DNS name (covered by the certificate) that points at the ALB; used by the nightly trigger"
+}
+
+variable "redshift_max_rpu_hours_per_month" {
+  type    = number
+  default = 500
+}
+
+locals {
+  container_port = 8080 # Cloud Run's default $PORT
+}
diff --git a/aws/messaging.tf b/aws/messaging.tf
new file mode 100644
index 0000000..4a60d62
--- /dev/null
+++ b/aws/messaging.tf
@@ -0,0 +1,102 @@
+# Pub/Sub topic "orders" with message ordering -> SNS FIFO + SQS FIFO
+# (MessageGroupId = the old ordering key, customer_id).
+resource "aws_sns_topic" "orders" {
+  name                        = "orders.fifo"
+  fifo_topic                  = true
+  content_based_deduplication = false # publisher sends a unique dedup id (Pub/Sub has no dedup)
+}
+
+resource "aws_sqs_queue" "orders_dlq" {
+  name                      = "orders-dlq.fifo"
+  fifo_queue                = true
+  message_retention_seconds = 1209600 # 14 days (max)
+}
+
+resource "aws_sqs_queue" "orders_worker" {
+  name       = "orders-worker.fifo"
+  fifo_queue = true
+
+  # >= consumer timeout; 6 x Lambda timeout (540 s) per AWS guidance. Was ack_deadline 60 s.
+  visibility_timeout_seconds = 3240
+  message_retention_seconds  = 604800 # 7 days, Pub/Sub default
+
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.orders_dlq.arn
+    maxReceiveCount     = 5 # max_delivery_attempts
+  })
+}
+
+resource "aws_sqs_queue_policy" "orders_worker" {
+  queue_url = aws_sqs_queue.orders_worker.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "sns.amazonaws.com" }
+      Action    = "sqs:SendMessage"
+      Resource  = aws_sqs_queue.orders_worker.arn
+      Condition = { ArnEquals = { "aws:SourceArn" = aws_sns_topic.orders.arn } }
+    }]
+  })
+}
+
+resource "aws_sns_topic_subscription" "orders_worker" {
+  topic_arn            = aws_sns_topic.orders.arn
+  protocol             = "sqs"
+  endpoint             = aws_sqs_queue.orders_worker.arn
+  raw_message_delivery = true # handler gets the original JSON body, not the SNS envelope
+}
+
+# Cloud Function "orders-worker" -> Lambda
+data "archive_file" "worker" {
+  type        = "zip"
+  source_file = "${path.module}/../app/worker.py"
+  output_path = "${path.module}/build/worker.zip"
+}
+
+resource "aws_iam_role" "worker" {
+  name = "orders-worker"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "lambda.amazonaws.com" }
+      Action    = "sts:AssumeRole"
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "worker_logs" {
+  role       = aws_iam_role.worker.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_iam_role_policy" "worker_sqs" {
+  role = aws_iam_role.worker.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
+      Resource = aws_sqs_queue.orders_worker.arn
+    }]
+  })
+}
+
+resource "aws_lambda_function" "worker" {
+  function_name    = "orders-worker"
+  runtime          = "python3.12"
+  handler          = "worker.handle"
+  role             = aws_iam_role.worker.arn
+  timeout          = 540
+  memory_size      = 512
+  filename         = data.archive_file.worker.output_path
+  source_code_hash = data.archive_file.worker.output_base64sha256
+}
+
+resource "aws_lambda_event_source_mapping" "worker" {
+  event_source_arn        = aws_sqs_queue.orders_worker.arn
+  function_name           = aws_lambda_function.worker.arn
+  batch_size              = 1 # one message per invocation, like the Cloud Function
+  function_response_types = ["ReportBatchItemFailures"]
+}
diff --git a/aws/storage.tf b/aws/storage.tf
