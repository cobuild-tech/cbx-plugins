@@ -0,0 +1,45 @@
+resource "aws_s3_bucket" "uploads" {
+  bucket = "${var.project}-uploads"
+}
+
+# uniform_bucket_level_access -> ACLs disabled + no public access
+resource "aws_s3_bucket_ownership_controls" "uploads" {
+  bucket = aws_s3_bucket.uploads.id
+  rule { object_ownership = "BucketOwnerEnforced" }
+}
+
+resource "aws_s3_bucket_public_access_block" "uploads" {
+  bucket                  = aws_s3_bucket.uploads.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_versioning" "uploads" {
+  bucket = aws_s3_bucket.uploads.id
+  versioning_configuration { status = "Enabled" }
+}
+
+resource "aws_s3_bucket_lifecycle_configuration" "uploads" {
+  bucket     = aws_s3_bucket.uploads.id
+  depends_on = [aws_s3_bucket_versioning.uploads]
+
+  rule {
+    id     = "nearline-after-30-delete-after-365"
+    status = "Enabled"
+    filter {}
+
+    transition {
+      days          = 30
+      storage_class = "STANDARD_IA" # was NEARLINE
+    }
+    noncurrent_version_transition {
+      noncurrent_days = 30
+      storage_class   = "STANDARD_IA"
+    }
+
+    expiration { days = 365 }
+    noncurrent_version_expiration { noncurrent_days = 365 }
+  }
+}
diff --git a/sql/rollup.sql b/sql/rollup.sql
index b79db8d..03b8db8 100644
--- a/sql/rollup.sql
+++ b/sql/rollup.sql
@@ -1,10 +1,36 @@
-CREATE OR REPLACE TABLE analytics.daily AS
-SELECT DATE(TIMESTAMP_TRUNC(created_at, DAY)) AS day,
-       customer_id,
-       SUM(SAFE_CAST(amount AS NUMERIC)) AS amount,
-       ARRAY_AGG(STRUCT(sku, qty) ORDER BY qty DESC LIMIT 3) AS top_items,
-       APPROX_COUNT_DISTINCT(session_id) AS sessions
-FROM `analytics.orders`, UNNEST(items)
-WHERE _PARTITIONDATE >= DATE_SUB(CURRENT_DATE(), INTERVAL 1 DAY)
-GROUP BY 1, 2
-QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) <= 100;
+-- Redshift port. Assumes analytics.orders has: created_at TIMESTAMP (UTC), amount (string or numeric),
+-- items SUPER (array of {sku, qty}), and partition_date DATE (load date in UTC, replaces _PARTITIONDATE).
+-- No semicolons inside comments or strings: the app splits this file on them.
+DROP TABLE IF EXISTS analytics.daily;
+
+CREATE TABLE analytics.daily AS
+WITH item_rows AS (
+  SELECT o.created_at::DATE AS day,
+         o.customer_id,
+         o.session_id,
+         CASE WHEN o.amount::VARCHAR ~ '^-?[0-9]+([.][0-9]+)?$'
+              THEN o.amount::VARCHAR::DECIMAL(38,9) END AS amount_num,
+         i.sku::VARCHAR AS sku,
+         i.qty::BIGINT AS qty
+  FROM analytics.orders AS o, o.items AS i
+  WHERE o.partition_date >= CURRENT_DATE - 1
+),
+ranked AS (
+  SELECT *,
+         ROW_NUMBER() OVER (PARTITION BY day, customer_id ORDER BY qty DESC NULLS LAST) AS rn
+  FROM item_rows
+),
+agg AS (
+  SELECT day,
+         customer_id,
+         SUM(amount_num) AS total_amount,
+         JSON_PARSE('[' || LISTAGG(CASE WHEN rn <= 3
+                                        THEN JSON_SERIALIZE(OBJECT('sku', sku, 'qty', qty)) END, ',')
+                           WITHIN GROUP (ORDER BY qty DESC NULLS LAST) || ']') AS top_items,
+         APPROXIMATE COUNT(DISTINCT session_id) AS sessions
+  FROM ranked
+  GROUP BY day, customer_id
+)
+SELECT day, customer_id, total_amount AS amount, top_items, sessions
+FROM agg
+QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY total_amount DESC NULLS LAST) <= 100;
