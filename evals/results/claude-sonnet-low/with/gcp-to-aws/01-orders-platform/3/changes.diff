+-- Athena (Trino) / Iceberg. Assumes analytics.orders has a `partition_date` DATE column
+-- (replaces BigQuery's _PARTITIONDATE) and items = array(row(sku varchar, qty bigint)).
+-- ${DAILY_LOCATION} is substituted by app/api.py.
+CREATE TABLE analytics.daily
+WITH (table_type = 'ICEBERG', format = 'PARQUET', is_external = false,
+      location = '${DAILY_LOCATION}') AS
+WITH agg AS (
+    SELECT CAST(created_at AS DATE) AS day,
+           customer_id,
+           SUM(TRY_CAST(amount AS DECIMAL(38, 9))) AS amount,
+           slice(array_agg(CAST(ROW(sku, qty) AS ROW(sku VARCHAR, qty BIGINT)) ORDER BY qty DESC), 1, 3) AS top_items,
+           approx_distinct(session_id) AS sessions
+    FROM analytics.orders
+    CROSS JOIN UNNEST(items) AS t(sku, qty)
+    WHERE partition_date >= date_add('day', -1, current_date)
+    GROUP BY 1, 2
+)
+SELECT day, customer_id, amount, top_items, sessions
+FROM (
+    SELECT agg.*,
+           ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rn
+    FROM agg
+)
+WHERE rn <= 100
