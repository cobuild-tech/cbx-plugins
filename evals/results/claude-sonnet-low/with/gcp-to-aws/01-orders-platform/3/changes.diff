-    print("processing", order["id"])
+import json
+import traceback
+
+
+# Lambda handler for the SQS FIFO queue (raw SNS delivery: body is the order JSON).
+def handle(event, context):
+    failures, failed_groups = [], set()
+    for record in event["Records"]:
+        group = record["attributes"]["MessageGroupId"]
+        # FIFO: once a message fails, everything after it in its group must retry too.
+        if group in failed_groups:
+            failures.append({"itemIdentifier": record["messageId"]})
+            continue
+        try:
+            order = json.loads(record["body"])
+            print("processing", order["id"])
+        except Exception:
+            traceback.print_exc()
+            failed_groups.add(group)
+            failures.append({"itemIdentifier": record["messageId"]})
+    return {"batchItemFailures": failures}
