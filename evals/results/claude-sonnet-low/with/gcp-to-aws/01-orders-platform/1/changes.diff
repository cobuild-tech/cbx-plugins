+DROP TABLE IF EXISTS analytics.daily;
+CREATE TABLE analytics.daily AS
+WITH items AS (
+  SELECT (o.created_at AT TIME ZONE 'UTC')::DATE AS day,
+         o.customer_id,
+         o.session_id,
+         CASE WHEN o.amount::VARCHAR ~ '^[+-]?([0-9]+[.]?[0-9]*|[.][0-9]+)$'
+              THEN o.amount::VARCHAR::DECIMAL(38,9) END AS amount,
+         item.sku::VARCHAR AS sku,
+         item.qty::BIGINT AS qty
+  FROM analytics.orders AS o, o.items AS item
+  WHERE o.partition_date >= CURRENT_DATE - 1
+),
+ranked AS (
+  SELECT *, ROW_NUMBER() OVER (PARTITION BY day, customer_id ORDER BY qty DESC NULLS LAST) AS rn
+  FROM items
+),
+agg AS (
+  SELECT day,
+         customer_id,
+         SUM(amount) AS amount,
+         JSON_PARSE('[' || LISTAGG(CASE WHEN rn <= 3 THEN JSON_SERIALIZE(OBJECT('sku', sku, 'qty', qty)) END, ',')
+                           WITHIN GROUP (ORDER BY qty DESC NULLS LAST) || ']') AS top_items,
+         APPROXIMATE COUNT(DISTINCT session_id) AS sessions
+  FROM ranked
+  GROUP BY 1, 2
+)
+SELECT day, customer_id, amount, top_items, sessions
+FROM agg
+QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC NULLS LAST) <= 100;
