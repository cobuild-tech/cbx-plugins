+# ElastiCache listens on 6379 (Memorystore server-auth used 6378).
+r = redis.Redis(
+    host=os.environ["REDIS_HOST"],
+    port=int(os.environ.get("REDIS_PORT", 6379)),
+    ssl=True,
+    password=os.environ.get("REDIS_AUTH"),
+)
+athena = boto3.client("athena")
+s3 = boto3.client("s3")
+
+WORKGROUP = os.environ["ATHENA_WORKGROUP"]
+DATABASE = os.environ.get("GLUE_DATABASE", "billing")
+BERLIN = ZoneInfo("Europe/Berlin")
+
+MERGE_ATTEMPTS = 8
+
+
+class QueryFailed(Exception):
+    pass
+
+
+def run_query(sql):
+    qid = athena.start_query_execution(
+        QueryString=sql,
+        QueryExecutionContext={"Database": DATABASE},
+        WorkGroup=WORKGROUP,
+    )["QueryExecutionId"]
+    while True:
+        status = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+        if status["State"] in ("SUCCEEDED", "FAILED", "CANCELLED"):
+            break
+        time.sleep(2)
+    if status["State"] != "SUCCEEDED":
+        raise QueryFailed(status.get("StateChangeReason", status["State"]))
+    return qid
+
+
+def run_merge(sql):
+    # All tasks run the same MERGE. BigQuery serialised concurrent DML; Iceberg commits are
+    # optimistic and lose races, so retry. The MERGE is idempotent, so retrying is safe.
+    for attempt in range(MERGE_ATTEMPTS):
+        try:
+            return run_query(sql)
+        except QueryFailed as e:
+            if "ICEBERG_COMMIT_ERROR" not in str(e) or attempt == MERGE_ATTEMPTS - 1:
+                raise
+            time.sleep(random.uniform(1, 5) * (attempt + 1))
+
+
+def convert(type_, value):
+    if value is None:
+        return None
+    if type_ in ("bigint", "integer", "smallint", "tinyint"):
+        return int(value)
+    if type_ in ("double", "float", "real"):
+        return float(value)
+    return value
+
+
+def result_rows(qid):
+    cols = None
+    for page in athena.get_paginator("get_query_results").paginate(QueryExecutionId=qid):
+        rows = page["ResultSet"]["Rows"]
+        if cols is None:
+            cols = [(c["Name"], c["Type"]) for c in page["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]]
+            rows = rows[1:]  # first row of the first page is the header
+        for row in rows:
+            yield {
+                name: convert(type_, datum.get("VarCharValue"))
+                for (name, type_), datum in zip(cols, row["Data"])
+            }
 
 
 def main():
