+import boto3
 import redis
 import requests
-from google.cloud import bigquery, storage
 
-TASK_INDEX = int(os.environ.get("CLOUD_RUN_TASK_INDEX", 0))
-TASK_COUNT = int(os.environ.get("CLOUD_RUN_TASK_COUNT", 1))
-ATTEMPT = int(os.environ.get("CLOUD_RUN_TASK_ATTEMPT", 0))
+# AWS Batch array child jobs. The index is 0-based like Cloud Run's; the attempt is 1-based.
+TASK_INDEX = int(os.environ.get("AWS_BATCH_JOB_ARRAY_INDEX", 0))
+TASK_COUNT = int(os.environ.get("TASK_COUNT", 1))
+ATTEMPT = int(os.environ.get("AWS_BATCH_JOB_ATTEMPT", 1)) - 1
 
