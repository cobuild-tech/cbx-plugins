+INT_TYPES = {"tinyint", "smallint", "integer", "bigint"}
+FLOAT_TYPES = {"real", "float", "double", "decimal"}
+
+
+def run_query(sql, retries=5):
+    """Run one Athena statement and return its rows as dicts (empty for MERGE)."""
+    for attempt in range(retries):
+        qid = athena.start_query_execution(
+            QueryString=sql,
+            WorkGroup=os.environ["ATHENA_WORKGROUP"],
+            QueryExecutionContext={"Database": os.environ["ATHENA_DATABASE"]},
+        )["QueryExecutionId"]
+        delay = 1
+        while True:
+            status = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+            if status["State"] in ("SUCCEEDED", "FAILED", "CANCELLED"):
+                break
+            time.sleep(delay)
+            delay = min(delay * 2, 10)
+        if status["State"] == "SUCCEEDED":
+            break
+        reason = status.get("StateChangeReason", "")
+        # 4 tasks run the same idempotent MERGE at once; Iceberg commits can collide, so try again.
+        if "ICEBERG_COMMIT_ERROR" in reason and attempt < retries - 1:
+            time.sleep(2 ** attempt + attempt)
+            continue
+        raise RuntimeError(f"Athena query {qid} {status['State']}: {reason}")
+
+    if not sql.lstrip().upper().startswith("SELECT"):
+        return
+    first = True
+    for page in athena.get_paginator("get_query_results").paginate(QueryExecutionId=qid):
+        cols = page["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]
+        for raw in page["ResultSet"]["Rows"]:
+            if first:  # Athena returns the header as the first row
+                first = False
+                continue
+            yield {c["Name"]: convert(d.get("VarCharValue"), c["Type"]) for c, d in zip(cols, raw["Data"])}
+
+
+def convert(value, type_name):
+    # Athena returns every value as a string; restore the types BigQuery gave us.
+    if value is None:
+        return None
+    if type_name in INT_TYPES:
+        return int(value)
+    if type_name in FLOAT_TYPES:
+        return float(value)
+    return value
 
 
