diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..817caf9
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,412 @@
+terraform {
+  required_providers {
+    aws    = { source = "hashicorp/aws", version = "~> 6.0" }
+    random = { source = "hashicorp/random", version = "~> 3.6" }
+  }
+}
+
+# europe-west1 (Belgium) has no AWS twin; eu-west-1 is the nearest EU region. Change if data residency says otherwise.
+variable "region" {
+  type    = string
+  default = "eu-west-1"
+}
+
+provider "aws" {
+  region = var.region
+}
+
+# Kept only as the naming prefix (S3 bucket names are global).
+variable "project_id" { type = string }
+
+# Replaces the GCP "default" network + VPC access connector. Use private subnets with a NAT route
+# (the job calls partner.example.com, Athena and Glue) and an S3 gateway endpoint.
+variable "vpc_id" { type = string }
+variable "subnet_ids" { type = list(string) }
+
+data "aws_caller_identity" "current" {}
+
+locals {
+  account_id  = data.aws_caller_identity.current.account_id
+  task_count  = 16
+  parallelism = 4
+  vcpu        = 2
+  glue_db     = "billing"
+}
+
+# ---------------------------------------------------------------------------
+# Identity: one role for the job itself (was the billing-export service account),
+# one execution role that Batch uses to pull the image and inject secrets,
+# one role for the scheduler (was the same SA, used as the OAuth caller).
+# ---------------------------------------------------------------------------
+data "aws_iam_policy_document" "ecs_tasks_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "export" {
+  name               = "billing-export"
+  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_assume.json
+}
+
+resource "aws_iam_role" "export_execution" {
+  name               = "billing-export-execution"
+  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "export_execution" {
+  role       = aws_iam_role.export_execution.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+# ---------------------------------------------------------------------------
+# Secrets
+# ---------------------------------------------------------------------------
+resource "aws_secretsmanager_secret" "partner_api_key" {
+  name = "partner-api-key"
+}
+
+# Same as GCP: the secret is created empty and the value is set out of band.
+
+# Memorystore generated its own AUTH string; ElastiCache needs one supplied.
+resource "random_password" "redis_auth" {
+  length  = 48
+  special = false
+}
+
+resource "aws_secretsmanager_secret" "redis_auth" {
+  name = "export-dedupe-auth"
+}
+
+resource "aws_secretsmanager_secret_version" "redis_auth" {
+  secret_id     = aws_secretsmanager_secret.redis_auth.id
+  secret_string = random_password.redis_auth.result
+}
+
+# Was google_secret_manager_secret_iam_member.export_reads_key. Batch reads the secret
+# with the execution role when it starts the container.
+data "aws_iam_policy_document" "export_execution_secrets" {
+  statement {
+    actions = ["secretsmanager:GetSecretValue"]
+    resources = [
+      aws_secretsmanager_secret.partner_api_key.arn,
+      aws_secretsmanager_secret.redis_auth.arn,
+    ]
+  }
+}
+
+resource "aws_iam_role_policy" "export_execution_secrets" {
+  name   = "reads-secrets"
+  role   = aws_iam_role.export_execution.id
+  policy = data.aws_iam_policy_document.export_execution_secrets.json
+}
+
+# ---------------------------------------------------------------------------
+# Network
+# ---------------------------------------------------------------------------
+resource "aws_security_group" "job" {
+  name        = "billing-export-job"
+  description = "billing-export Batch tasks"
+  vpc_id      = var.vpc_id
+
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_security_group" "redis" {
+  name        = "export-dedupe"
+  description = "export-dedupe Redis"
+  vpc_id      = var.vpc_id
+
+  ingress {
+    from_port       = 6378
+    to_port         = 6378
+    protocol        = "tcp"
+    security_groups = [aws_security_group.job.id]
+  }
+}
+
+# ---------------------------------------------------------------------------
+# Dedupe cache (Memorystore STANDARD_HA, 1 GB, Redis 7.0, AUTH + TLS)
+# ---------------------------------------------------------------------------
+resource "aws_elasticache_subnet_group" "dedupe" {
+  name       = "export-dedupe"
+  subnet_ids = var.subnet_ids
+}
+
+resource "aws_elasticache_replication_group" "dedupe" {
+  replication_group_id = "export-dedupe"
+  description          = "Invoice push dedupe"
+
+  engine         = "redis"
+  engine_version = "7.0"
+  node_type      = "cache.t4g.small" # 1.37 GiB, closest to 1 GB
+  port           = 6378              # keeps the port the job code already uses
+
+  num_cache_clusters         = 2 # primary + replica, like STANDARD_HA
+  automatic_failover_enabled = true
+  multi_az_enabled           = true
+
+  transit_encryption_enabled = true
+  at_rest_encryption_enabled = true
+  auth_token                 = random_password.redis_auth.result
+
+  subnet_group_name  = aws_elasticache_subnet_group.dedupe.name
+  security_group_ids = [aws_security_group.redis.id]
+}
+
+# ---------------------------------------------------------------------------
+# Storage
+# ---------------------------------------------------------------------------
+resource "aws_s3_bucket" "exports" {
+  bucket              = "${var.project_id}-billing-exports"
+  object_lock_enabled = true
+}
+
+resource "aws_s3_bucket_versioning" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  versioning_configuration { status = "Enabled" } # required by Object Lock
+}
+
+# 220752000 s = 2555 days. COMPLIANCE is the closest match to is_locked = true: nobody can shorten or remove it.
+resource "aws_s3_bucket_object_lock_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    default_retention {
+      mode = "COMPLIANCE"
+      days = 2555
+    }
+  }
+  depends_on = [aws_s3_bucket_versioning.exports]
+}
+
+resource "aws_s3_bucket_public_access_block" "exports" {
+  bucket                  = aws_s3_bucket.exports.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_ownership_controls" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule { object_ownership = "BucketOwnerEnforced" }
+}
+
+# Autoclass -> Intelligent-Tiering from day 0.
+resource "aws_s3_bucket_lifecycle_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    id     = "intelligent-tiering"
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 0
+      storage_class = "INTELLIGENT_TIERING"
+    }
+  }
+  depends_on = [aws_s3_bucket_versioning.exports]
+}
+
+# ---------------------------------------------------------------------------
+# Query engine: Athena on Iceberg (replaces BigQuery dataset "billing").
+# Tables billing.invoices and billing.invoice_snapshots are created by the data copy, not here.
+# ---------------------------------------------------------------------------
+resource "aws_s3_bucket" "athena" {
+  bucket = "${var.project_id}-billing-athena"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena" {
+  bucket                  = aws_s3_bucket.athena.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_glue_catalog_database" "billing" {
+  name         = local.glue_db
+  location_uri = "s3://${aws_s3_bucket.athena.bucket}/warehouse/"
+}
+
+resource "aws_athena_workgroup" "export" {
+  name = "billing-export"
+  configuration {
+    enforce_workgroup_configuration = true
+    engine_version { selected_engine_version = "Athena engine version 3" }
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena.bucket}/results/"
+    }
+  }
+}
+
+# ---------------------------------------------------------------------------
+# What the job may do. The GCP repo doesn't show the BigQuery/GCS grants for the
+# service account, so this is written from what export.py actually calls.
+# ---------------------------------------------------------------------------
+data "aws_iam_policy_document" "export" {
+  statement {
+    actions = [
+      "athena:StartQueryExecution",
+      "athena:GetQueryExecution",
+      "athena:GetQueryResults",
+      "athena:StopQueryExecution",
+    ]
+    resources = [aws_athena_workgroup.export.arn]
+  }
+  statement {
+    actions = ["glue:GetDatabase", "glue:GetTable", "glue:GetTables", "glue:GetPartitions", "glue:UpdateTable"]
+    resources = [
+      "arn:aws:glue:${var.region}:${local.account_id}:catalog",
+      aws_glue_catalog_database.billing.arn,
+      "arn:aws:glue:${var.region}:${local.account_id}:table/${local.glue_db}/*",
+    ]
+  }
+  statement {
+    actions = [
+      "s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket",
+      "s3:GetBucketLocation", "s3:AbortMultipartUpload", "s3:ListBucketMultipartUploads",
+    ]
+    resources = [aws_s3_bucket.athena.arn, "${aws_s3_bucket.athena.arn}/*"]
+  }
+  statement {
+    actions   = ["s3:PutObject"]
+    resources = ["${aws_s3_bucket.exports.arn}/*"]
+  }
+}
+
+resource "aws_iam_role_policy" "export" {
+  name   = "export"
+  role   = aws_iam_role.export.id
+  policy = data.aws_iam_policy_document.export.json
+}
+
+# ---------------------------------------------------------------------------
+# The job: Cloud Run job (16 tasks, 4 at a time, 2 retries, 3 h) -> Batch array job on Fargate
+# ---------------------------------------------------------------------------
+resource "aws_ecr_repository" "export" {
+  name = "jobs/billing-export"
+}
+
+resource "aws_batch_compute_environment" "export" {
+  name = "billing-export"
+  type = "MANAGED"
+  compute_resources {
+    type               = "FARGATE"
+    max_vcpus          = local.parallelism * local.vcpu # caps concurrency at 4 tasks
+    subnets            = var.subnet_ids
+    security_group_ids = [aws_security_group.job.id]
+  }
+}
+
+resource "aws_batch_job_queue" "export" {
+  name     = "billing-export"
+  state    = "ENABLED"
+  priority = 1
+  compute_environment_order {
+    order               = 1
+    compute_environment = aws_batch_compute_environment.export.arn
+  }
+}
+
+resource "aws_batch_job_definition" "export" {
+  name                  = "billing-export"
+  type                  = "container"
+  platform_capabilities = ["FARGATE"]
+
+  retry_strategy { attempts = 3 } # 1 try + max_retries 2
+
+  timeout { attempt_duration_seconds = 10800 }
+
+  container_properties = jsonencode({
+    image            = "${aws_ecr_repository.export.repository_url}:latest"
+    executionRoleArn = aws_iam_role.export_execution.arn
+    jobRoleArn       = aws_iam_role.export.arn
+    resourceRequirements = [
+      { type = "VCPU", value = tostring(local.vcpu) },
+      { type = "MEMORY", value = "4096" },
+    ]
+    fargatePlatformConfiguration = { platformVersion = "LATEST" }
+    networkConfiguration         = { assignPublicIp = "DISABLED" }
+    environment = [
+      { name = "AWS_REGION", value = var.region },
+      { name = "TASK_COUNT", value = tostring(local.task_count) },
+      { name = "REDIS_HOST", value = aws_elasticache_replication_group.dedupe.primary_endpoint_address },
+      { name = "EXPORT_BUCKET", value = aws_s3_bucket.exports.bucket },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.export.name },
+      { name = "ATHENA_DATABASE", value = local.glue_db },
+    ]
+    secrets = [
+      { name = "PARTNER_API_KEY", valueFrom = aws_secretsmanager_secret.partner_api_key.arn },
+      { name = "REDIS_AUTH", valueFrom = aws_secretsmanager_secret.redis_auth.arn },
+    ]
+  })
+}
+
+# ---------------------------------------------------------------------------
+# Schedule: 03:00 on the 1st, Berlin time
+# ---------------------------------------------------------------------------
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "scheduler" {
+  name               = "billing-export-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+data "aws_iam_policy_document" "scheduler" {
+  statement {
+    actions = ["batch:SubmitJob"]
+    resources = [
+      aws_batch_job_definition.export.arn_prefix,
+      "${aws_batch_job_definition.export.arn_prefix}:*",
+      aws_batch_job_queue.export.arn,
+    ]
+  }
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  name   = "submit-export"
+  role   = aws_iam_role.scheduler.id
+  policy = data.aws_iam_policy_document.scheduler.json
+}
+
+resource "aws_scheduler_schedule" "monthly" {
+  name                         = "billing-export-monthly"
+  schedule_expression          = "cron(0 3 1 * ? *)"
+  schedule_expression_timezone = "Europe/Berlin"
+
+  flexible_time_window { mode = "OFF" }
+
+  target {
+    arn      = "arn:aws:scheduler:::aws-sdk:batch:submitJob"
+    role_arn = aws_iam_role.scheduler.arn
+
+    input = jsonencode({
+      JobName         = "billing-export-monthly"
+      JobQueue        = aws_batch_job_queue.export.arn
+      JobDefinition   = aws_batch_job_definition.export.arn_prefix
+      ArrayProperties = { Size = local.task_count }
+    })
+
+    # Cloud Scheduler had no retries; Scheduler's default is 185 over 24 h.
+    retry_policy {
+      maximum_retry_attempts = 0
+    }
+  }
+}
