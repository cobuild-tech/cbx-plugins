+
+class QueryError(Exception):
+    pass
+
+
+def run_query(sql, params=None):
+    kwargs = dict(QueryString=sql, WorkGroup=os.environ["ATHENA_WORKGROUP"])
+    if params:
+        kwargs["ExecutionParameters"] = [str(p) for p in params]
+    qid = athena.start_query_execution(**kwargs)["QueryExecutionId"]
+    delay = 1
+    while True:
+        status = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+        if status["State"] == "SUCCEEDED":
+            return qid
+        if status["State"] in ("FAILED", "CANCELLED"):
+            raise QueryError(status.get("StateChangeReason", status["State"]))
+        time.sleep(delay)
+        delay = min(delay * 2, 10)
+
+
+def run_merge(sql):
+    # All 16 tasks run the same idempotent MERGE (as before); concurrent Iceberg commits conflict, so retry.
+    for attempt in range(10):
+        try:
+            return run_query(sql)
+        except QueryError as e:
+            if "ICEBERG_COMMIT_ERROR" not in str(e) or attempt == 9:
+                raise
+            time.sleep(random.uniform(1, 5) * (attempt + 1))
 
