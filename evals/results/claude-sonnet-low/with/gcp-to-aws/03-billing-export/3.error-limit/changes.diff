+def convert(type_, value):
+    if value is None:
+        return None
+    if type_ in ("tinyint", "smallint", "integer", "bigint"):
+        return int(value)
+    if type_ in ("real", "float", "double"):
+        return float(value)
+    if type_ == "boolean":
+        return value == "true"
+    return value
+
+
