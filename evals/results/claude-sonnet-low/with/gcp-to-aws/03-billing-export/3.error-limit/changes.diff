diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..5f089bf
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,383 @@
+terraform {
+  required_providers {
+    aws    = { source = "hashicorp/aws", version = "~> 5.0" }
+    random = { source = "hashicorp/random", version = "~> 3.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+variable "region" {
+  type    = string
+  default = "eu-west-1" # was europe-west1
+}
+
+# Replaces var.project_id. S3 bucket names are global, so this must be unique.
+variable "name_prefix" { type = string }
+
+# Existing network that replaces the "default" VPC + Serverless VPC connector.
+# Subnets need a route to the internet (NAT) for the partner API, ECR, Athena and Secrets Manager.
+variable "vpc_id" { type = string }
+variable "private_subnet_ids" { type = list(string) }
+
+# BigQuery dataset `billing` becomes Iceberg tables (billing.invoices, billing.invoice_snapshots)
+# in Glue + S3. The tables and their data are NOT created here: load them per the data move.
+variable "lake_bucket_name" { type = string }
+variable "glue_database" {
+  type    = string
+  default = "billing"
+}
+
+data "aws_caller_identity" "current" {}
+
+locals {
+  account_id = data.aws_caller_identity.current.account_id
+  task_count = 16
+}
+
+############################ Identity ############################
+# google_service_account.export was shared by the job AND the scheduler; split into one role each.
+
+data "aws_iam_policy_document" "ecs_tasks_trust" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+# Task (job) role: what the code calls.
+resource "aws_iam_role" "export" {
+  name               = "billing-export"
+  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_trust.json
+}
+
+# Execution role: pulls the image and injects secrets into env vars (this is what reads the secrets).
+resource "aws_iam_role" "export_execution" {
+  name               = "billing-export-execution"
+  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_trust.json
+}
+
+resource "aws_iam_role_policy_attachment" "export_execution" {
+  role       = aws_iam_role.export_execution.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+# google_secret_manager_secret_iam_member.export_reads_key
+resource "aws_iam_role_policy" "export_reads_secrets" {
+  name = "reads-secrets"
+  role = aws_iam_role.export_execution.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["secretsmanager:GetSecretValue"]
+      Resource = [aws_secretsmanager_secret.partner_api_key.arn, aws_secretsmanager_secret.redis_auth.arn]
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "export" {
+  name = "billing-export"
+  role = aws_iam_role.export.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect   = "Allow"
+        Action   = ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults", "athena:StopQueryExecution", "athena:GetWorkGroup"]
+        Resource = aws_athena_workgroup.export.arn
+      },
+      {
+        Effect = "Allow"
+        Action = ["glue:GetDatabase", "glue:GetTable", "glue:GetTables", "glue:GetPartitions", "glue:UpdateTable"]
+        Resource = [
+          "arn:aws:glue:${var.region}:${local.account_id}:catalog",
+          "arn:aws:glue:${var.region}:${local.account_id}:database/${var.glue_database}",
+          "arn:aws:glue:${var.region}:${local.account_id}:table/${var.glue_database}/*",
+        ]
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["s3:ListBucket", "s3:GetBucketLocation"]
+        Resource = ["arn:aws:s3:::${var.lake_bucket_name}", aws_s3_bucket.athena_results.arn]
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"]
+        Resource = ["arn:aws:s3:::${var.lake_bucket_name}/*", "${aws_s3_bucket.athena_results.arn}/*"]
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["s3:PutObject"]
+        Resource = "${aws_s3_bucket.exports.arn}/invoices/*"
+      },
+    ]
+  })
+}
+
+############################ Secrets ############################
+# Value is set out-of-band, as before (no version in the GCP Terraform either).
+resource "aws_secretsmanager_secret" "partner_api_key" {
+  name = "partner-api-key"
+}
+
+############################ Dedupe cache ############################
+resource "random_password" "redis_auth" {
+  length  = 32
+  special = false
+}
+
+resource "aws_secretsmanager_secret" "redis_auth" {
+  name = "export-dedupe-auth"
+}
+
+resource "aws_secretsmanager_secret_version" "redis_auth" {
+  secret_id     = aws_secretsmanager_secret.redis_auth.id
+  secret_string = random_password.redis_auth.result
+}
+
+resource "aws_security_group" "job" {
+  name   = "billing-export-job"
+  vpc_id = var.vpc_id
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_security_group" "redis" {
+  name   = "export-dedupe"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 6379
+    to_port         = 6379
+    protocol        = "tcp"
+    security_groups = [aws_security_group.job.id]
+  }
+}
+
+resource "aws_elasticache_subnet_group" "dedupe" {
+  name       = "export-dedupe"
+  subnet_ids = var.private_subnet_ids
+}
+
+# google_redis_instance.dedupe (STANDARD_HA, 1 GB, Redis 7.0, AUTH + TLS)
+resource "aws_elasticache_replication_group" "dedupe" {
+  replication_group_id       = "export-dedupe"
+  description                = "billing export dedupe"
+  engine                     = "redis"
+  engine_version             = "7.0"
+  node_type                  = "cache.t4g.small" # ~1.4 GB; closest to 1 GB
+  port                       = 6379
+  num_cache_clusters         = 2 # primary + replica
+  automatic_failover_enabled = true
+  multi_az_enabled           = true
+  at_rest_encryption_enabled = true
+  transit_encryption_enabled = true
+  auth_token                 = random_password.redis_auth.result
+  subnet_group_name          = aws_elasticache_subnet_group.dedupe.name
+  security_group_ids         = [aws_security_group.redis.id]
+}
+
+############################ Storage ############################
+resource "aws_s3_bucket" "exports" {
+  bucket              = "${var.name_prefix}-billing-exports"
+  object_lock_enabled = true # must be set at creation
+}
+
+resource "aws_s3_bucket_ownership_controls" "exports" { # uniform_bucket_level_access
+  bucket = aws_s3_bucket.exports.id
+  rule { object_ownership = "BucketOwnerEnforced" }
+}
+
+resource "aws_s3_bucket_public_access_block" "exports" { # public_access_prevention = enforced
+  bucket                  = aws_s3_bucket.exports.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_versioning" "exports" { # required by Object Lock
+  bucket = aws_s3_bucket.exports.id
+  versioning_configuration { status = "Enabled" }
+}
+
+# retention_policy 7 years, is_locked = true. COMPLIANCE mode is irreversible: nobody, including
+# root, can shorten it or delete locked versions.
+resource "aws_s3_bucket_object_lock_configuration" "exports" {
+  bucket     = aws_s3_bucket.exports.id
+  depends_on = [aws_s3_bucket_versioning.exports]
+  rule {
+    default_retention {
+      mode = "COMPLIANCE"
+      days = 2555 # 220752000 s
+    }
+  }
+}
+
+# autoclass -> Intelligent-Tiering (objects start in Standard, as with Autoclass)
+resource "aws_s3_bucket_lifecycle_configuration" "exports" {
+  bucket     = aws_s3_bucket.exports.id
+  depends_on = [aws_s3_bucket_versioning.exports]
+  rule {
+    id     = "intelligent-tiering"
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 0
+      storage_class = "INTELLIGENT_TIERING"
+    }
+  }
+}
+
+# New: Athena query results (no GCP counterpart; BigQuery keeps results itself).
+resource "aws_s3_bucket" "athena_results" {
+  bucket = "${var.name_prefix}-billing-athena-results"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena_results" {
+  bucket                  = aws_s3_bucket.athena_results.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_lifecycle_configuration" "athena_results" {
+  bucket = aws_s3_bucket.athena_results.id
+  rule {
+    id     = "expire"
+    status = "Enabled"
+    filter {}
+    expiration { days = 7 }
+  }
+}
+
+resource "aws_athena_workgroup" "export" {
+  name = "billing-export"
+  configuration {
+    enforce_workgroup_configuration = true
+    engine_version { selected_engine_version = "Athena engine version 3" }
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena_results.bucket}/"
+    }
+  }
+}
+
+############################ Job ############################
+resource "aws_ecr_repository" "billing_export" {
+  name = "jobs/billing-export"
+}
+
+# google_cloud_run_v2_job.export -> AWS Batch array job on Fargate
+resource "aws_batch_compute_environment" "export" {
+  compute_environment_name = "billing-export"
+  type                     = "MANAGED"
+  compute_resources {
+    type               = "FARGATE"
+    max_vcpus          = 8 # parallelism 4 x 2 vCPU
+    subnets            = var.private_subnet_ids
+    security_group_ids = [aws_security_group.job.id]
+  }
+}
+
+resource "aws_batch_job_queue" "export" {
+  name                 = "billing-export"
+  state                = "ENABLED"
+  priority             = 1
+  compute_environments = [aws_batch_compute_environment.export.arn]
+}
+
+resource "aws_batch_job_definition" "export" {
+  name                  = "billing-export"
+  type                  = "container"
+  platform_capabilities = ["FARGATE"]
+
+  retry_strategy { attempts = 3 } # max_retries 2 + first attempt
+  timeout { attempt_duration_seconds = 10800 }
+
+  container_properties = jsonencode({
+    image            = "${aws_ecr_repository.billing_export.repository_url}:latest"
+    executionRoleArn = aws_iam_role.export_execution.arn
+    jobRoleArn       = aws_iam_role.export.arn
+    resourceRequirements = [
+      { type = "VCPU", value = "2" },
+      { type = "MEMORY", value = "4096" },
+    ]
+    networkConfiguration = { assignPublicIp = "DISABLED" }
+    environment = [
+      { name = "AWS_REGION", value = var.region },
+      { name = "TASK_COUNT", value = tostring(local.task_count) },
+      { name = "REDIS_HOST", value = aws_elasticache_replication_group.dedupe.primary_endpoint_address },
+      { name = "REDIS_PORT", value = "6379" },
+      { name = "EXPORT_BUCKET", value = aws_s3_bucket.exports.bucket },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.export.name },
+    ]
+    secrets = [
+      { name = "PARTNER_API_KEY", valueFrom = aws_secretsmanager_secret.partner_api_key.arn },
+      { name = "REDIS_AUTH", valueFrom = aws_secretsmanager_secret.redis_auth.arn },
+    ]
+  })
+}
+
+############################ Schedule ############################
+data "aws_iam_policy_document" "scheduler_trust" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "scheduler" {
+  name               = "billing-export-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_trust.json
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  name = "submit-job"
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect = "Allow"
+      Action = ["batch:SubmitJob"]
+      Resource = [
+        aws_batch_job_queue.export.arn,
+        aws_batch_job_definition.export.arn_prefix,
+        "${aws_batch_job_definition.export.arn_prefix}:*",
+      ]
+    }]
+  })
+}
+
+resource "aws_scheduler_schedule" "monthly" {
+  name                         = "billing-export-monthly"
+  schedule_expression          = "cron(0 3 1 * ? *)"
+  schedule_expression_timezone = "Europe/Berlin"
+
+  flexible_time_window { mode = "OFF" }
+
+  target {
+    arn      = "arn:aws:scheduler:::aws-sdk:batch:submitJob"
+    role_arn = aws_iam_role.scheduler.arn
+    input = jsonencode({
+      JobName         = "billing-export"
+      JobDefinition   = aws_batch_job_definition.export.name
+      JobQueue        = aws_batch_job_queue.export.arn
+      ArrayProperties = { Size = local.task_count }
+    })
+    # Cloud Scheduler had no retries; the Scheduler default is up to 185 over 24 h.
+    retry_policy { maximum_retry_attempts = 0 }
+  }
+}
