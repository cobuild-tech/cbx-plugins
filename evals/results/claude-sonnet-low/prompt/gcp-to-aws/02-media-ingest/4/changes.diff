diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..dab0b16
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,165 @@
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = "~> 5.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region # closest to us-central1
+}
+
+# Replaces GCP project_id; used as the bucket-name prefix.
+variable "project_id" { type = string }
+variable "region" {
+  type    = string
+  default = "us-east-2"
+}
+
+data "aws_caller_identity" "current" {}
+
+resource "aws_s3_bucket" "incoming" {
+  bucket = "${var.project_id}-media-incoming"
+}
+
+# Versioning provides the "generation" (version id) used to detect replaced files.
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration { status = "Enabled" }
+}
+
+resource "aws_iam_role" "media" {
+  name = "media-pipeline"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Action    = "sts:AssumeRole"
+      Principal = { Service = ["lambda.amazonaws.com"] }
+    }]
+  })
+}
+
+resource "aws_iam_role_policy_attachment" "logs" {
+  role       = aws_iam_role.media.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_iam_role_policy" "media" {
+  role = aws_iam_role.media.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      { Effect = "Allow", Action = ["s3:GetObject", "s3:GetObjectVersion"], Resource = "${aws_s3_bucket.incoming.arn}/*" },
+      { Effect = "Allow", Action = "sns:Publish", Resource = aws_sns_topic.media_events.arn },
+      { Effect = "Allow", Action = "scheduler:CreateSchedule", Resource = "*" },
+      { Effect = "Allow", Action = "iam:PassRole", Resource = aws_iam_role.scheduler.arn },
+      { Effect = "Allow", Action = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"], Resource = aws_sqs_queue.transcode.arn },
+    ]
+  })
+}
+
+resource "aws_sns_topic" "media_events" {
+  name = "media-events"
+}
+
+# Dead-letter queue: SQS needs one to cap delivery attempts (Cloud Tasks just dropped the task).
+resource "aws_sqs_queue" "transcode_dlq" {
+  name = "transcode-dlq"
+}
+
+resource "aws_sqs_queue" "transcode" {
+  name                       = "transcode"
+  visibility_timeout_seconds = 900 # must be >= transcode function timeout
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.transcode_dlq.arn
+    maxReceiveCount     = 4 # max_attempts
+  })
+}
+
+# EventBridge Scheduler holds each task for the 2h delay, then drops it on the queue.
+resource "aws_iam_role" "scheduler" {
+  name = "media-pipeline-scheduler"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Action    = "sts:AssumeRole"
+      Principal = { Service = "scheduler.amazonaws.com" }
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version   = "2012-10-17"
+    Statement = [{ Effect = "Allow", Action = "sqs:SendMessage", Resource = aws_sqs_queue.transcode.arn }]
+  })
+}
+
+resource "aws_lambda_function" "ingest" {
+  function_name = "media-ingest"
+  runtime       = "python3.12"
+  handler       = "main.on_upload"
+  s3_bucket     = "${var.project_id}-fn-src"
+  s3_key        = "ingest.zip"
+  timeout       = 60
+  role          = aws_iam_role.media.arn
+
+  environment {
+    variables = {
+      TASKS_QUEUE        = aws_sqs_queue.transcode.arn
+      SCHEDULER_ROLE_ARN = aws_iam_role.scheduler.arn
+      EVENTS_TOPIC       = aws_sns_topic.media_events.arn
+    }
+  }
+}
+
+# Equivalent of RETRY_POLICY_DO_NOT_RETRY.
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_lambda_permission" "ingest_s3" {
+  statement_id   = "AllowS3"
+  action         = "lambda:InvokeFunction"
+  function_name  = aws_lambda_function.ingest.function_name
+  principal      = "s3.amazonaws.com"
+  source_arn     = aws_s3_bucket.incoming.arn
+  source_account = data.aws_caller_identity.current.account_id
+}
+
+# Fires on every new object and on every overwrite of an existing name.
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+  depends_on = [aws_lambda_permission.ingest_s3]
+}
+
+resource "aws_lambda_function" "transcode" {
+  function_name = "media-transcode"
+  runtime       = "python3.12"
+  handler       = "main.transcode"
+  s3_bucket     = "${var.project_id}-fn-src"
+  s3_key        = "transcode.zip"
+  timeout       = 900 # Lambda maximum (GCP: 1800)
+  memory_size   = 4096
+  role          = aws_iam_role.media.arn
+}
+
+resource "aws_lambda_event_source_mapping" "transcode" {
+  event_source_arn = aws_sqs_queue.transcode.arn
+  function_name    = aws_lambda_function.transcode.arn
+  batch_size       = 1
+  scaling_config {
+    maximum_concurrency = 3 # max_concurrent_dispatches
+  }
+}
+
+resource "aws_glue_catalog_database" "media" {
+  name = "media"
+}
