diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..924fdf8
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,190 @@
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = "~> 5.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+variable "prefix" {
+  type        = string
+  description = "Replaces the GCP project_id in bucket names. Expects a pre-existing \"<prefix>-fn-src\" bucket holding ingest.zip and transcode.zip."
+}
+
+variable "region" {
+  type    = string
+  default = "us-east-2"
+}
+
+# Versioning supplies the per-upload "generation" (S3 version id).
+resource "aws_s3_bucket" "incoming" {
+  bucket = "${var.prefix}-media-incoming"
+}
+
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration {
+    status = "Enabled"
+  }
+}
+
+resource "aws_s3_bucket_public_access_block" "incoming" {
+  bucket                  = aws_s3_bucket.incoming.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_sns_topic" "media_events" {
+  name = "media-events"
+}
+
+# ---- IAM ----
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "media" {
+  name               = "media-pipeline"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "logs" {
+  role       = aws_iam_role.media.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+data "aws_iam_policy_document" "media" {
+  statement {
+    actions   = ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket"]
+    resources = [aws_s3_bucket.incoming.arn, "${aws_s3_bucket.incoming.arn}/*"]
+  }
+  statement {
+    actions   = ["sns:Publish"]
+    resources = [aws_sns_topic.media_events.arn]
+  }
+  statement {
+    actions   = ["scheduler:CreateSchedule"]
+    resources = ["arn:aws:scheduler:${var.region}:${data.aws_caller_identity.current.account_id}:schedule/${aws_scheduler_schedule_group.transcode.name}/*"]
+  }
+  statement {
+    actions   = ["iam:PassRole"]
+    resources = [aws_iam_role.scheduler.arn]
+  }
+}
+
+data "aws_caller_identity" "current" {}
+
+resource "aws_iam_role_policy" "media" {
+  role   = aws_iam_role.media.id
+  policy = data.aws_iam_policy_document.media.json
+}
+
+# ---- Delayed dispatch (replaces Cloud Tasks) ----
+
+resource "aws_scheduler_schedule_group" "transcode" {
+  name = "transcode"
+}
+
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "scheduler" {
+  name               = "media-pipeline-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["lambda:InvokeFunction"]
+      Resource = aws_lambda_function.transcode.arn
+    }]
+  })
+}
+
+# ---- Functions ----
+
+resource "aws_lambda_function" "ingest" {
+  function_name = "media-ingest"
+  role          = aws_iam_role.media.arn
+  runtime       = "python3.12"
+  handler       = "main.on_upload"
+  timeout       = 60
+  s3_bucket     = "${var.prefix}-fn-src"
+  s3_key        = "ingest.zip"
+
+  environment {
+    variables = {
+      SCHEDULER_GROUP    = aws_scheduler_schedule_group.transcode.name
+      SCHEDULER_ROLE_ARN = aws_iam_role.scheduler.arn
+      TRANSCODE_ARN      = aws_lambda_function.transcode.arn
+      EVENTS_TOPIC       = aws_sns_topic.media_events.arn
+    }
+  }
+}
+
+# Equivalent of RETRY_POLICY_DO_NOT_RETRY.
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_lambda_function" "transcode" {
+  function_name = "media-transcode"
+  role          = aws_iam_role.media.arn
+  runtime       = "python3.12"
+  handler       = "main.transcode"
+  timeout       = 900  # Lambda hard maximum; GCP allowed 1800
+  memory_size   = 4096
+  s3_bucket     = "${var.prefix}-fn-src"
+  s3_key        = "transcode.zip"
+
+  # Replaces the queue's max_concurrent_dispatches = 3.
+  reserved_concurrent_executions = 3
+}
+
+# Fires on every new object and on every overwrite of an existing name.
+resource "aws_lambda_permission" "s3_ingest" {
+  statement_id   = "AllowS3Invoke"
+  action         = "lambda:InvokeFunction"
+  function_name  = aws_lambda_function.ingest.function_name
+  principal      = "s3.amazonaws.com"
+  source_arn     = aws_s3_bucket.incoming.arn
+  source_account = data.aws_caller_identity.current.account_id
+}
+
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+  depends_on = [aws_lambda_permission.s3_ingest]
+}
+
+# ---- Analytics (replaces BigQuery dataset) ----
+
+resource "aws_glue_catalog_database" "media" {
+  name = "media"
+}
