diff --git a/sql/weekly_report.athena.sql b/sql/weekly_report.athena.sql
new file mode 100644
index 0000000..ab44303
--- /dev/null
+++ b/sql/weekly_report.athena.sql
@@ -0,0 +1,13 @@
+-- Weekly editor report (Athena/Trino). Weeks run Sunday to Saturday, as the editors' schedule does.
+-- Trino's week is Monday-based, so dates are shifted by one day around date_trunc.
+-- Assumes media.uploads.uploaded_at is a UTC `timestamp`.
+SELECT
+  date_trunc('week', CAST(uploaded_at AS date) + INTERVAL '1' DAY) - INTERVAL '1' DAY AS week_start,
+  uploader,
+  COUNT(*) AS uploads,
+  CAST(SUM(transcode_seconds) AS double) / COUNT(*) AS avg_transcode_s,
+  COUNT_IF(day_of_week(uploaded_at) IN (6, 7)) AS weekend_uploads  -- Sat=6, Sun=7
+FROM media.uploads
+WHERE uploaded_at >= CAST(current_timestamp AT TIME ZONE 'UTC' AS timestamp) - INTERVAL '56' DAY
+GROUP BY 1, 2
+ORDER BY week_start DESC, uploads DESC;
