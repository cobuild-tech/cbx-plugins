+}
+
+
+def run_query(sql, params=None):
+    kwargs = {"QueryString": sql, "WorkGroup": WORKGROUP}
+    if params:
+        kwargs["ExecutionParameters"] = [str(p) for p in params]
+    qid = athena.start_query_execution(**kwargs)["QueryExecutionId"]
+    while True:
+        status = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+        if status["State"] == "SUCCEEDED":
+            return qid
+        if status["State"] in ("FAILED", "CANCELLED"):
+            raise RuntimeError(f"Athena query {status['State']}: {status.get('StateChangeReason')}")
+        time.sleep(2)
+
+
+def fetch_rows(qid):
+    """Yield (names, typed values) per row; Athena returns everything as strings."""
+    first = True
+    names = types = None
+    for page in athena.get_paginator("get_query_results").paginate(QueryExecutionId=qid):
+        if names is None:
+            cols = page["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]
+            names = [c["Name"] for c in cols]
+            types = [c["Type"] for c in cols]
+        for raw in page["ResultSet"]["Rows"]:
+            if first:  # first row of a SELECT result is the header
+                first = False
+                continue
+            vals = []
+            for cell, t in zip(raw["Data"], types):
+                v = cell.get("VarCharValue")
+                vals.append(None if v is None else _CASTS.get(t, str)(v))
+            yield names, vals
 
 
