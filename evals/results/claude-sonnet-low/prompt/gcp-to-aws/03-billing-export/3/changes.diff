diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..445e1fa
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,423 @@
+terraform {
+  required_providers {
+    aws    = { source = "hashicorp/aws", version = "~> 5.0" }
+    random = { source = "hashicorp/random", version = "~> 3.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+variable "region" {
+  type    = string
+  default = "eu-west-1"
+}
+
+# Prefix for globally-unique names (the GCP project_id was used for this).
+variable "name_prefix" { type = string }
+variable "vpc_id" { type = string }
+variable "subnet_ids" { type = list(string) }
+
+data "aws_caller_identity" "current" {}
+
+locals {
+  task_count = 16
+  image      = "${data.aws_caller_identity.current.account_id}.dkr.ecr.${var.region}.amazonaws.com/jobs/billing-export:latest"
+}
+
+# ---------------------------------------------------------------- IAM
+
+data "aws_iam_policy_document" "ecs_tasks_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+# Role the job code runs as (the GCP service account).
+resource "aws_iam_role" "export" {
+  name               = "billing-export"
+  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_assume.json
+}
+
+# Role Batch/ECS uses to pull the image and inject secrets.
+resource "aws_iam_role" "export_exec" {
+  name               = "billing-export-exec"
+  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "export_exec_base" {
+  role       = aws_iam_role.export_exec.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+# ---------------------------------------------------------------- Secrets
+
+resource "aws_secretsmanager_secret" "partner_api_key" {
+  name = "partner-api-key"
+}
+
+resource "random_password" "redis_auth" {
+  length  = 64
+  special = false
+}
+
+resource "aws_secretsmanager_secret" "redis_auth" {
+  name = "export-dedupe-redis-auth"
+}
+
+resource "aws_secretsmanager_secret_version" "redis_auth" {
+  secret_id     = aws_secretsmanager_secret.redis_auth.id
+  secret_string = random_password.redis_auth.result
+}
+
+resource "aws_iam_role_policy" "export_exec_reads_secrets" {
+  name = "reads-secrets"
+  role = aws_iam_role.export_exec.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect = "Allow"
+      Action = ["secretsmanager:GetSecretValue"]
+      Resource = [
+        aws_secretsmanager_secret.partner_api_key.arn,
+        aws_secretsmanager_secret.redis_auth.arn,
+      ]
+    }]
+  })
+}
+
+# ---------------------------------------------------------------- Redis (dedupe)
+
+resource "aws_security_group" "redis" {
+  name   = "export-dedupe"
+  vpc_id = var.vpc_id
+}
+
+resource "aws_security_group" "job" {
+  name   = "billing-export-job"
+  vpc_id = var.vpc_id
+
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_security_group_rule" "redis_from_job" {
+  type                     = "ingress"
+  security_group_id        = aws_security_group.redis.id
+  source_security_group_id = aws_security_group.job.id
+  protocol                 = "tcp"
+  from_port                = 6378
+  to_port                  = 6378
+}
+
+resource "aws_elasticache_subnet_group" "dedupe" {
+  name       = "export-dedupe"
+  subnet_ids = var.subnet_ids
+}
+
+resource "aws_elasticache_replication_group" "dedupe" {
+  replication_group_id       = "export-dedupe"
+  description                = "billing export dedupe"
+  engine                     = "redis"
+  engine_version             = "7.0"
+  node_type                  = "cache.t4g.small" # ~1.4 GiB, closest to the 1 GB GCP instance
+  port                       = 6378
+  num_cache_clusters         = 2
+  automatic_failover_enabled = true
+  multi_az_enabled           = true
+  subnet_group_name          = aws_elasticache_subnet_group.dedupe.name
+  security_group_ids         = [aws_security_group.redis.id]
+  transit_encryption_enabled = true
+  at_rest_encryption_enabled = true
+  auth_token                 = random_password.redis_auth.result
+}
+
+# ---------------------------------------------------------------- S3 exports
+
+resource "aws_s3_bucket" "exports" {
+  bucket              = "${var.name_prefix}-billing-exports"
+  object_lock_enabled = true
+}
+
+resource "aws_s3_bucket_versioning" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  versioning_configuration {
+    status = "Enabled" # required by Object Lock
+  }
+}
+
+resource "aws_s3_bucket_ownership_controls" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    object_ownership = "BucketOwnerEnforced"
+  }
+}
+
+resource "aws_s3_bucket_public_access_block" "exports" {
+  bucket                  = aws_s3_bucket.exports.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# 7 years (220752000 s = 2555 d), locked: COMPLIANCE mode cannot be shortened or removed.
+resource "aws_s3_bucket_object_lock_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    default_retention {
+      mode = "COMPLIANCE"
+      days = 2555
+    }
+  }
+  depends_on = [aws_s3_bucket_versioning.exports]
+}
+
+# Autoclass equivalent.
+resource "aws_s3_bucket_lifecycle_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    id     = "intelligent-tiering"
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 0
+      storage_class = "INTELLIGENT_TIERING"
+    }
+  }
+  depends_on = [aws_s3_bucket_versioning.exports]
+}
+
+# ---------------------------------------------------------------- Athena
+
+resource "aws_s3_bucket" "athena_results" {
+  bucket = "${var.name_prefix}-billing-athena-results"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena_results" {
+  bucket                  = aws_s3_bucket.athena_results.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_athena_workgroup" "billing_export" {
+  name = "billing-export"
+  configuration {
+    enforce_workgroup_configuration = true
+    engine_version {
+      selected_engine_version = "Athena engine version 3"
+    }
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena_results.bucket}/"
+    }
+  }
+}
+
+# Job permissions. (The GCP config granted only secret access in Terraform; the
+# BigQuery/GCS grants lived elsewhere. Here they are explicit.)
+resource "aws_iam_role_policy" "export_job" {
+  name = "billing-export-job"
+  role = aws_iam_role.export.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect   = "Allow"
+        Action   = ["s3:PutObject"]
+        Resource = "${aws_s3_bucket.exports.arn}/*"
+      },
+      {
+        Effect = "Allow"
+        Action = ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults"]
+        Resource = aws_athena_workgroup.billing_export.arn
+      },
+      {
+        Effect = "Allow"
+        Action = ["glue:GetDatabase", "glue:GetTable", "glue:GetTables", "glue:GetPartitions", "glue:UpdateTable"]
+        Resource = [
+          "arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:catalog",
+          "arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:database/billing",
+          "arn:aws:glue:${var.region}:${data.aws_caller_identity.current.account_id}:table/billing/*",
+        ]
+      },
+      {
+        # Iceberg data/metadata location of the billing tables; adjust to the real bucket.
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation"]
+        Resource = [
+          aws_s3_bucket.athena_results.arn,
+          "${aws_s3_bucket.athena_results.arn}/*",
+          "arn:aws:s3:::${var.name_prefix}-billing-lake",
+          "arn:aws:s3:::${var.name_prefix}-billing-lake/*",
+        ]
+      },
+    ]
+  })
+}
+
+# ---------------------------------------------------------------- Batch job
+
+resource "aws_cloudwatch_log_group" "export" {
+  name = "/aws/batch/billing-export"
+}
+
+data "aws_iam_policy_document" "batch_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["batch.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "batch_service" {
+  name               = "billing-export-batch-service"
+  assume_role_policy = data.aws_iam_policy_document.batch_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "batch_service" {
+  role       = aws_iam_role.batch_service.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSBatchServiceRole"
+}
+
+# 8 vCPU cap = 4 concurrent 2-vCPU tasks (Cloud Run "parallelism = 4").
+# Keep this environment dedicated to this job or the cap no longer means that.
+resource "aws_batch_compute_environment" "export" {
+  compute_environment_name = "billing-export"
+  type                     = "MANAGED"
+  service_role             = aws_iam_role.batch_service.arn
+
+  compute_resources {
+    type               = "FARGATE"
+    max_vcpus          = 8
+    subnets            = var.subnet_ids
+    security_group_ids = [aws_security_group.job.id]
+  }
+
+  depends_on = [aws_iam_role_policy_attachment.batch_service]
+}
+
+resource "aws_batch_job_queue" "export" {
+  name     = "billing-export"
+  state    = "ENABLED"
+  priority = 1
+
+  compute_environment_order {
+    order               = 1
+    compute_environment = aws_batch_compute_environment.export.arn
+  }
+}
+
+resource "aws_batch_job_definition" "export" {
+  name                  = "billing-export"
+  type                  = "container"
+  platform_capabilities = ["FARGATE"]
+
+  retry_strategy {
+    attempts = 3 # max_retries = 2 -> 3 total attempts
+  }
+
+  timeout {
+    attempt_duration_seconds = 10800
+  }
+
+  container_properties = jsonencode({
+    image            = local.image
+    executionRoleArn = aws_iam_role.export_exec.arn
+    jobRoleArn       = aws_iam_role.export.arn
+    resourceRequirements = [
+      { type = "VCPU", value = "2" },
+      { type = "MEMORY", value = "4096" },
+    ]
+    networkConfiguration = { assignPublicIp = "ENABLED" } # direct internet egress to the partner API
+    fargatePlatformConfiguration = { platformVersion = "LATEST" }
+    environment = [
+      { name = "REDIS_HOST", value = aws_elasticache_replication_group.dedupe.primary_endpoint_address },
+      { name = "EXPORT_BUCKET", value = aws_s3_bucket.exports.bucket },
+      { name = "TASK_COUNT", value = tostring(local.task_count) },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.billing_export.name },
+      { name = "AWS_REGION", value = var.region },
+    ]
+    secrets = [
+      { name = "PARTNER_API_KEY", valueFrom = aws_secretsmanager_secret.partner_api_key.arn },
+      { name = "REDIS_AUTH", valueFrom = aws_secretsmanager_secret.redis_auth.arn },
+    ]
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        "awslogs-group"         = aws_cloudwatch_log_group.export.name
+        "awslogs-region"        = var.region
+        "awslogs-stream-prefix" = "export"
+      }
+    }
+  })
+}
+
+# ---------------------------------------------------------------- Schedule
+
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "scheduler" {
+  name               = "billing-export-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+resource "aws_iam_role_policy" "scheduler_submit" {
+  name = "submit-job"
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect = "Allow"
+      Action = ["batch:SubmitJob"]
+      Resource = [
+        aws_batch_job_queue.export.arn,
+        "${aws_batch_job_definition.export.arn_prefix}:*",
+      ]
+    }]
+  })
+}
+
+resource "aws_scheduler_schedule" "monthly" {
+  name                         = "billing-export-monthly"
+  schedule_expression          = "cron(0 3 1 * ? *)"
+  schedule_expression_timezone = "Europe/Berlin"
+
+  flexible_time_window {
+    mode = "OFF"
+  }
+
+  target {
+    arn      = "arn:aws:scheduler:::aws-sdk:batch:submitJob"
+    role_arn = aws_iam_role.scheduler.arn
+    input = jsonencode({
+      JobName       = "billing-export"
+      JobQueue      = aws_batch_job_queue.export.arn
+      JobDefinition = aws_batch_job_definition.export.arn
+      ArrayProperties = { Size = local.task_count }
+    })
+    retry_policy {
+      maximum_retry_attempts = 0
+    }
+  }
+}
