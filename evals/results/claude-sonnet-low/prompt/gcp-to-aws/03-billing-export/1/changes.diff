+def run_query(sql):
+    """Run one Athena statement to completion and return its query execution id."""
+    for attempt in range(COMMIT_RETRIES):
+        qid = athena.start_query_execution(QueryString=sql, WorkGroup=WORKGROUP)["QueryExecutionId"]
+        while True:
+            st = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+            if st["State"] in ("SUCCEEDED", "FAILED", "CANCELLED"):
+                break
+            time.sleep(2)
+        if st["State"] == "SUCCEEDED":
+            return qid
+        reason = st.get("StateChangeReason", "")
+        # 16 tasks MERGE concurrently; Iceberg optimistic commits can conflict, so retry those.
+        if "ICEBERG_COMMIT_ERROR" in reason or "conflict" in reason.lower():
+            time.sleep(min(2 ** attempt, 30))
+            continue
+        raise RuntimeError(f"Athena query {st['State']}: {reason}")
+    raise RuntimeError("Athena query kept hitting commit conflicts")
+
+
+def convert(value, type_name):
+    if value is None:
+        return None
+    if type_name in ("tinyint", "smallint", "integer", "bigint"):
+        return int(value)
+    if type_name in ("double", "float", "real"):
+        return float(value)
+    if type_name == "boolean":
+        return value == "true"
+    return value
+
+
+def fetch_rows(qid):
+    """Yield rows as dicts with native Python types, like BigQuery rows."""
+    first = True
+    cols = None
+    for page in athena.get_paginator("get_query_results").paginate(QueryExecutionId=qid):
+        if cols is None:
+            cols = [(c["Name"], c["Type"]) for c in page["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]]
+        rows = page["ResultSet"]["Rows"]
+        if first:
+            rows = rows[1:]  # header row
+            first = False
+        for row in rows:
+            yield {
+                name: convert(d.get("VarCharValue"), typ)
+                for (name, typ), d in zip(cols, row["Data"])
+            }
+
+
+def shard_of(account_id):
+    """MOD(ABS(FARM_FINGERPRINT(account_id)), shards); None (SQL NULL) matches no shard."""
