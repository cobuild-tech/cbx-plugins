+def convert(value, typ):
+    if value is None:
+        return None
+    if typ in ("tinyint", "smallint", "integer", "bigint"):
+        return int(value)
+    if typ in ("real", "double", "float"):
+        return float(value)
+    if typ == "decimal":
+        return Decimal(value)
+    if typ == "boolean":
+        return value == "true"
+    return value
+
+
+def fetch_rows(qid):
+    """Yield dict rows (column order preserved) from a finished SELECT."""
+    first = True
+    cols = None
+    for page in athena.get_paginator("get_query_results").paginate(QueryExecutionId=qid):
+        if cols is None:
+            cols = [(c["Name"], c["Type"]) for c in page["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]]
+        for raw in page["ResultSet"]["Rows"]:
+            if first:  # first row of the first page is the header
+                first = False
+                continue
+            yield {n: convert(d.get("VarCharValue"), t) for (n, t), d in zip(cols, raw["Data"])}
+
