+            names = [c["Name"] for c in page["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]]
+        for row in page["ResultSet"]["Rows"]:
+            if first:  # header row, only on the first page
+                first = False
+                continue
+            rows.append([d.get("VarCharValue") for d in row["Data"]])
+    return names, types or [], rows
+
+
+def convert(value, typ):
+    if value is None:
+        return None
+    if typ in ("tinyint", "smallint", "integer", "bigint"):
+        return int(value)
+    return value
 
 
