diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..b0a22d3
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,384 @@
+terraform {
+  required_providers {
+    aws    = { source = "hashicorp/aws", version = "~> 5.0" }
+    random = { source = "hashicorp/random", version = "~> 3.0" }
+  }
+}
+
+# europe-west1 (Belgium) has no AWS equivalent; eu-west-1 (Ireland) is the nearest EU region.
+provider "aws" {
+  region = "eu-west-1"
+}
+
+variable "lake_bucket" {
+  type        = string
+  description = "Existing S3 bucket holding the Iceberg tables billing.invoices and billing.invoice_snapshots"
+}
+
+data "aws_caller_identity" "current" {}
+data "aws_region" "current" {}
+
+locals {
+  account_id  = data.aws_caller_identity.current.account_id
+  region      = data.aws_region.current.name
+  job_name    = "billing-export"
+  array_size  = 16 # Cloud Run task_count
+  parallelism = 4  # Cloud Run parallelism, enforced via compute environment max_vcpus
+  vcpu        = 2
+}
+
+# ---------------------------------------------------------------- network (default VPC, like the GCP connector's "default" network)
+
+data "aws_vpc" "default" {
+  default = true
+}
+
+data "aws_subnets" "default" {
+  filter {
+    name   = "vpc-id"
+    values = [data.aws_vpc.default.id]
+  }
+}
+
+resource "aws_security_group" "job" {
+  name   = "billing-export-job"
+  vpc_id = data.aws_vpc.default.id
+
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"] # partner API is public; Redis is reached privately
+  }
+}
+
+resource "aws_security_group" "redis" {
+  name   = "export-dedupe-redis"
+  vpc_id = data.aws_vpc.default.id
+
+  ingress {
+    from_port       = 6379
+    to_port         = 6379
+    protocol        = "tcp"
+    security_groups = [aws_security_group.job.id]
+  }
+}
+
+# ---------------------------------------------------------------- secrets
+
+resource "aws_secretsmanager_secret" "partner_api_key" {
+  name = "partner-api-key"
+}
+
+resource "random_password" "redis_auth" {
+  length  = 32
+  special = false
+}
+
+resource "aws_secretsmanager_secret" "redis_auth" {
+  name = "export-dedupe-auth"
+}
+
+resource "aws_secretsmanager_secret_version" "redis_auth" {
+  secret_id     = aws_secretsmanager_secret.redis_auth.id
+  secret_string = random_password.redis_auth.result
+}
+
+# ---------------------------------------------------------------- redis (dedupe)
+
+resource "aws_elasticache_subnet_group" "dedupe" {
+  name       = "export-dedupe"
+  subnet_ids = data.aws_subnets.default.ids
+}
+
+resource "aws_elasticache_replication_group" "dedupe" {
+  replication_group_id       = "export-dedupe" # STANDARD_HA: primary + replica, automatic failover
+  description                = "Billing export dedupe"
+  engine                     = "redis"
+  engine_version             = "7.0"
+  node_type                  = "cache.t4g.small" # smallest class comfortably above 1 GB
+  port                       = 6379
+  num_cache_clusters         = 2
+  automatic_failover_enabled = true
+  multi_az_enabled           = true
+  subnet_group_name          = aws_elasticache_subnet_group.dedupe.name
+  security_group_ids         = [aws_security_group.redis.id]
+  transit_encryption_enabled = true
+  auth_token                 = random_password.redis_auth.result
+}
+
+# ---------------------------------------------------------------- export bucket
+
+resource "aws_s3_bucket" "exports" {
+  bucket              = "${local.account_id}-billing-exports"
+  object_lock_enabled = true
+}
+
+resource "aws_s3_bucket_ownership_controls" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule { object_ownership = "BucketOwnerEnforced" } # uniform bucket-level access
+}
+
+resource "aws_s3_bucket_public_access_block" "exports" {
+  bucket                  = aws_s3_bucket.exports.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_versioning" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  versioning_configuration { status = "Enabled" } # required by Object Lock
+}
+
+# 7 years (220752000s = 2555 days). COMPLIANCE mode == is_locked = true: cannot be shortened or removed by anyone.
+resource "aws_s3_bucket_object_lock_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    default_retention {
+      mode = "COMPLIANCE"
+      days = 2555
+    }
+  }
+  depends_on = [aws_s3_bucket_versioning.exports]
+}
+
+# Autoclass -> Intelligent-Tiering from day 0
+resource "aws_s3_bucket_lifecycle_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    id     = "autoclass"
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 0
+      storage_class = "INTELLIGENT_TIERING"
+    }
+  }
+}
+
+# ---------------------------------------------------------------- athena (replaces BigQuery)
+
+resource "aws_s3_bucket" "athena_results" {
+  bucket = "${local.account_id}-billing-athena-results"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena_results" {
+  bucket                  = aws_s3_bucket.athena_results.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_glue_catalog_database" "billing" {
+  name = "billing"
+}
+
+resource "aws_athena_workgroup" "billing" {
+  name = "billing-export"
+  configuration {
+    enforce_workgroup_configuration = true
+    engine_version { selected_engine_version = "Athena engine version 3" }
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena_results.bucket}/export/"
+    }
+  }
+}
+
+# ---------------------------------------------------------------- iam
+
+data "aws_iam_policy_document" "ecs_tasks_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+# Task role: what the job code itself may do (the GCP service account)
+resource "aws_iam_role" "export" {
+  name               = "billing-export"
+  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_assume.json
+}
+
+data "aws_iam_policy_document" "export" {
+  statement {
+    actions   = ["s3:PutObject"]
+    resources = ["${aws_s3_bucket.exports.arn}/invoices/*"]
+  }
+  statement {
+    actions = ["athena:StartQueryExecution", "athena:GetQueryExecution", "athena:GetQueryResults"]
+    resources = [aws_athena_workgroup.billing.arn]
+  }
+  statement {
+    actions = ["glue:GetDatabase", "glue:GetTable", "glue:GetTables", "glue:GetPartitions", "glue:UpdateTable"]
+    resources = [
+      "arn:aws:glue:${local.region}:${local.account_id}:catalog",
+      aws_glue_catalog_database.billing.arn,
+      "arn:aws:glue:${local.region}:${local.account_id}:table/${aws_glue_catalog_database.billing.name}/*",
+    ]
+  }
+  statement {
+    actions = ["s3:GetObject", "s3:PutObject", "s3:DeleteObject", "s3:ListBucket", "s3:GetBucketLocation"]
+    resources = [
+      "arn:aws:s3:::${var.lake_bucket}", "arn:aws:s3:::${var.lake_bucket}/*",
+      aws_s3_bucket.athena_results.arn, "${aws_s3_bucket.athena_results.arn}/*",
+    ]
+  }
+}
+
+resource "aws_iam_role_policy" "export" {
+  role   = aws_iam_role.export.id
+  policy = data.aws_iam_policy_document.export.json
+}
+
+# Execution role: pulls the image, writes logs, injects secrets (secretAccessor equivalent)
+resource "aws_iam_role" "execution" {
+  name               = "billing-export-execution"
+  assume_role_policy = data.aws_iam_policy_document.ecs_tasks_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "execution" {
+  role       = aws_iam_role.execution.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+resource "aws_iam_role_policy" "execution_reads_secrets" {
+  role = aws_iam_role.execution.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["secretsmanager:GetSecretValue"]
+      Resource = [aws_secretsmanager_secret.partner_api_key.arn, aws_secretsmanager_secret.redis_auth.arn]
+    }]
+  })
+}
+
+# ---------------------------------------------------------------- job (Batch array job replaces Cloud Run job tasks)
+
+resource "aws_ecr_repository" "job" {
+  name = "jobs/billing-export"
+}
+
+resource "aws_cloudwatch_log_group" "job" {
+  name = "/aws/batch/billing-export"
+}
+
+resource "aws_batch_compute_environment" "export" {
+  compute_environment_name = "billing-export"
+  type                     = "MANAGED"
+
+  compute_resources {
+    type               = "FARGATE"
+    max_vcpus          = local.parallelism * local.vcpu # caps concurrency at 4 tasks
+    subnets            = data.aws_subnets.default.ids
+    security_group_ids = [aws_security_group.job.id]
+  }
+}
+
+resource "aws_batch_job_queue" "export" {
+  name     = "billing-export"
+  state    = "ENABLED"
+  priority = 1
+  compute_environment_order {
+    order               = 1
+    compute_environment = aws_batch_compute_environment.export.arn
+  }
+}
+
+resource "aws_batch_job_definition" "export" {
+  name                  = local.job_name
+  type                  = "container"
+  platform_capabilities = ["FARGATE"]
+
+  retry_strategy { attempts = 3 } # max_retries = 2
+
+  timeout { attempt_duration_seconds = 10800 }
+
+  container_properties = jsonencode({
+    image            = "${aws_ecr_repository.job.repository_url}:latest"
+    executionRoleArn = aws_iam_role.execution.arn
+    jobRoleArn       = aws_iam_role.export.arn
+    resourceRequirements = [
+      { type = "VCPU", value = tostring(local.vcpu) },
+      { type = "MEMORY", value = "4096" },
+    ]
+    networkConfiguration = { assignPublicIp = "ENABLED" } # direct internet egress for the partner API
+    fargatePlatformConfiguration = { platformVersion = "LATEST" }
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        "awslogs-group"         = aws_cloudwatch_log_group.job.name
+        "awslogs-region"        = local.region
+        "awslogs-stream-prefix" = "export"
+      }
+    }
+    secrets = [
+      { name = "PARTNER_API_KEY", valueFrom = aws_secretsmanager_secret.partner_api_key.arn },
+      { name = "REDIS_AUTH", valueFrom = aws_secretsmanager_secret.redis_auth.arn },
+    ]
+    environment = [
+      { name = "REDIS_HOST", value = aws_elasticache_replication_group.dedupe.primary_endpoint_address },
+      { name = "REDIS_PORT", value = "6379" },
+      { name = "EXPORT_BUCKET", value = aws_s3_bucket.exports.bucket },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.billing.name },
+      { name = "ATHENA_DATABASE", value = aws_glue_catalog_database.billing.name },
+      { name = "TASK_COUNT", value = tostring(local.array_size) },
+    ]
+  })
+}
+
+# ---------------------------------------------------------------- schedule
+
+resource "aws_iam_role" "scheduler" {
+  name = "billing-export-scheduler"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Action    = "sts:AssumeRole"
+      Principal = { Service = "scheduler.amazonaws.com" }
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect = "Allow"
+      Action = ["batch:SubmitJob"]
+      Resource = [
+        aws_batch_job_queue.export.arn,
+        "arn:aws:batch:${local.region}:${local.account_id}:job-definition/${local.job_name}",
+        "arn:aws:batch:${local.region}:${local.account_id}:job-definition/${local.job_name}:*",
+        "arn:aws:batch:${local.region}:${local.account_id}:job/*",
+      ]
+    }]
+  })
+}
+
+resource "aws_scheduler_schedule" "monthly" {
+  name                         = "billing-export-monthly"
+  schedule_expression          = "cron(0 3 1 * ? *)"
+  schedule_expression_timezone = "Europe/Berlin"
+
+  flexible_time_window { mode = "OFF" }
+
+  target {
+    arn      = "arn:aws:scheduler:::aws-sdk:batch:submitJob"
+    role_arn = aws_iam_role.scheduler.arn
+    input = jsonencode({
+      JobName       = local.job_name
+      JobQueue      = aws_batch_job_queue.export.arn
+      JobDefinition = aws_batch_job_definition.export.arn
+      ArrayProperties = { Size = local.array_size }
+    })
+  }
+}
