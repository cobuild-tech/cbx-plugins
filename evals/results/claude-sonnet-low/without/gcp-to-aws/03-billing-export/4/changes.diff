+-- Athena (engine v3) / Iceberg. Snapshot invoices for last calendar month (Berlin time), as they were at the end of the month.
+-- Requires billing.invoices and billing.invoice_snapshots to be Iceberg tables (MERGE + time travel).
+-- Iceberg timestamps are tz-less and treated as UTC, hence the explicit with_timezone(..., 'UTC') below.
+-- month_start = first day of previous month in Berlin; it is inlined because Athena has no DECLARE / multi-statement.
+MERGE INTO billing.invoice_snapshots AS s
+USING (
+  SELECT invoice_id, account_id, amount_cents, currency, status, updated_at
+  FROM billing.invoices
+  FOR TIMESTAMP AS OF date_trunc('month', current_timestamp AT TIME ZONE 'Europe/Berlin')
+  WHERE CAST(at_timezone(with_timezone(issued_at, 'UTC'), 'Europe/Berlin') AS DATE)
+          >= CAST(date_trunc('month', current_timestamp AT TIME ZONE 'Europe/Berlin') - INTERVAL '1' MONTH AS DATE)
+    AND CAST(at_timezone(with_timezone(issued_at, 'UTC'), 'Europe/Berlin') AS DATE)
+          < CAST(date_trunc('month', current_timestamp AT TIME ZONE 'Europe/Berlin') AS DATE)
+) AS i
+ON s.invoice_id = i.invoice_id
+WHEN MATCHED THEN UPDATE SET status = i.status, amount_cents = i.amount_cents, updated_at = i.updated_at
+WHEN NOT MATCHED THEN INSERT (invoice_id, account_id, amount_cents, currency, status, updated_at)
+  VALUES (i.invoice_id, i.account_id, i.amount_cents, i.currency, i.status, i.updated_at)
diff --git a/sql/invoices_select.sql b/sql/invoices_select.sql
new file mode 100644
index 0000000..c06d70b
--- /dev/null
+++ b/sql/invoices_select.sql
@@ -0,0 +1,8 @@
+-- Positional parameters: 1 = shards, 2 = shard.
+-- xxhash64 replaces FARM_FINGERPRINT (no Athena equivalent), so account->shard assignment differs from GCP.
+-- abs(x % n) avoids abs() overflow on the minimum bigint.
+SELECT invoice_id, account_id, amount_cents, currency, status
+FROM billing.invoice_snapshots
+WHERE abs(from_big_endian_64(xxhash64(to_utf8(account_id))) % ?) = ?
+  AND CAST(at_timezone(with_timezone(updated_at, 'UTC'), 'Europe/Berlin') AS DATE)
+        >= CAST(date_trunc('month', current_timestamp AT TIME ZONE 'Europe/Berlin') - INTERVAL '1' MONTH AS DATE)
