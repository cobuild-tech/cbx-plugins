+-- Athena (engine v3), Iceberg tables. Run once per export, before the shard queries.
+-- Invoices for last calendar month (Berlin time), as they were at the end of the month.
+-- Placeholders are filled by job/export.py from a computed date (never from user input):
+--   {month_start}      first day of last month in Europe/Berlin, YYYY-MM-DD
+--   {next_month_start} first day of the following month, YYYY-MM-DD
+MERGE INTO billing.invoice_snapshots AS s
+USING (
+  SELECT invoice_id, account_id, amount_cents, currency, status, updated_at
+  FROM billing.invoices
+  FOR TIMESTAMP AS OF with_timezone(TIMESTAMP '{next_month_start} 00:00:00', 'Europe/Berlin')
+  WHERE CAST(at_timezone(issued_at, 'Europe/Berlin') AS date) >= DATE '{month_start}'
+    AND CAST(at_timezone(issued_at, 'Europe/Berlin') AS date) < DATE '{next_month_start}'
+) AS i
+ON s.invoice_id = i.invoice_id
+WHEN MATCHED THEN UPDATE SET status = i.status, amount_cents = i.amount_cents, updated_at = i.updated_at
+WHEN NOT MATCHED THEN INSERT (invoice_id, account_id, amount_cents, currency, status, updated_at)
+  VALUES (i.invoice_id, i.account_id, i.amount_cents, i.currency, i.status, i.updated_at)
