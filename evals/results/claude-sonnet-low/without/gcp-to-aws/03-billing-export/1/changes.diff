+def run_query(sql):
+    qid = athena.start_query_execution(QueryString=sql, WorkGroup=WORKGROUP)["QueryExecutionId"]
+    delay = 1
+    while True:
+        status = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+        if status["State"] in ("SUCCEEDED", "FAILED", "CANCELLED"):
+            break
+        time.sleep(delay)
+        delay = min(delay * 2, 10)
+    if status["State"] != "SUCCEEDED":
+        raise RuntimeError(f"Athena query {status['State']}: {status.get('StateChangeReason')}")
+    return qid
+
+
+def fetch_rows(qid):
+    """Yield dicts with values converted per Athena column types."""
+    first = True
+    cols = types = None
+    for page in athena.get_paginator("get_query_results").paginate(QueryExecutionId=qid):
+        if first:
+            info = page["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]
+            cols = [c["Name"] for c in info]
+            types = [c["Type"] for c in info]
+        for i, row in enumerate(page["ResultSet"]["Rows"]):
+            if first and i == 0:
+                continue  # header row
+            vals = []
+            for t, d in zip(types, row["Data"]):
+                v = d.get("VarCharValue")
+                if v is not None and t in ("bigint", "integer", "smallint", "tinyint"):
+                    v = int(v)
+                vals.append(v)
+            yield dict(zip(cols, vals))
+        first = False
 
 
