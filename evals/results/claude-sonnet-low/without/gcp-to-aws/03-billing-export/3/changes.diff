index 0000000..21de6b9
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,419 @@
+terraform {
+  required_providers {
+    aws    = { source = "hashicorp/aws", version = "~> 5.0" }
+    random = { source = "hashicorp/random", version = "~> 3.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+variable "region" {
+  type    = string
+  default = "eu-west-1" # closest to europe-west1; use eu-central-1 if you prefer Frankfurt
+}
+variable "name_prefix" {
+  type        = string
+  description = "Used to make globally unique bucket names (GCP used the project id)."
+}
+variable "vpc_id" { type = string }
+variable "subnet_ids" {
+  type        = list(string)
+  description = "Private subnets with NAT egress (partner API is reached over the internet, as with PRIVATE_RANGES_ONLY)."
+}
+variable "data_bucket_arn" {
+  type        = string
+  description = "S3 bucket holding the Iceberg tables billing.invoices and billing.invoice_snapshots (migrated from BigQuery)."
+}
+
+data "aws_caller_identity" "current" {}
+
+locals {
+  task_count  = 16
+  parallelism = 4
+  vcpu        = 2
+  memory_mb   = 4096
+}
+
+# ---------------------------------------------------------------- secrets
+
+resource "aws_secretsmanager_secret" "partner_api_key" {
+  name = "partner-api-key"
+}
+
+resource "random_password" "redis_auth" {
+  length  = 32
+  special = false
+}
+
+resource "aws_secretsmanager_secret" "redis_auth" {
+  name = "export-dedupe-redis-auth"
+}
+
+resource "aws_secretsmanager_secret_version" "redis_auth" {
+  secret_id     = aws_secretsmanager_secret.redis_auth.id
+  secret_string = random_password.redis_auth.result
+}
+
+# ---------------------------------------------------------------- network + redis
+
+resource "aws_security_group" "job" {
+  name   = "billing-export-job"
+  vpc_id = var.vpc_id
+  egress {
+    from_port   = 0
+    to_port     = 0
+    protocol    = "-1"
+    cidr_blocks = ["0.0.0.0/0"]
+  }
+}
+
+resource "aws_security_group" "redis" {
+  name   = "export-dedupe-redis"
+  vpc_id = var.vpc_id
+  ingress {
+    from_port       = 6379
+    to_port         = 6379
+    protocol        = "tcp"
+    security_groups = [aws_security_group.job.id]
+  }
+}
+
+resource "aws_elasticache_subnet_group" "dedupe" {
+  name       = "export-dedupe"
+  subnet_ids = var.subnet_ids
+}
+
+resource "aws_elasticache_replication_group" "dedupe" {
+  replication_group_id       = "export-dedupe"
+  description                = "Billing export invoice dedupe"
+  engine                     = "redis"
+  engine_version             = "7.0"
+  node_type                  = "cache.t4g.small" # ~1.4 GiB, closest to 1 GB
+  num_cache_clusters         = 2                 # STANDARD_HA equivalent
+  automatic_failover_enabled = true
+  multi_az_enabled           = true
+  port                       = 6379
+  subnet_group_name          = aws_elasticache_subnet_group.dedupe.name
+  security_group_ids         = [aws_security_group.redis.id]
+  transit_encryption_enabled = true
+  at_rest_encryption_enabled = true
+  auth_token                 = random_password.redis_auth.result
+}
+
+# ---------------------------------------------------------------- export bucket
+
+resource "aws_s3_bucket" "exports" {
+  bucket              = "${var.name_prefix}-billing-exports"
+  object_lock_enabled = true
+}
+
+resource "aws_s3_bucket_ownership_controls" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule { object_ownership = "BucketOwnerEnforced" } # uniform bucket-level access
+}
+
+resource "aws_s3_bucket_public_access_block" "exports" {
+  bucket                  = aws_s3_bucket.exports.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_versioning" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  versioning_configuration { status = "Enabled" } # required by Object Lock
+}
+
+resource "aws_s3_bucket_server_side_encryption_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    apply_server_side_encryption_by_default { sse_algorithm = "AES256" }
+  }
+}
+
+# WARNING: COMPLIANCE mode is irreversible, like is_locked = true on GCS.
+# No one (including root) can shorten or remove retention once objects are written.
+resource "aws_s3_bucket_object_lock_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    default_retention {
+      mode = "COMPLIANCE"
+      days = 2555 # 220752000 s = 7 years
+    }
+  }
+  depends_on = [aws_s3_bucket_versioning.exports]
+}
+
+# Autoclass equivalent
+resource "aws_s3_bucket_lifecycle_configuration" "exports" {
+  bucket = aws_s3_bucket.exports.id
+  rule {
+    id     = "intelligent-tiering"
+    status = "Enabled"
+    filter {}
+    transition {
+      days          = 0
+      storage_class = "INTELLIGENT_TIERING"
+    }
+  }
+}
+
+# ---------------------------------------------------------------- athena
+
+resource "aws_s3_bucket" "athena_results" {
+  bucket = "${var.name_prefix}-billing-athena-results"
+}
+
+resource "aws_s3_bucket_public_access_block" "athena_results" {
+  bucket                  = aws_s3_bucket.athena_results.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+resource "aws_s3_bucket_lifecycle_configuration" "athena_results" {
+  bucket = aws_s3_bucket.athena_results.id
+  rule {
+    id     = "expire"
+    status = "Enabled"
+    filter {}
+    expiration { days = 7 }
+  }
+}
+
+resource "aws_athena_workgroup" "billing" {
+  name = "billing-export"
+  configuration {
+    enforce_workgroup_configuration = true
+    engine_version { selected_engine_version = "Athena engine version 3" }
+    result_configuration {
+      output_location = "s3://${aws_s3_bucket.athena_results.bucket}/"
+      encryption_configuration { encryption_option = "SSE_S3" }
+    }
+  }
+}
+
+# ---------------------------------------------------------------- iam
+
+data "aws_iam_policy_document" "ecs_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["ecs-tasks.amazonaws.com"]
+    }
+  }
+}
+
+# Task role = the GCP "export" service account
+resource "aws_iam_role" "export" {
+  name               = "billing-export"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+
+data "aws_iam_policy_document" "export" {
+  statement {
+    actions   = ["s3:PutObject"]
+    resources = ["${aws_s3_bucket.exports.arn}/invoices/*"]
+  }
+  statement {
+    actions = [
+      "athena:StartQueryExecution", "athena:GetQueryExecution",
+      "athena:GetQueryResults", "athena:StopQueryExecution", "athena:GetWorkGroup",
+    ]
+    resources = [aws_athena_workgroup.billing.arn]
+  }
+  statement {
+    actions = [
+      "glue:GetDatabase", "glue:GetDatabases", "glue:GetTable", "glue:GetTables",
+      "glue:GetPartitions", "glue:UpdateTable", # UpdateTable: Iceberg MERGE commits
+    ]
+    resources = ["*"]
+  }
+  statement {
+    actions = ["s3:GetObject", "s3:PutObject", "s3:ListBucket", "s3:GetBucketLocation", "s3:DeleteObject"]
+    resources = [
+      var.data_bucket_arn, "${var.data_bucket_arn}/*",
+      aws_s3_bucket.athena_results.arn, "${aws_s3_bucket.athena_results.arn}/*",
+    ]
+  }
+}
+
+resource "aws_iam_role_policy" "export" {
+  role   = aws_iam_role.export.id
+  policy = data.aws_iam_policy_document.export.json
+}
+
+# Execution role: pulls image, injects secrets
+resource "aws_iam_role" "execution" {
+  name               = "billing-export-execution"
+  assume_role_policy = data.aws_iam_policy_document.ecs_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "execution" {
+  role       = aws_iam_role.execution.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
+}
+
+resource "aws_iam_role_policy" "execution_secrets" {
+  role = aws_iam_role.execution.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = ["secretsmanager:GetSecretValue"]
+      Resource = [aws_secretsmanager_secret.partner_api_key.arn, aws_secretsmanager_secret.redis_auth.arn]
+    }]
+  })
+}
+
+# ---------------------------------------------------------------- job (AWS Batch on Fargate)
+
+resource "aws_ecr_repository" "job" {
+  name = "billing-export"
+}
+
+resource "aws_cloudwatch_log_group" "job" {
+  name = "/aws/batch/billing-export"
+}
+
+data "aws_iam_policy_document" "batch_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["batch.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "batch_service" {
+  name               = "billing-export-batch-service"
+  assume_role_policy = data.aws_iam_policy_document.batch_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "batch_service" {
+  role       = aws_iam_role.batch_service.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSBatchServiceRole"
+}
+
+# Batch has no per-job parallelism setting; capping max_vcpus at parallelism * vcpu
+# limits the array job to 4 concurrent tasks.
+resource "aws_batch_compute_environment" "export" {
+  compute_environment_name = "billing-export"
+  type                     = "MANAGED"
+  service_role             = aws_iam_role.batch_service.arn
+  compute_resources {
+    type               = "FARGATE"
+    max_vcpus          = local.parallelism * local.vcpu
+    subnets            = var.subnet_ids
+    security_group_ids = [aws_security_group.job.id]
+  }
+  depends_on = [aws_iam_role_policy_attachment.batch_service]
+}
+
+resource "aws_batch_job_queue" "export" {
+  name     = "billing-export"
+  state    = "ENABLED"
+  priority = 1
+  compute_environment_order {
+    order               = 1
+    compute_environment = aws_batch_compute_environment.export.arn
+  }
+}
+
+resource "aws_batch_job_definition" "export" {
+  name                  = "billing-export"
+  type                  = "container"
+  platform_capabilities = ["FARGATE"]
+
+  retry_strategy { attempts = 3 } # 1 try + max_retries 2
+
+  timeout { attempt_duration_seconds = 10800 }
+
+  container_properties = jsonencode({
+    image            = "${aws_ecr_repository.job.repository_url}:latest"
+    jobRoleArn       = aws_iam_role.export.arn
+    executionRoleArn = aws_iam_role.execution.arn
+    resourceRequirements = [
+      { type = "VCPU", value = tostring(local.vcpu) },
+      { type = "MEMORY", value = tostring(local.memory_mb) },
+    ]
+    networkConfiguration = { assignPublicIp = "DISABLED" }
+    logConfiguration = {
+      logDriver = "awslogs"
+      options = {
+        awslogs-group         = aws_cloudwatch_log_group.job.name
+        awslogs-region        = var.region
+        awslogs-stream-prefix = "export"
+      }
+    }
+    secrets = [
+      { name = "PARTNER_API_KEY", valueFrom = aws_secretsmanager_secret.partner_api_key.arn },
+      { name = "REDIS_AUTH", valueFrom = aws_secretsmanager_secret.redis_auth.arn },
+    ]
+    environment = [
+      { name = "REDIS_HOST", value = aws_elasticache_replication_group.dedupe.primary_endpoint_address },
+      { name = "EXPORT_BUCKET", value = aws_s3_bucket.exports.bucket },
+      { name = "TASK_COUNT", value = tostring(local.task_count) },
+      { name = "ATHENA_WORKGROUP", value = aws_athena_workgroup.billing.name },
+      { name = "ATHENA_DATABASE", value = "billing" },
+    ]
+  })
+}
+
+# ---------------------------------------------------------------- schedule
+
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "scheduler" {
+  name               = "billing-export-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect = "Allow"
+      Action = ["batch:SubmitJob"]
+      Resource = [
+        aws_batch_job_queue.export.arn,
+        "arn:aws:batch:${var.region}:${data.aws_caller_identity.current.account_id}:job-definition/${aws_batch_job_definition.export.name}",
+        "arn:aws:batch:${var.region}:${data.aws_caller_identity.current.account_id}:job-definition/${aws_batch_job_definition.export.name}:*",
+      ]
+    }]
+  })
+}
+
+resource "aws_scheduler_schedule" "monthly" {
+  name                         = "billing-export-monthly"
+  schedule_expression          = "cron(0 3 1 * ? *)"
+  schedule_expression_timezone = "Europe/Berlin"
+
+  flexible_time_window { mode = "OFF" }
+
+  target {
+    arn      = "arn:aws:scheduler:::aws-sdk:batch:submitJob"
+    role_arn = aws_iam_role.scheduler.arn
+    input = jsonencode({
+      JobName       = "billing-export"
+      JobQueue      = aws_batch_job_queue.export.arn
+      JobDefinition = aws_batch_job_definition.export.arn
+      ArrayProperties = { Size = local.task_count }
+    })
+  }
+}
