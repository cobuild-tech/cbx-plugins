+def run_query(sql, params=None, retries=0):
+    """Run an Athena query to completion and return its execution id."""
+    for attempt in range(retries + 1):
+        kwargs = dict(
+            QueryString=sql,
+            WorkGroup=WORKGROUP,
+            QueryExecutionContext={"Database": DATABASE},
+        )
+        if params:
+            kwargs["ExecutionParameters"] = [str(p) for p in params]
+        qid = athena.start_query_execution(**kwargs)["QueryExecutionId"]
+        while True:
+            status = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+            if status["State"] in ("SUCCEEDED", "FAILED", "CANCELLED"):
+                break
+            time.sleep(2)
+        if status["State"] == "SUCCEEDED":
+            return qid
+        if attempt < retries:
+            # Concurrent Iceberg MERGEs from sibling tasks can lose the commit race; the MERGE is idempotent.
+            time.sleep(5 * (attempt + 1))
+            continue
+        raise RuntimeError(f"Athena query {status['State']}: {status.get('StateChangeReason')}")
+
+
+def convert(value, typ):
+    if value is None:
+        return None
+    if typ in ("tinyint", "smallint", "integer", "bigint"):
+        return int(value)
+    if typ in ("float", "double", "real"):
+        return float(value)
+    if typ == "decimal":
+        return float(value)
+    if typ == "boolean":
+        return value == "true"
+    return value
+
+
+def fetch_rows(qid):
+    """Yield (columns, values) with values typed per Athena column metadata."""
+    first = True
+    cols = types = None
+    for page in athena.get_paginator("get_query_results").paginate(QueryExecutionId=qid):
+        if cols is None:
+            info = page["ResultSet"]["ResultSetMetadata"]["ColumnInfo"]
+            cols = [c["Name"] for c in info]
+            types = [c["Type"] for c in info]
+        for row in page["ResultSet"]["Rows"]:
+            if first:  # first row of the first page is the header
+                first = False
+                continue
+            vals = [convert(d.get("VarCharValue"), t) for d, t in zip(row["Data"], types)]
+            yield cols, vals
 
 
