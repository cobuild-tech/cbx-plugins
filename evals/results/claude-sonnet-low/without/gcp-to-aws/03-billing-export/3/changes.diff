+++ b/sql/merge_snapshots.sql
@@ -0,0 +1,20 @@
+-- Athena (engine v3) over Iceberg tables. Snapshot last calendar month's invoices (Berlin time)
+-- as they were at the end of the month. Athena can't DECLARE variables, so month_start is inlined.
+-- Requires billing.invoices and billing.invoice_snapshots to be Iceberg tables, and the
+-- invoices table's snapshot history to reach back to the start of the current month.
+MERGE INTO billing.invoice_snapshots AS s
+USING (
+  SELECT invoice_id, account_id, amount_cents, currency, status, updated_at
+  FROM billing.invoices
+    FOR TIMESTAMP AS OF with_timezone(
+      date_trunc('month', CAST(current_timestamp AT TIME ZONE 'Europe/Berlin' AS timestamp)),
+      'Europe/Berlin')
+  WHERE CAST(issued_at AT TIME ZONE 'Europe/Berlin' AS date) >=
+          date_add('month', -1, date_trunc('month', CAST(current_timestamp AT TIME ZONE 'Europe/Berlin' AS date)))
+    AND CAST(issued_at AT TIME ZONE 'Europe/Berlin' AS date) <
+          date_trunc('month', CAST(current_timestamp AT TIME ZONE 'Europe/Berlin' AS date))
+) AS i
+ON s.invoice_id = i.invoice_id
