+def run_query(sql, params=None, retries=0):
+    """Run an Athena query to completion and return its query execution id."""
+    for attempt in range(retries + 1):
+        kwargs = {"ExecutionParameters": [str(p) for p in params]} if params else {}
+        qid = athena.start_query_execution(
+            QueryString=sql,
+            WorkGroup=os.environ["ATHENA_WORKGROUP"],
+            QueryExecutionContext={"Database": os.environ["ATHENA_DATABASE"]},
+            **kwargs,
+        )["QueryExecutionId"]
+        while True:
+            status = athena.get_query_execution(QueryExecutionId=qid)["QueryExecution"]["Status"]
+            if status["State"] in ("SUCCEEDED", "FAILED", "CANCELLED"):
+                break
+            time.sleep(2)
+        if status["State"] == "SUCCEEDED":
+            return qid
+        if attempt == retries:
+            raise RuntimeError(f"Athena query {status['State']}: {status.get('StateChangeReason')}")
+        # Concurrent Iceberg MERGEs from sibling tasks can hit commit conflicts; the MERGE is idempotent.
+        time.sleep(5 * 2**attempt)
+
