--- /dev/null
+++ b/sql/invoices_merge.sql
@@ -0,0 +1,19 @@
+-- Athena engine v3 (Trino) over Iceberg tables. Snapshot last calendar month (Berlin time)
+-- of billing.invoices as it was at the end of that month, into billing.invoice_snapshots.
+-- Requires: both tables are Iceberg (time travel + MERGE); snapshot retention must cover the
+-- start of the current month (default Iceberg snapshot expiry is fine for a monthly job).
+MERGE INTO billing.invoice_snapshots AS s
+USING (
+  SELECT invoice_id, account_id, amount_cents, currency, status, updated_at
+  FROM billing.invoices
+    FOR TIMESTAMP AS OF (
+      CAST(date_add('month', 1, date_trunc('month', date_add('month', -1, CAST(current_timestamp AT TIME ZONE 'Europe/Berlin' AS date)))) AS timestamp)
+      AT TIME ZONE 'Europe/Berlin'
+    )
+  WHERE CAST(issued_at AT TIME ZONE 'Europe/Berlin' AS date) >= date_trunc('month', date_add('month', -1, CAST(current_timestamp AT TIME ZONE 'Europe/Berlin' AS date)))
+    AND CAST(issued_at AT TIME ZONE 'Europe/Berlin' AS date) < date_add('month', 1, date_trunc('month', date_add('month', -1, CAST(current_timestamp AT TIME ZONE 'Europe/Berlin' AS date))))
+) AS i
+ON s.invoice_id = i.invoice_id
+WHEN MATCHED THEN UPDATE SET status = i.status, amount_cents = i.amount_cents, updated_at = i.updated_at
+WHEN NOT MATCHED THEN INSERT (invoice_id, account_id, amount_cents, currency, status, updated_at)
+  VALUES (i.invoice_id, i.account_id, i.amount_cents, i.currency, i.status, i.updated_at)
