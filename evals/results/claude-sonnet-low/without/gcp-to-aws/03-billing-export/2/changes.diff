+            first = False
+        for row in data:
+            vals = [d.get("VarCharValue") for d in row["Data"]]
+            yield {
+                name: (None if v is None else int(v) if t in ("bigint", "integer", "smallint", "tinyint") else v)
+                for (name, t), v in zip(cols, vals)
+            }
 
 
