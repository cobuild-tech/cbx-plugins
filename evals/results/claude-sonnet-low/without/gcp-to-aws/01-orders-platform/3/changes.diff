-QUALIFY ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) <= 100;
+-- Athena (Trino) dialect. Statements are split on ';' and run in order by app/api.py.
+-- {location} is substituted per run (CTAS needs an empty S3 prefix).
+DROP TABLE IF EXISTS analytics.daily;
+
+CREATE TABLE analytics.daily
+WITH (format = 'PARQUET', external_location = '{location}') AS
+SELECT day, customer_id, amount, top_items, sessions
+FROM (
+  SELECT day, customer_id, amount, top_items, sessions,
+         ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rn
+  FROM (
+    SELECT CAST(date_trunc('day', o.created_at) AS date) AS day,
+           o.customer_id,
+           SUM(TRY_CAST(o.amount AS DECIMAL(38, 9))) AS amount,
+           slice(
+             array_agg(CAST(ROW(i.sku, i.qty) AS ROW(sku VARCHAR, qty BIGINT)) ORDER BY i.qty DESC),
+             1, 3) AS top_items,
+           approx_distinct(o.session_id) AS sessions
+    FROM analytics.orders o
+    CROSS JOIN UNNEST(o.items) AS i
+    -- assumes orders is Hive-partitioned by a DATE column `dt` (replaces BigQuery _PARTITIONDATE)
+    WHERE o.dt >= current_date - INTERVAL '1' DAY
+    GROUP BY 1, 2
+  )
+)
+WHERE rn <= 100;
