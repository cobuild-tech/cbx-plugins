diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..f03ba4a
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,230 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = "~> 5.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+variable "name_prefix" {
+  type        = string
+  description = "Globally-unique prefix for the bucket name (replaces the GCP project id)."
+}
+
+variable "region" {
+  type    = string
+  default = "us-east-2" # closest to us-central1
+}
+
+data "aws_caller_identity" "current" {}
+
+# ---------------------------------------------------------------- storage
+resource "aws_s3_bucket" "incoming" {
+  bucket = "${var.name_prefix}-media-incoming"
+}
+
+# Versioning gives every upload a version id, the equivalent of a GCS generation.
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration {
+    status = "Enabled"
+  }
+}
+
+resource "aws_s3_bucket_public_access_block" "incoming" {
+  bucket                  = aws_s3_bucket.incoming.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# ---------------------------------------------------------------- messaging
+# Pub/Sub topic -> SNS topic. SNS does not retain messages (Pub/Sub kept 7 days).
+resource "aws_sns_topic" "media_events" {
+  name = "media-events"
+}
+
+# Cloud Tasks queue -> EventBridge Scheduler (2h hold) -> SQS (retries, concurrency).
+resource "aws_sqs_queue" "transcode_dlq" {
+  name                      = "transcode-dlq"
+  message_retention_seconds = 1209600
+}
+
+resource "aws_sqs_queue" "transcode" {
+  name                       = "transcode"
+  visibility_timeout_seconds = 1800 # >= transcode Lambda timeout, spacing out retries
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.transcode_dlq.arn
+    maxReceiveCount     = 4 # max_attempts = 4
+  })
+}
+
+# ---------------------------------------------------------------- IAM
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "media" {
+  name               = "media-pipeline"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "logs" {
+  role       = aws_iam_role.media.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_iam_role" "scheduler" {
+  name = "media-pipeline-scheduler"
+  assume_role_policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Action    = "sts:AssumeRole"
+      Principal = { Service = "scheduler.amazonaws.com" }
+      Condition = { StringEquals = { "aws:SourceAccount" = data.aws_caller_identity.current.account_id } }
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = "sqs:SendMessage"
+      Resource = aws_sqs_queue.transcode.arn
+    }]
+  })
+}
+
+resource "aws_iam_role_policy" "media" {
+  role = aws_iam_role.media.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket"]
+        Resource = [aws_s3_bucket.incoming.arn, "${aws_s3_bucket.incoming.arn}/*"]
+      },
+      {
+        Effect   = "Allow"
+        Action   = "scheduler:CreateSchedule"
+        Resource = "*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = "iam:PassRole"
+        Resource = aws_iam_role.scheduler.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = "sns:Publish"
+        Resource = aws_sns_topic.media_events.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes"]
+        Resource = aws_sqs_queue.transcode.arn
+      },
+    ]
+  })
+}
+
+# ---------------------------------------------------------------- functions
+data "archive_file" "ingest" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/ingest"
+  output_path = "${path.module}/build/ingest.zip"
+}
+
+data "archive_file" "transcode" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/transcode"
+  output_path = "${path.module}/build/transcode.zip"
+}
+
+resource "aws_lambda_function" "ingest" {
+  function_name    = "media-ingest"
+  role             = aws_iam_role.media.arn
+  runtime          = "python3.12"
+  handler          = "main.on_upload"
+  filename         = data.archive_file.ingest.output_path
+  source_code_hash = data.archive_file.ingest.output_base64sha256
+  timeout          = 60
+
+  environment {
+    variables = {
+      TASKS_QUEUE_ARN    = aws_sqs_queue.transcode.arn
+      SCHEDULER_ROLE_ARN = aws_iam_role.scheduler.arn
+      EVENTS_TOPIC       = aws_sns_topic.media_events.arn
+    }
+  }
+}
+
+# RETRY_POLICY_DO_NOT_RETRY
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_lambda_function" "transcode" {
+  function_name    = "media-transcode"
+  role             = aws_iam_role.media.arn
+  runtime          = "python3.12"
+  handler          = "main.transcode"
+  filename         = data.archive_file.transcode.output_path
+  source_code_hash = data.archive_file.transcode.output_base64sha256
+  timeout          = 900 # Lambda hard limit; GCP function allowed 1800
+  memory_size      = 4096
+}
+
+# max_dispatches 3 concurrent; batch size 1 so each message is one job.
+resource "aws_lambda_event_source_mapping" "transcode" {
+  event_source_arn = aws_sqs_queue.transcode.arn
+  function_name    = aws_lambda_function.transcode.arn
+  batch_size       = 1
+
+  scaling_config {
+    maximum_concurrency = 3
+  }
+}
+
+# Fires on every new object and on every overwrite of an existing key.
+resource "aws_lambda_permission" "s3_invoke_ingest" {
+  statement_id   = "AllowS3Invoke"
+  action         = "lambda:InvokeFunction"
+  function_name  = aws_lambda_function.ingest.function_name
+  principal      = "s3.amazonaws.com"
+  source_arn     = aws_s3_bucket.incoming.arn
+  source_account = data.aws_caller_identity.current.account_id
+}
+
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+
+  depends_on = [aws_lambda_permission.s3_invoke_ingest]
+}
+
+# ---------------------------------------------------------------- analytics
+# BigQuery dataset -> Glue database queried by Athena.
+resource "aws_glue_catalog_database" "media" {
+  name = "media"
+}
