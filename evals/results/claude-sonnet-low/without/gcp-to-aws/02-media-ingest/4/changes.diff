diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..d5b35ab
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,251 @@
+terraform {
+  required_providers {
+    aws     = { source = "hashicorp/aws", version = "~> 5.0" }
+    archive = { source = "hashicorp/archive", version = "~> 2.0" }
+  }
+}
+
+provider "aws" {
+  region = var.region
+}
+
+variable "project_id" { type = string } # prefix for globally-unique bucket names
+variable "region" {
+  type    = string
+  default = "us-east-2" # nearest to GCP us-central1
+}
+
+data "aws_caller_identity" "current" {}
+
+# ---------------------------------------------------------------- storage
+
+resource "aws_s3_bucket" "incoming" {
+  bucket = "${var.project_id}-media-incoming"
+}
+
+# GCS "generation" -> S3 version id; versioning is required to tell a
+# replacement upload from the original.
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration { status = "Enabled" }
+}
+
+# Equivalent of uniform_bucket_level_access: no ACLs, no public access.
+resource "aws_s3_bucket_ownership_controls" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  rule { object_ownership = "BucketOwnerEnforced" }
+}
+
+resource "aws_s3_bucket_public_access_block" "incoming" {
+  bucket                  = aws_s3_bucket.incoming.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# ---------------------------------------------------------------- events
+
+resource "aws_sns_topic" "media_events" {
+  name = "media-events"
+}
+
+# Pub/Sub kept messages for 7 days; SNS does not retain, so a queue
+# subscribed to the topic holds them for the same period.
+resource "aws_sqs_queue" "media_events" {
+  name                      = "media-events"
+  message_retention_seconds = 604800
+}
+
+resource "aws_sns_topic_subscription" "media_events" {
+  topic_arn            = aws_sns_topic.media_events.arn
+  protocol             = "sqs"
+  endpoint             = aws_sqs_queue.media_events.arn
+  raw_message_delivery = true
+}
+
+resource "aws_sqs_queue_policy" "media_events" {
+  queue_url = aws_sqs_queue.media_events.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect    = "Allow"
+      Principal = { Service = "sns.amazonaws.com" }
+      Action    = "sqs:SendMessage"
+      Resource  = aws_sqs_queue.media_events.arn
+      Condition = { ArnEquals = { "aws:SourceArn" = aws_sns_topic.media_events.arn } }
+    }]
+  })
+}
+
+# ---------------------------------------------------------------- IAM
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+# Shared by both functions, like the single GCP service account.
+resource "aws_iam_role" "media" {
+  name               = "media-pipeline"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+# Identity EventBridge Scheduler uses to invoke the transcoder (the old
+# OIDC-token-to-Cloud-Functions step).
+resource "aws_iam_role" "scheduler" {
+  name               = "media-pipeline-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "logs" {
+  role       = aws_iam_role.media.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+resource "aws_iam_role_policy" "media" {
+  role = aws_iam_role.media.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [
+      {
+        # ListBucket so a missing object is a 404 (stale) rather than a 403.
+        Effect   = "Allow"
+        Action   = ["s3:GetObject", "s3:GetObjectVersion", "s3:ListBucket"]
+        Resource = [aws_s3_bucket.incoming.arn, "${aws_s3_bucket.incoming.arn}/*"]
+      },
+      {
+        Effect   = "Allow"
+        Action   = "sns:Publish"
+        Resource = aws_sns_topic.media_events.arn
+      },
+      {
+        Effect   = "Allow"
+        Action   = "scheduler:CreateSchedule"
+        Resource = "arn:aws:scheduler:${var.region}:${data.aws_caller_identity.current.account_id}:schedule/default/*"
+      },
+      {
+        Effect   = "Allow"
+        Action   = "iam:PassRole"
+        Resource = aws_iam_role.scheduler.arn
+      },
+    ]
+  })
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = "lambda:InvokeFunction"
+      Resource = aws_lambda_function.transcode.arn
+    }]
+  })
+}
+
+# ---------------------------------------------------------------- functions
+
+data "archive_file" "ingest" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/ingest"
+  output_path = "${path.module}/build/ingest.zip"
+}
+
+data "archive_file" "transcode" {
+  type        = "zip"
+  source_dir  = "${path.module}/../functions/transcode"
+  output_path = "${path.module}/build/transcode.zip"
+}
+
+resource "aws_lambda_function" "transcode" {
+  function_name    = "media-transcode"
+  role             = aws_iam_role.media.arn
+  runtime          = "python3.12"
+  handler          = "main.transcode"
+  filename         = data.archive_file.transcode.output_path
+  source_code_hash = data.archive_file.transcode.output_base64sha256
+  # NOTE: Lambda's hard limit is 900s; the GCP function ran up to 1800s.
+  timeout     = 900
+  memory_size = 4096
+
+  # Cloud Tasks max_concurrent_dispatches = 3.
+  reserved_concurrent_executions = 3
+}
+
+# Cloud Tasks retry_config max_attempts = 4 -> 1 try + retries. Lambda async
+# allows at most 2 retries; backoff is fixed by Lambda (not 30s..600s).
+resource "aws_lambda_function_event_invoke_config" "transcode" {
+  function_name          = aws_lambda_function.transcode.function_name
+  maximum_retry_attempts = 2
+  # Throttled (concurrency cap) invokes are re-queued for up to this long.
+  maximum_event_age_in_seconds = 21600
+}
+
+# Fires on every new object and on every overwrite of an existing name.
+resource "aws_lambda_function" "ingest" {
+  function_name    = "media-ingest"
+  role             = aws_iam_role.media.arn
+  runtime          = "python3.12"
+  handler          = "main.on_upload"
+  filename         = data.archive_file.ingest.output_path
+  source_code_hash = data.archive_file.ingest.output_base64sha256
+  timeout          = 60
+
+  environment {
+    variables = {
+      TRANSCODE_FUNCTION_ARN = aws_lambda_function.transcode.arn
+      SCHEDULER_ROLE_ARN     = aws_iam_role.scheduler.arn
+      EVENTS_TOPIC           = aws_sns_topic.media_events.arn
+    }
+  }
+}
+
+# RETRY_POLICY_DO_NOT_RETRY
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_lambda_permission" "ingest_from_s3" {
+  statement_id   = "AllowS3Invoke"
+  action         = "lambda:InvokeFunction"
+  function_name  = aws_lambda_function.ingest.function_name
+  principal      = "s3.amazonaws.com"
+  source_arn     = aws_s3_bucket.incoming.arn
+  source_account = data.aws_caller_identity.current.account_id
+}
+
+# ObjectCreated:* covers new objects and overwrites (put/post/copy/multipart).
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+  depends_on = [aws_lambda_permission.ingest_from_s3]
+}
+
+# ---------------------------------------------------------------- analytics
+
+# BigQuery dataset -> Glue database (queried via Athena). The `uploads`
+# table is not defined in the original Terraform either.
+resource "aws_glue_catalog_database" "media" {
+  name = "media"
+}
