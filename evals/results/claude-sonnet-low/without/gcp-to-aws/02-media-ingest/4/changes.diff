--- Weekly editor report. Weeks run Sunday to Saturday, as the editors' schedule does.
+-- Weekly editor report (Athena / Trino). Weeks run Sunday to Saturday, as the editors' schedule does.
+-- Trino's date_trunc('week') starts on Monday, so shift by a day to get Sunday starts.
+-- Assumes uploaded_at is a UTC timestamp.
 SELECT
-  DATE_TRUNC(DATE(uploaded_at), WEEK) AS week_start,
+  date_add('day', -1, date_trunc('week', date_add('day', 1, DATE(uploaded_at)))) AS week_start,
   uploader,
   COUNT(*) AS uploads,
-  SAFE_DIVIDE(SUM(transcode_seconds), COUNT(*)) AS avg_transcode_s,
-  COUNTIF(EXTRACT(DAYOFWEEK FROM uploaded_at) IN (1, 7)) AS weekend_uploads
+  CAST(SUM(transcode_seconds) AS double) / COUNT(*) AS avg_transcode_s,
+  COUNT_IF(day_of_week(uploaded_at) IN (6, 7)) AS weekend_uploads  -- Sat, Sun (ISO: Mon=1)
 FROM media.uploads
-WHERE uploaded_at >= TIMESTAMP_SUB(CURRENT_TIMESTAMP(), INTERVAL 56 DAY)
-GROUP BY week_start, uploader
+WHERE uploaded_at >= current_timestamp - INTERVAL '56' DAY
