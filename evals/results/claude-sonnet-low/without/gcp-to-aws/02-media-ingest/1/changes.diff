--- Weekly editor report. Weeks run Sunday to Saturday, as the editors' schedule does.
+-- Weekly editor report (Athena / Trino). Weeks run Sunday to Saturday, as the editors' schedule does.
+-- Trino's date_trunc('week') starts on Monday, so shift by a day around it.
+-- Assumes uploaded_at is a UTC timestamp; Athena's session time zone is UTC.
 SELECT
-  DATE_TRUNC(DATE(uploaded_at), WEEK) AS week_start,
+  date_trunc('week', CAST(uploaded_at AS date) + INTERVAL '1' DAY) - INTERVAL '1' DAY AS week_start,
