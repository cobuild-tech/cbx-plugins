diff --git a/sql/weekly_report.athena.sql b/sql/weekly_report.athena.sql
new file mode 100644
index 0000000..2fa54bd
--- /dev/null
+++ b/sql/weekly_report.athena.sql
@@ -0,0 +1,14 @@
+-- Weekly editor report (Athena / Trino). Weeks run Sunday to Saturday, as the editors' schedule does.
+-- Trino's date_trunc('week') starts on Monday, so shift by a day to anchor on Sunday.
+-- Trino day_of_week is ISO (Mon=1 .. Sun=7), so weekend = 6, 7 (BigQuery's 1, 7).
+-- Assumes uploaded_at is a UTC timestamp and the Athena session time zone is UTC (the default).
+SELECT
+  date_add('day', -1, date_trunc('week', date_add('day', 1, DATE(uploaded_at)))) AS week_start,
+  uploader,
+  COUNT(*) AS uploads,
+  CAST(SUM(transcode_seconds) AS double) / COUNT(*) AS avg_transcode_s,
+  COUNT_IF(day_of_week(uploaded_at) IN (6, 7)) AS weekend_uploads
+FROM media.uploads
+WHERE uploaded_at >= date_add('day', -56, current_timestamp)
+GROUP BY 1, 2
+ORDER BY week_start DESC, uploads DESC;
