diff --git a/aws/main.tf b/aws/main.tf
new file mode 100644
index 0000000..520a15c
--- /dev/null
+++ b/aws/main.tf
@@ -0,0 +1,230 @@
+terraform {
+  required_providers {
+    aws = { source = "hashicorp/aws", version = "~> 5.0" }
+  }
+}
+
+provider "aws" {
+  region = "us-east-1"
+}
+
+variable "name_prefix" {
+  type        = string
+  description = "Prefix for globally unique bucket names (replaces the GCP project id)"
+}
+
+# Existing bucket holding the function zips (ingest.zip, transcode.zip), as on GCP.
+variable "fn_src_bucket" {
+  type    = string
+  default = null
+}
+
+locals {
+  fn_src_bucket = coalesce(var.fn_src_bucket, "${var.name_prefix}-fn-src")
+}
+
+data "aws_caller_identity" "current" {}
+
+resource "aws_s3_bucket" "incoming" {
+  bucket = "${var.name_prefix}-media-incoming"
+}
+
+# Versioning provides the GCS "generation" equivalent (S3 version id), which the
+# ingest/transcode pair uses to detect replaced files.
+resource "aws_s3_bucket_versioning" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  versioning_configuration {
+    status = "Enabled"
+  }
+}
+
+resource "aws_s3_bucket_public_access_block" "incoming" {
+  bucket                  = aws_s3_bucket.incoming.id
+  block_public_acls       = true
+  block_public_policy     = true
+  ignore_public_acls      = true
+  restrict_public_buckets = true
+}
+
+# --- IAM (GCP service account "media-pipeline") ---
+
+data "aws_iam_policy_document" "lambda_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["lambda.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "media" {
+  name               = "media-pipeline"
+  assume_role_policy = data.aws_iam_policy_document.lambda_assume.json
+}
+
+resource "aws_iam_role_policy_attachment" "media_logs" {
+  role       = aws_iam_role.media.name
+  policy_arn = "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
+}
+
+data "aws_iam_policy_document" "media" {
+  statement {
+    actions   = ["s3:GetObject", "s3:GetObjectVersion", "s3:GetObjectAttributes"]
+    resources = ["${aws_s3_bucket.incoming.arn}/*"]
+  }
+  statement {
+    # ListBucket makes a missing key return 404 instead of 403.
+    actions   = ["s3:ListBucket"]
+    resources = [aws_s3_bucket.incoming.arn]
+  }
+  statement {
+    actions   = ["scheduler:CreateSchedule"]
+    resources = ["arn:aws:scheduler:*:${data.aws_caller_identity.current.account_id}:schedule/default/*"]
+  }
+  statement {
+    actions   = ["iam:PassRole"]
+    resources = [aws_iam_role.scheduler.arn]
+  }
+  statement {
+    actions   = ["sns:Publish"]
+    resources = [aws_sns_topic.media_events.arn]
+  }
+  statement {
+    actions = ["sqs:ReceiveMessage", "sqs:DeleteMessage", "sqs:GetQueueAttributes", "sqs:ChangeMessageVisibility"]
+    resources = [aws_sqs_queue.transcode.arn]
+  }
+}
+
+resource "aws_iam_role_policy" "media" {
+  role   = aws_iam_role.media.id
+  policy = data.aws_iam_policy_document.media.json
+}
+
+# Role EventBridge Scheduler uses to drop the delayed job onto the transcode queue.
+data "aws_iam_policy_document" "scheduler_assume" {
+  statement {
+    actions = ["sts:AssumeRole"]
+    principals {
+      type        = "Service"
+      identifiers = ["scheduler.amazonaws.com"]
+    }
+  }
+}
+
+resource "aws_iam_role" "scheduler" {
+  name               = "media-pipeline-scheduler"
+  assume_role_policy = data.aws_iam_policy_document.scheduler_assume.json
+}
+
+resource "aws_iam_role_policy" "scheduler" {
+  role = aws_iam_role.scheduler.id
+  policy = jsonencode({
+    Version = "2012-10-17"
+    Statement = [{
+      Effect   = "Allow"
+      Action   = "sqs:SendMessage"
+      Resource = aws_sqs_queue.transcode.arn
+    }]
+  })
+}
+
+# --- Events (Pub/Sub topic media-events) ---
+
+# SNS does not retain messages (Pub/Sub kept them 7 days); subscribe a queue if replay is needed.
+resource "aws_sns_topic" "media_events" {
+  name = "media-events"
+}
+
+# --- Delayed transcode queue (Cloud Tasks queue "transcode") ---
+
+resource "aws_sqs_queue" "transcode_dlq" {
+  name                      = "transcode-dlq"
+  message_retention_seconds = 1209600
+}
+
+resource "aws_sqs_queue" "transcode" {
+  name = "transcode"
+  # Lambda timeout is 900s; AWS recommends visibility >= 6x function timeout.
+  # A failed attempt is retried after the visibility timeout elapses.
+  visibility_timeout_seconds = 5400
+  redrive_policy = jsonencode({
+    deadLetterTargetArn = aws_sqs_queue.transcode_dlq.arn
+    maxReceiveCount     = 4 # max_attempts = 4
+  })
+}
+
+# --- Functions ---
+
+# Fires on every new object and on every overwrite of an existing key
+# (overwrites create a new version, which is what ingest keys on).
+resource "aws_lambda_function" "ingest" {
+  function_name = "media-ingest"
+  role          = aws_iam_role.media.arn
+  runtime       = "python3.12"
+  handler       = "main.on_upload"
+  s3_bucket     = local.fn_src_bucket
+  s3_key        = "ingest.zip"
+  timeout       = 60
+
+  environment {
+    variables = {
+      SCHEDULER_ROLE_ARN = aws_iam_role.scheduler.arn
+      TRANSCODE_QUEUE_ARN = aws_sqs_queue.transcode.arn
+      EVENTS_TOPIC_ARN   = aws_sns_topic.media_events.arn
+    }
+  }
+}
+
+# RETRY_POLICY_DO_NOT_RETRY
+resource "aws_lambda_function_event_invoke_config" "ingest" {
+  function_name          = aws_lambda_function.ingest.function_name
+  maximum_retry_attempts = 0
+}
+
+resource "aws_lambda_permission" "ingest_s3" {
+  statement_id   = "AllowS3Invoke"
+  action         = "lambda:InvokeFunction"
+  function_name  = aws_lambda_function.ingest.function_name
+  principal      = "s3.amazonaws.com"
+  source_arn     = aws_s3_bucket.incoming.arn
+  source_account = data.aws_caller_identity.current.account_id
+}
+
+resource "aws_s3_bucket_notification" "incoming" {
+  bucket = aws_s3_bucket.incoming.id
+  lambda_function {
+    lambda_function_arn = aws_lambda_function.ingest.arn
+    events              = ["s3:ObjectCreated:*"]
+  }
+  depends_on = [aws_lambda_permission.ingest_s3]
+}
+
+# NOTE: Lambda's maximum timeout is 900s (GCP function was 1800s).
+resource "aws_lambda_function" "transcode" {
+  function_name = "media-transcode"
+  role          = aws_iam_role.media.arn
+  runtime       = "python3.12"
+  handler       = "main.transcode"
+  s3_bucket     = local.fn_src_bucket
+  s3_key        = "transcode.zip"
+  timeout       = 900
+  memory_size   = 4096
+}
+
+# max_concurrent_dispatches = 3
+resource "aws_lambda_event_source_mapping" "transcode" {
+  event_source_arn = aws_sqs_queue.transcode.arn
+  function_name    = aws_lambda_function.transcode.arn
+  batch_size       = 1
+
+  scaling_config {
+    maximum_concurrency = 3
+  }
+}
+
+# --- Analytics (BigQuery dataset "media") ---
+
+resource "aws_glue_catalog_database" "media" {
+  name = "media"
+}
