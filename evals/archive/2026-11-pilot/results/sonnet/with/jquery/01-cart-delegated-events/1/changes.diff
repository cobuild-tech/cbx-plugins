diff --git a/src/Cart.tsx b/src/Cart.tsx
new file mode 100644
index 0000000..004e767
--- /dev/null
+++ b/src/Cart.tsx
@@ -0,0 +1,119 @@
+import { useEffect, useRef, useState } from 'react';
+
+export interface CartRow {
+  id: string;
+  name: string;
+  price: number;
+  qty: string;
+}
+
+declare global {
+  interface Window {
+    jQuery: any;
+  }
+}
+
+const FADE_MS = 200;
+
+function csrfToken(): string {
+  return document.querySelector('meta[name=csrf-token]')?.getAttribute('content') ?? '';
+}
+
+// Mirrors $.post + the global $.ajaxSetup in setup.js (CSRF header, form encoding, XHR marker).
+async function postRemove(id: string): Promise<boolean> {
+  const res = await fetch('/cart/remove', {
+    method: 'POST',
+    credentials: 'same-origin',
+    headers: {
+      'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
+      'X-CSRF-Token': csrfToken(),
+      'X-Requested-With': 'XMLHttpRequest',
+    },
+    body: new URLSearchParams({ id }).toString(),
+  });
+  return res.ok;
+}
+
+export function Cart({ initialRows }: { initialRows: CartRow[] }) {
+  // committed = what updateTotal() saw (qty is committed on the input's "change", not per keystroke)
+  const [rows, setRows] = useState(initialRows);
+  const [drafts, setDrafts] = useState<Record<string, string>>({});
+  const [fading, setFading] = useState<Record<string, boolean>>({});
+  const [updates, setUpdates] = useState(0);
+
+  const total = rows.reduce((t, r) => t + r.price * +r.qty, 0);
+
+  // Legacy jQuery listeners (analytics.js) still consume 'cart:updated'.
+  // Skip the first run: originally the initial event fired before analytics.js was bound.
+  const first = useRef(true);
+  useEffect(() => {
+    if (first.current) {
+      first.current = false;
+      return;
+    }
+    window.jQuery(document).trigger('cart:updated', [total]);
+  }, [updates]); // eslint-disable-line react-hooks/exhaustive-deps
+
+  const commitQty = (id: string) => {
+    const draft = drafts[id];
+    if (draft === undefined) return;
+    setDrafts(({ [id]: _, ...rest }) => rest);
+    const row = rows.find((r) => r.id === id);
+    if (!row || row.qty === draft) return;
+    setRows((rs) => rs.map((r) => (r.id === id ? { ...r, qty: draft } : r)));
+    setUpdates((n) => n + 1);
+  };
+
+  const remove = (e: React.MouseEvent, id: string) => {
+    e.preventDefault();
+    postRemove(id)
+      .then((ok) => {
+        if (!ok) return;
+        setFading((f) => ({ ...f, [id]: true }));
+        setTimeout(() => {
+          setRows((rs) => rs.filter((r) => r.id !== id));
+          setUpdates((n) => n + 1);
+        }, FADE_MS);
+      })
+      .catch(() => {});
+  };
+
+  return (
+    <>
+      <table className="cart">
+        <tbody>
+          {rows.map((r) => (
+            <tr
+              key={r.id}
+              data-id={r.id}
+              data-price={r.price}
+              style={fading[r.id] ? { opacity: 0, transition: `opacity ${FADE_MS}ms linear` } : undefined}
+            >
+              <td>{r.name}</td>
+              <td>
+                <input
+                  className="qty"
+                  value={drafts[r.id] ?? r.qty}
+                  onChange={(e) => setDrafts((d) => ({ ...d, [r.id]: e.target.value }))}
+                  onBlur={() => commitQty(r.id)}
+                  onKeyDown={(e) => e.key === 'Enter' && commitQty(r.id)}
+                />
+              </td>
+              <td>
+                <a href="#" className="remove" onClick={(e) => remove(e, r.id)}>
+                  Remove
+                </a>
+              </td>
+            </tr>
+          ))}
+        </tbody>
+      </table>
+      <p>
+        Total: <span id="total">{total.toFixed(2)}</span>
+      </p>
+      <button id="checkout" disabled={total === 0}>
+        Checkout
+      </button>
+    </>
+  );
+}
diff --git a/src/cart-main.tsx b/src/cart-main.tsx
new file mode 100644
index 0000000..158104d
--- /dev/null
+++ b/src/cart-main.tsx
@@ -0,0 +1,14 @@
+import { createRoot } from 'react-dom/client';
+import { Cart, CartRow } from './Cart';
+
+const root = document.getElementById('cart-root');
+if (root) {
+  // Rows are server-rendered into the page; read them before React replaces the markup.
+  const initialRows: CartRow[] = Array.from(root.querySelectorAll<HTMLElement>('.cart tr')).map((tr) => ({
+    id: tr.dataset.id ?? '',
+    name: tr.querySelector('td')?.textContent ?? '',
+    price: Number(tr.dataset.price),
+    qty: tr.querySelector<HTMLInputElement>('.qty')?.value ?? '',
+  }));
+  createRoot(root).render(<Cart initialRows={initialRows} />);
+}
