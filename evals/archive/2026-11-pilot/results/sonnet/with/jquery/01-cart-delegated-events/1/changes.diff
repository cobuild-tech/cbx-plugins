+import { defineConfig } from 'vite';
+
+// Builds src/cart-main.tsx into a single script the jQuery page loads with a <script> tag.
+export default defineConfig({
+  define: { 'process.env.NODE_ENV': '"production"' },
+  build: {
+    outDir: 'public/js',
+    emptyOutDir: false,
+    lib: { entry: 'src/cart-main.tsx', formats: ['iife'], name: 'CartApp', fileName: () => 'cart.bundle.js' },
+  },
+});
