diff --git a/src/PostEditForm.tsx b/src/PostEditForm.tsx
new file mode 100644
index 0000000..e24c743
--- /dev/null
+++ b/src/PostEditForm.tsx
@@ -0,0 +1,78 @@
+import { useEffect, useRef, useState } from 'react';
+
+const AUTOSAVE_URL = '/posts/42/autosave';
+const DEBOUNCE_MS = 1000;
+
+type Status = '' | 'Saved' | 'Not saved';
+
+// Mirrors $.ajax({ type: 'PATCH', data: $form.serialize() }): urlencoded body
+// plus the X-Requested-With header jQuery adds. fetch resolves on 4xx/5xx, so
+// those are turned into failures to match $.ajax's .fail().
+async function autosave(form: HTMLFormElement): Promise<void> {
+  const body = new URLSearchParams(new FormData(form) as unknown as Record<string, string>);
+  const res = await fetch(AUTOSAVE_URL, {
+    method: 'PATCH',
+    headers: { 'X-Requested-With': 'XMLHttpRequest' },
+    body, // sent as application/x-www-form-urlencoded;charset=UTF-8
+    credentials: 'same-origin',
+  });
+  if (!res.ok) throw new Error(`Autosave failed: ${res.status}`);
+}
+
+export function PostEditForm() {
+  const formRef = useRef<HTMLFormElement>(null);
+  const [dirty, setDirty] = useState(false);
+  const [status, setStatus] = useState<Status>('');
+
+  useEffect(() => {
+    const form = formRef.current!;
+    let timer: number | undefined;
+    let mounted = true;
+
+    // The original listened for both `input` and `change` on every :input
+    // (change also fires on blur for text fields), so keep native listeners.
+    const onEdit = () => {
+      setDirty(true);
+      window.clearTimeout(timer);
+      timer = window.setTimeout(() => {
+        autosave(form).then(
+          () => {
+            if (!mounted) return;
+            setDirty(false);
+            setStatus('Saved');
+          },
+          () => {
+            if (mounted) setStatus('Not saved');
+          },
+        );
+      }, DEBOUNCE_MS);
+    };
+
+    form.addEventListener('input', onEdit);
+    form.addEventListener('change', onEdit);
+    return () => {
+      mounted = false;
+      window.clearTimeout(timer);
+      form.removeEventListener('input', onEdit);
+      form.removeEventListener('change', onEdit);
+    };
+  }, []);
+
+  // leave-guard.js (still jQuery) reads `form.dirty` from the DOM, so the
+  // class name must stay.
+  return (
+    <form id="post-form" action="/posts/42" method="post" ref={formRef} className={dirty ? 'dirty' : undefined}>
+      <input name="post[title]" />
+      <textarea name="post[body]" />
+      <label>
+        <input type="checkbox" name="post[tags][]" value="news" />
+        News
+      </label>
+      <label>
+        <input type="checkbox" name="post[tags][]" value="tips" />
+        Tips
+      </label>
+      <span className="save-status">{status}</span>
+    </form>
+  );
+}
