diff --git a/src/Gallery.tsx b/src/Gallery.tsx
new file mode 100644
index 0000000..b9deb06
--- /dev/null
+++ b/src/Gallery.tsx
@@ -0,0 +1,86 @@
+import { useEffect, useRef, useState } from 'react';
+
+export interface Photo {
+  url: string;
+  title: string;
+  tags: string[];
+}
+
+declare global {
+  interface Window {
+    __PHOTOS__?: Photo[];
+  }
+}
+
+const FILTERS = [
+  { tag: 'all', label: 'All' },
+  { tag: 'cats', label: 'Cats' },
+  { tag: 'dogs', label: 'Dogs' },
+];
+
+function LazyImage({ src, alt }: { src: string; alt: string }) {
+  const ref = useRef<HTMLImageElement>(null);
+  const [loaded, setLoaded] = useState(false);
+
+  useEffect(() => {
+    const img = ref.current;
+    if (!img) return;
+    const io = new IntersectionObserver(
+      (entries) => {
+        if (entries.some((e) => e.isIntersecting)) {
+          setLoaded(true);
+          io.disconnect();
+        }
+      },
+      { rootMargin: '300px' },
+    );
+    io.observe(img);
+    return () => io.disconnect();
+  }, []);
+
+  return <img ref={ref} className="lazy" alt={alt} src={loaded ? src : undefined} />;
+}
+
+const tagFromLocation = () => new URLSearchParams(location.search).get('tag') || 'all';
+
+export function Gallery({ photos = window.__PHOTOS__ ?? [] }: { photos?: Photo[] }) {
+  const [tag, setTag] = useState(tagFromLocation);
+
+  useEffect(() => {
+    const onPop = (e: PopStateEvent) => setTag((e.state && e.state.tag) || 'all');
+    window.addEventListener('popstate', onPop);
+    return () => window.removeEventListener('popstate', onPop);
+  }, []);
+
+  const select = (next: string) => {
+    // Goes through history.pushState so the analytics.js wrapper still fires.
+    history.pushState({ tag: next }, '', '?tag=' + next);
+    setTag(next);
+  };
+
+  const visible = photos.filter((p) => tag === 'all' || p.tags.includes(tag));
+
+  return (
+    <>
+      <nav id="filters">
+        {FILTERS.map((f) => (
+          <button
+            key={f.tag}
+            className={f.tag === tag ? 'active' : undefined}
+            onClick={() => select(f.tag)}
+          >
+            {f.label}
+          </button>
+        ))}
+      </nav>
+      <div id="grid">
+        {visible.map((p, i) => (
+          <figure key={`${tag}:${i}:${p.url}`}>
+            <LazyImage src={p.url} alt={p.title} />
+            <figcaption>{p.title}</figcaption>
+          </figure>
+        ))}
+      </div>
+    </>
+  );
+}
