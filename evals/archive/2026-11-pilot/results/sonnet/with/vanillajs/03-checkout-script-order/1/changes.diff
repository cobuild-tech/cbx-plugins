diff --git a/src/CheckoutForm.tsx b/src/CheckoutForm.tsx
new file mode 100644
index 0000000..7ecc977
--- /dev/null
+++ b/src/CheckoutForm.tsx
@@ -0,0 +1,80 @@
+import { useLayoutEffect, useRef, useState } from 'react';
+import type { FormEvent } from 'react';
+
+const DRAFT = 'checkout-draft';
+
+type Prefill = (values: Record<string, string>) => void;
+type QueuedFn = () => void;
+
+declare global {
+  interface Window {
+    App: {
+      q: QueuedFn[] | { push: (fn: QueuedFn) => void };
+      checkout?: { prefill: Prefill };
+    };
+  }
+}
+
+// The form stays uncontrolled on purpose: the original read and wrote the DOM
+// values directly (prefill only fills empty fields, the draft reads the live
+// values on unload, FormData reads the fields on submit).
+export function CheckoutForm() {
+  const formRef = useRef<HTMLFormElement>(null);
+  const [submitting, setSubmitting] = useState(false);
+
+  // Layout effect so the draft and the queued prefill land before first paint,
+  // as they did when the deferred script ran.
+  useLayoutEffect(() => {
+    const form = formRef.current!;
+
+    const prefill: Prefill = (values) => {
+      Object.keys(values).forEach((k) => {
+        const el = form.elements.namedItem(k);
+        if (el && 'value' in el && !el.value) el.value = values[k];
+      });
+    };
+
+    prefill(JSON.parse(sessionStorage.getItem(DRAFT) || '{}'));
+
+    const onBeforeUnload = () => {
+      const f = form.elements as HTMLFormControlsCollection & {
+        email: HTMLInputElement;
+        country: HTMLSelectElement;
+      };
+      // never the card number
+      sessionStorage.setItem(DRAFT, JSON.stringify({ email: f.email.value, country: f.country.value }));
+    };
+    window.addEventListener('beforeunload', onBeforeUnload);
+
+    // Bridge for old scripts: window.App.checkout + the App.q queue.
+    window.App = window.App || { q: [] };
+    window.App.checkout = { prefill };
+    if (Array.isArray(window.App.q)) {
+      window.App.q.forEach((fn) => fn());
+      window.App.q = { push: (fn) => fn() };
+    }
+
+    return () => window.removeEventListener('beforeunload', onBeforeUnload);
+  }, []);
+
+  const onSubmit = (e: FormEvent<HTMLFormElement>) => {
+    e.preventDefault();
+    setSubmitting(true); // prevent double charge
+    fetch('/pay', { method: 'POST', body: new FormData(e.currentTarget) }).then((r) => {
+      if (r.ok) {
+        sessionStorage.removeItem(DRAFT);
+        window.location.href = '/thanks';
+      } else setSubmitting(false);
+    });
+    document.dispatchEvent(new Event('checkout:submit')); // tracking.js listens
+  };
+
+  return (
+    <form id="checkout" ref={formRef} onSubmit={onSubmit}>
+      <input name="email" />
+      <input name="card" />
+      <select name="country"></select>
+      <button disabled={submitting}>Pay</button>
+    </form>
+  );
+}
