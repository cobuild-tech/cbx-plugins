@@ -0,0 +1,28 @@
+import type { Order } from './types';
+
+// PLACEHOLDER: the Ember <OrdersTable> source is not in this repo, so its
+// markup/columns could not be ported. Replace with a faithful port.
+export function OrdersTable({
+  orders,
+  onSort,
+}: {
+  orders: Order[];
+  onSort: (sort: string) => void;
+}) {
+  return (
+    <table>
+      <thead>
+        <tr>
+          <th onClick={() => onSort('date')}>date</th>
+        </tr>
+      </thead>
+      <tbody>
+        {orders.map((o, i) => (
+          <tr key={o.id ?? i}>
+            <td>{String(o.date ?? '')}</td>
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
