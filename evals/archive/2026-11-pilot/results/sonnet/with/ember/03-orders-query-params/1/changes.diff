+// Ember Data `order` records are passed through as-is (same objects the old
+// OrdersTable received), so attributes are read by name, as the controller did.
+export interface Order {
+  id?: string;
+  [attr: string]: unknown;
+}
+
+export interface OrdersPageProps {
+  orders: Order[];
+  status: string;
+  page: number;
+  sort: string;
+  isLoading: boolean;
+  // Callbacks write to the Ember controller's @tracked query params, so the
+  // Ember router still owns the URL and refreshModel behaviour.
+  onStatusChange: (status: string) => void;
+  onSort: (sort: string) => void;
+  onPageChange: (page: number) => void;
+}
