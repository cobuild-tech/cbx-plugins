@@ -0,0 +1,32 @@
+import Modifier from 'ember-modifier';
+import { createRoot } from 'react-dom/client';
+import { createElement } from 'react';
+import { OrdersPage } from '../react/OrdersPage';
+
+// Mounts the React orders page. Root is created once, re-rendered whenever a
+// tracked arg read below changes, and unmounted on teardown.
+export default class ReactOrdersModifier extends Modifier {
+  root = null;
+
+  modify(element, _positional, props) {
+    if (!this.root) this.root = createRoot(element);
+    this.root.render(
+      createElement(OrdersPage, {
+        // Copy so autotracking reads array contents and React sees a new ref.
+        orders: [...props.orders],
+        status: props.status,
+        page: props.page,
+        sort: props.sort,
+        isLoading: props.isLoading,
+        onStatusChange: props.onStatusChange,
+        onSort: props.onSort,
+        onPageChange: props.onPageChange,
+      }),
+    );
+  }
+
+  willDestroy() {
+    this.root?.unmount();
+    this.root = null;
+  }
+}
diff --git a/app/react/OrdersPage.tsx b/app/react/OrdersPage.tsx
new file mode 100644
index 0000000..22871d1
--- /dev/null
+++ b/app/react/OrdersPage.tsx
@@ -0,0 +1,33 @@
+import { useMemo } from 'react';
+import type { OrdersPageProps } from './types';
+import { OrdersTable } from './OrdersTable';
+import { Spinner } from './Spinner';
+
+export function OrdersPage({
+  orders,
+  sort,
+  page,
+  isLoading,
+  onStatusChange,
+  onSort,
+  onPageChange,
+}: OrdersPageProps) {
+  // Same comparator as the old controller's `sorted` getter (descending).
+  const sorted = useMemo(
+    () => [...orders].sort((a, b) => ((a[sort] as number) > (b[sort] as number) ? -1 : 1)),
+    [orders, sort],
+  );
+
+  return (
+    <>
+      {/* Uncontrolled on purpose: the Ember template never bound `value`. */}
+      <select onChange={(e) => onStatusChange(e.target.value)}>
+        <option>open</option>
+        <option>shipped</option>
+      </select>
+      <OrdersTable orders={sorted} onSort={onSort} />
+      <button onClick={() => onPageChange(page + 1)}>Next</button>
+      {isLoading && <Spinner />}
+    </>
+  );
+}
