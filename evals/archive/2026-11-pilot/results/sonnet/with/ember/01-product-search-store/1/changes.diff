+export function ProductRow({ product }: { product: Product }) {
+  return (
+    <div className="product-row">
+      {product.name} — ${(product.priceCents / 100).toFixed(2)}
+    </div>
+  );
+}
diff --git a/app/react/ProductSearch.tsx b/app/react/ProductSearch.tsx
new file mode 100644
index 0000000..02c083b
--- /dev/null
+++ b/app/react/ProductSearch.tsx
@@ -0,0 +1,68 @@
+import { useEffect, useRef, useState, type FormEvent } from 'react';
+import { ProductRow, type Product } from './ProductRow';
+
+// Minimal view of the Ember Data store. Queries MUST go through it so the
+// records land in the store and Ember's CompareTray (peekAll) still sees them.
+export interface EmberStore {
+  query(modelName: 'product', params: { filter: { q: string } }): Promise<Iterable<Product>>;
+}
+
+// Bridge to @ember/test-waiters so settled() waits for the debounce + query.
+export interface Waiter {
+  begin(): unknown;
+  end(token: unknown): void;
+}
+
+export interface ProductSearchProps {
+  store: EmberStore;
+  waiter?: Waiter;
+}
+
+const DEBOUNCE_MS = 250;
+
+export function ProductSearch({ store, waiter }: ProductSearchProps) {
+  const [results, setResults] = useState<Product[]>([]);
+  const cancelPrevious = useRef<(() => void) | null>(null);
+
+  // Task cancels when its component is destroyed.
+  useEffect(() => () => cancelPrevious.current?.(), []);
+
+  // Equivalent of `restartableTask`: starting a search cancels the previous one.
+  function search(q: string) {
+    cancelPrevious.current?.();
+
+    let cancelled = false;
+    const token = waiter?.begin();
+    let finished = false;
+    const finish = () => {
+      if (!finished) {
+        finished = true;
+        waiter?.end(token);
+      }
+    };
+
+    const timer = setTimeout(async () => {
+      try {
+        const records = await store.query('product', { filter: { q } });
+        if (!cancelled) setResults(Array.from(records));
+      } finally {
+        finish();
+      }
+    }, DEBOUNCE_MS);
+
+    cancelPrevious.current = () => {
+      cancelled = true;
+      clearTimeout(timer);
+      finish();
+    };
+  }
+
+  return (
+    <>
+      <input onInput={(e: FormEvent<HTMLInputElement>) => search(e.currentTarget.value)} />
+      {results.map((p) => (
+        <ProductRow key={p.id} product={p} />
+      ))}
+    </>
+  );
+}
