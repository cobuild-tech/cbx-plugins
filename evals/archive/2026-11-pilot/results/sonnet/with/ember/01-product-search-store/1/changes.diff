new file mode 100644
index 0000000..0a84da4
--- /dev/null
+++ b/app/modifiers/mount-product-search.js
@@ -0,0 +1,12 @@
+import { modifier } from 'ember-modifier';
+import { createElement } from 'react';
+import { createRoot } from 'react-dom/client';
+import { ProductSearch } from '../react/ProductSearch';
+
+// Mounts React into the element the modifier is attached to (no extra wrapper,
+// so `.sidebar > .product-search` still matches). Unmounts on teardown.
+export default modifier((element, [store, waiter]) => {
+  const root = createRoot(element);
+  root.render(createElement(ProductSearch, { store, waiter }));
+  return () => root.unmount();
+});
