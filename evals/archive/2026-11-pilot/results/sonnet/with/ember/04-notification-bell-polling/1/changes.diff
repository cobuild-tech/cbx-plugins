index 0000000..4deb127
--- /dev/null
+++ b/app/react/NotificationBell.tsx
@@ -0,0 +1,72 @@
+import { useEffect, useState } from 'react';
+
+export const POLL_INTERVAL_MS = 20000;
+
+export interface NotificationBellProps {
+  /** Resolves to the number of unread notifications (Ember: store.query + length). */
+  fetchUnreadCount: () => Promise<number>;
+  /** Called with the current unread count when the user clicks the bell. */
+  onRead: (unread: number) => void;
+  /** Lets the Ember wrapper toggle `bell--unread` on its host element. */
+  onUnreadChange?: (unread: number) => void;
+  /** Ember.testing: run a single poll iteration so settled() can resolve. */
+  singleIteration?: boolean;
+}
+
+function abortableDelay(ms: number, signal: AbortSignal): Promise<void> {
+  return new Promise((resolve, reject) => {
+    if (signal.aborted) return reject(new DOMException('Aborted', 'AbortError'));
+    const id = setTimeout(() => {
+      signal.removeEventListener('abort', onAbort);
+      resolve();
+    }, ms);
+    const onAbort = () => {
+      clearTimeout(id);
+      reject(new DOMException('Aborted', 'AbortError'));
+    };
+    signal.addEventListener('abort', onAbort, { once: true });
+  });
+}
+
+export default function NotificationBell({
+  fetchUnreadCount,
+  onRead,
+  onUnreadChange,
+  singleIteration = false,
+}: NotificationBellProps) {
+  const [unread, setUnread] = useState(0);
+
+  useEffect(() => {
+    onUnreadChange?.(unread);
+  }, [unread, onUnreadChange]);
+
+  // Poll loop. One loop per mount (the Ember task was `.drop()` and performed once).
+  // Aborted on unmount, like a task cancelling on component destroy.
+  useEffect(() => {
+    const controller = new AbortController();
+    const { signal } = controller;
+    (async () => {
+      do {
+        const count = await fetchUnreadCount();
+        if (signal.aborted) return;
+        setUnread(count);
+        await abortableDelay(POLL_INTERVAL_MS, signal);
+      } while (!singleIteration);
+    })().catch((e) => {
+      if (e?.name !== 'AbortError') throw e;
+    });
+    return () => controller.abort();
+    // eslint-disable-next-line react-hooks/exhaustive-deps
+  }, []);
+
+  const markAllRead = () => {
+    onRead(unread);
+    setUnread(0);
+  };
+
+  return (
+    <button onClick={markAllRead}>
+      🔔 {unread > 0 && <b>{unread}</b>}
+    </button>
+  );
+}
