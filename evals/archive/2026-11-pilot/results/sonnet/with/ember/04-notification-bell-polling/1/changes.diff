@@ -0,0 +1,18 @@
+import { createRoot, Root } from 'react-dom/client';
+import NotificationBell, { NotificationBellProps } from './NotificationBell';
+
+export interface BellHandle {
+  unmount(): void;
+}
+
+/** Mounts the React bell into `host`. Call `unmount()` on Ember teardown. */
+export function mountNotificationBell(host: HTMLElement, props: NotificationBellProps): BellHandle {
+  let root: Root | null = createRoot(host);
+  root.render(<NotificationBell {...props} />);
+  return {
+    unmount() {
+      root?.unmount();
+      root = null;
+    },
+  };
+}
