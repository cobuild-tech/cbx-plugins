+import React, { useEffect, useReducer } from 'react';
+import { createRoot, Root } from 'react-dom/client';
+
+// Minimal typings for the shared Backbone collection (app.todos).
+export interface TodoModel {
+  id?: string | number;
+  cid: string;
+  get(attr: 'done'): boolean;
+  get(attr: 'title'): string;
+  save(attrs: { done: boolean }, opts: { patch: boolean }): unknown;
+  destroy(): unknown;
+}
+
+export interface TodoCollection {
+  map<T>(fn: (t: TodoModel) => T): T[];
+  on(events: string, cb: () => void): unknown;
+  off(events: string, cb: () => void): unknown;
+}
+
+// Same events the Backbone view re-rendered on. Notably NOT 'change:title'.
+const RENDER_EVENTS = 'add remove reset sort change:done';
+
+export function TodoList({ todos }: { todos: TodoCollection }) {
+  const [, rerender] = useReducer((n: number) => n + 1, 0);
+
+  useEffect(() => {
+    // Subscribe to the shared collection instance; do not copy into state.
+    todos.on(RENDER_EVENTS, rerender);
+    return () => {
+      todos.off(RENDER_EVENTS, rerender);
+    };
+  }, [todos]);
+
+  return (
+    <>
+      {todos.map((t) => (
+        <li key={t.cid} data-id={t.id}>
+          <input
+            className="toggle"
+            type="checkbox"
+            checked={!!t.get('done')}
+            onChange={(e) => {
+              t.save({ done: e.target.checked }, { patch: true });
+            }}
+          />
+          {t.get('title')}
+          <a className="destroy" onClick={() => t.destroy()}>
+            ×
+          </a>
+        </li>
+      ))}
+    </>
+  );
+}
+
+/** Mounts <TodoList> into `el`; returns an unmount function. */
+export function mountTodoList(el: HTMLElement, todos: TodoCollection): () => void {
+  const root: Root = createRoot(el);
+  root.render(<TodoList todos={todos} />);
+  return () => root.unmount();
+}
