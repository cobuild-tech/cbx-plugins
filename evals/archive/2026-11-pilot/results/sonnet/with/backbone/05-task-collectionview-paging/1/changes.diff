+import type Backbone from 'backbone';
+
+// Globals provided by the Marionette app shell (script tags / legacy modules).
+declare global {
+  // eslint-disable-next-line no-var
+  var app: {
+    tasks: Backbone.Collection<Backbone.Model>;
+    TasksView: any;
+    LegacyTasksView?: any;
+    [key: string]: any;
+  };
+  // eslint-disable-next-line no-var
+  var Marionette: any;
+  interface JQuery {
+    tooltip(options?: unknown): JQuery;
+  }
+}
+
+export {};
