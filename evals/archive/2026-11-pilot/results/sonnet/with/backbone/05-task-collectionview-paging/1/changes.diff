+++ b/src/react/TasksViewBridge.tsx
@@ -0,0 +1,27 @@
+import { createRoot, type Root } from 'react-dom/client';
+import { flushSync } from 'react-dom';
+import { TasksView } from './TasksView';
+
+// Marionette shell stays: this View is what the shell instantiates/shows in a
+// region. It owns a single React root on its <ul> el.
+//
+// Usage is unchanged: new app.TasksView({ collection: app.tasks })
+export const ReactTasksView = Marionette.View.extend({
+  tagName: 'ul',
+  template: false,
+
+  onRender(this: any) {
+    this.root ??= createRoot(this.el) as Root;
+    // flushSync so children exist in the DOM when render() returns, as before.
+    flushSync(() => {
+      this.root.render(<TasksView collection={this.collection} />);
+    });
+  },
+
+  // Region swap / destroy: unmount React (runs effect cleanups: scroll
+  // listener, tooltip dispose, model/collection listeners) before el removal.
+  onBeforeDestroy(this: any) {
+    this.root?.unmount();
+    this.root = null;
+  },
+});
