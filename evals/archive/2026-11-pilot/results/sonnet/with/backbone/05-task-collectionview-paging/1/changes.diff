index 0000000..259e3bf
--- /dev/null
+++ b/src/react/TaskRow.tsx
@@ -0,0 +1,68 @@
+import { useLayoutEffect, useMemo, useRef, useSyncExternalStore } from 'react';
+import type Backbone from 'backbone';
+
+interface RowSnapshot {
+  owner: unknown;
+  title: unknown;
+  priority: unknown;
+  /** Bumped on every "render" so the inner DOM is recreated, as the Marionette template re-render did. */
+  renderId: number;
+}
+
+// Mirrors `modelEvents: { 'change:priority': 'render' }`: the row's content is
+// re-read from the model ONLY on change:priority (title/owner changes alone do
+// not update the row, as before). The snapshot is recomputed in the handler and
+// otherwise returned by reference.
+function createRowStore(model: Backbone.Model) {
+  const read = (renderId: number): RowSnapshot => ({
+    owner: model.get('owner'),
+    title: model.get('title'),
+    priority: model.get('priority'),
+    renderId,
+  });
+  let snapshot = read(0);
+  return {
+    subscribe(listener: () => void) {
+      const handler = () => {
+        snapshot = read(snapshot.renderId + 1);
+        listener();
+      };
+      model.on('change:priority', handler);
+      return () => {
+        model.off('change:priority', handler);
+      };
+    },
+    getSnapshot: () => snapshot,
+  };
+}
+
+// Replaces app.TooltipBehavior: init on every render, dispose before destroy.
+function useTooltip(rowRef: React.RefObject<HTMLLIElement>, renderId: number) {
+  useLayoutEffect(() => {
+    const $targets = $(rowRef.current as HTMLLIElement).find('[title]');
+    $targets.tooltip({ placement: 'top' });
+    return () => {
+      $targets.tooltip('dispose');
+    };
+  }, [rowRef, renderId]);
+}
+
+export function TaskRow({ model }: { model: Backbone.Model }) {
+  const store = useMemo(() => createRowStore(model), [model]);
+  const { owner, title, priority, renderId } = useSyncExternalStore(
+    store.subscribe,
+    store.getSnapshot,
+  );
+  const rowRef = useRef<HTMLLIElement>(null);
+  useTooltip(rowRef, renderId);
+
+  return (
+    <li ref={rowRef}>
+      {/* key forces fresh span/em on each render, matching the old template re-render */}
+      <span key={renderId} title={owner == null ? '' : String(owner)}>
+        {title as React.ReactNode}
+      </span>{' '}
+      <em key={`${renderId}-p`}>{priority as React.ReactNode}</em>
+    </li>
+  );
+}
diff --git a/src/react/TasksView.tsx b/src/react/TasksView.tsx
new file mode 100644
index 0000000..ca222fe
--- /dev/null
+++ b/src/react/TasksView.tsx
@@ -0,0 +1,80 @@
+import { useEffect, useMemo, useSyncExternalStore } from 'react';
+import type Backbone from 'backbone';
+import { TaskRow } from './TaskRow';
+import { throttle } from './throttle';
+
+type Model = Backbone.Model;
+
+// viewFilter + viewComparator. Like the Marionette CollectionView, the visible
+// list/order is recomputed on collection add/remove/reset/sort -- NOT when a
+// model's `archived` or `priority` changes (only the row re-renders then).
+function computeVisible(collection: Backbone.Collection<Model>): Model[] {
+  return collection
+    .filter((m) => !m.get('archived'))
+    .map((m, i) => ({ m, i, k: -m.get('priority') }))
+    .sort((a, b) => (a.k < b.k ? -1 : a.k > b.k ? 1 : a.i - b.i)) // stable, like _.sortBy
+    .map((x) => x.m);
+}
+
+function sameList(a: Model[], b: Model[]) {
+  return a.length === b.length && a.every((m, i) => m === b[i]);
+}
+
+function createVisibleStore(collection: Backbone.Collection<Model>) {
+  let snapshot = computeVisible(collection);
+  return {
+    subscribe(listener: () => void) {
+      const refresh = () => {
+        const next = computeVisible(collection);
+        if (!sameList(next, snapshot)) {
+          snapshot = next;
+          listener();
+        }
+      };
+      collection.on('add remove reset sort', refresh);
+      refresh(); // catch changes between render and subscribe
+      return () => {
+        collection.off('add remove reset sort', refresh);
+      };
+    },
+    getSnapshot: () => snapshot,
+  };
+}
+
+export function TasksView({ collection }: { collection: Backbone.Collection<Model> }) {
+  const store = useMemo(() => createVisibleStore(collection), [collection]);
+  const models = useSyncExternalStore(store.subscribe, store.getSnapshot);
+
+  // Infinite scroll (was onAttach / onDestroy with $(window) 'scroll.tasks').
+  useEffect(() => {
+    let page = 1;
+    const onScroll = throttle(() => {
+      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 200) {
+        collection.fetch({ remove: false, data: { page: ++page } });
+      }
+    }, 250);
+    window.addEventListener('scroll', onScroll);
+    return () => {
+      window.removeEventListener('scroll', onScroll);
+      onScroll.cancel();
+    };
+  }, [collection]);
+
+  // The host <ul> is the Marionette view's el; children render directly into it.
+  if (models.length === 0) {
+    // emptyView was a default-tagName (div) Marionette View wrapping an <li>.
+    // Kept as-is for DOM/CSS parity even though div-in-ul is not valid HTML.
+    return (
+      <div>
+        <li className="empty">No open tasks</li>
+      </div>
+    );
+  }
+  return (
+    <>
+      {models.map((m) => (
+        <TaskRow key={m.cid} model={m} />
+      ))}
+    </>
+  );
+}
