+++ b/src/react/InboxView.tsx
@@ -0,0 +1,69 @@
+import { useEffect, useState } from 'react';
+
+// Minimal structural types for the Backbone objects this component touches.
+export interface MailboxModel {
+  get(attr: 'unread'): number;
+  set(attr: 'unread', value: number): unknown;
+}
+
+export interface MailChannel {
+  on(event: 'message:new', cb: (msg: NewMessage) => void): unknown;
+  off(event: 'message:new', cb: (msg: NewMessage) => void): unknown;
+  trigger(event: 'mail:poll'): unknown;
+}
+
+export interface NewMessage {
+  subject?: string | null;
+}
+
+interface Props {
+  model: MailboxModel;
+  channel: MailChannel;
+}
+
+const POLL_INTERVAL_MS = 30000;
+
+interface Item {
+  id: number;
+  subject: string;
+}
+
+let nextId = 0;
+
+export function InboxView({ model, channel }: Props) {
+  const [unread, setUnread] = useState<number>(() => model.get('unread'));
+  const [items, setItems] = useState<Item[]>([]);
+
+  useEffect(() => {
+    // Was: listenTo(channel, 'message:new', onNewMessage)
+    const onNewMessage = (msg: NewMessage) => {
+      // The shared mailbox model is still the source of truth; other
+      // Backbone code may listen to its change events.
+      model.set('unread', model.get('unread') + 1);
+      setUnread(model.get('unread'));
+      setItems((prev) => [{ id: nextId++, subject: msg.subject ?? '' }, ...prev]);
+    };
+    channel.on('message:new', onNewMessage);
+
+    // Was: setInterval(...) in initialize, cleared in onDestroy
+    const poll = setInterval(() => channel.trigger('mail:poll'), POLL_INTERVAL_MS);
+
+    return () => {
+      channel.off('message:new', onNewMessage);
+      clearInterval(poll);
+    };
+  }, [model, channel]);
+
+  return (
+    <>
+      <h2>
+        Inbox (<span className="n">{unread}</span>)
+      </h2>
+      <ul className="msgs">
+        {items.map((item) => (
+          <li key={item.id}>{item.subject}</li>
+        ))}
+      </ul>
+    </>
+  );
+}
