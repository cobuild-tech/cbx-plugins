+import { createRoot, type Root } from 'react-dom/client';
+import { InboxView, type MailChannel, type MailboxModel } from './InboxView';
+
+// Globals provided by the legacy Backbone/Marionette app.
+declare const Marionette: any;
+declare const Backbone: any;
+declare const app: any;
+
+// Thin Marionette host so the existing region/router code keeps working:
+//   app.layout.getRegion('main').show(new app.InboxView({ model: app.mailbox }))
+app.InboxView = Marionette.View.extend({
+  // React renders the markup; Marionette must not render a template.
+  template: false,
+
+  // Quirk kept for parity: className runs once, when the element is created,
+  // so 'has-unread' is NOT updated as messages arrive.
+  className(this: { model: MailboxModel }) {
+    return this.model.get('unread') ? 'inbox has-unread' : 'inbox';
+  },
+
+  root: null as Root | null,
+
+  onRender(this: any) {
+    // Create the root once; render() may be called repeatedly.
+    if (!this.root) this.root = createRoot(this.el);
+    const channel: MailChannel = Backbone.Radio.channel('mail');
+    this.root.render(<InboxView model={this.model} channel={channel} />);
+  },
+
+  onDestroy(this: any) {
+    // Unmounting runs the component's effect cleanup (off + clearInterval).
+    this.root?.unmount();
+    this.root = null;
+  },
+});
