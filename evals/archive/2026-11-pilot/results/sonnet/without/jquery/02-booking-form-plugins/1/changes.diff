diff --git a/src/BookingForm.tsx b/src/BookingForm.tsx
new file mode 100644
index 0000000..d7db28d
--- /dev/null
+++ b/src/BookingForm.tsx
@@ -0,0 +1,117 @@
+import React, { useEffect, useState } from 'react';
+
+interface Slot {
+  id: string | number;
+  label: string;
+}
+
+interface Errors {
+  name?: string;
+  shipDate?: string;
+}
+
+const DATE_MESSAGE = 'Pick a weekday from tomorrow onward';
+
+function pad(n: number): string {
+  return String(n).padStart(2, '0');
+}
+
+/** Earliest allowed date (tomorrow, local time) as yyyy-mm-dd, matching the old datepicker's minDate: 1. */
+function tomorrowIso(): string {
+  const d = new Date();
+  d.setDate(d.getDate() + 1);
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+/** Parse yyyy-mm-dd as a local date; returns null if invalid. */
+function parseIso(value: string): Date | null {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(value);
+  if (!m) return null;
+  const [y, mo, d] = [Number(m[1]), Number(m[2]), Number(m[3])];
+  const date = new Date(y, mo - 1, d);
+  return date.getFullYear() === y && date.getMonth() === mo - 1 && date.getDate() === d ? date : null;
+}
+
+/** The server parses ship_date with '%d/%m/%Y' (the old datepicker's dd/mm/yy). */
+function toServerDate(value: string): string {
+  const [y, m, d] = value.split('-');
+  return `${d}/${m}/${y}`;
+}
+
+function validate(name: string, shipDate: string): Errors {
+  const errors: Errors = {};
+  if (!name.trim()) errors.name = 'This field is required.';
+  else if (name.length < 2) errors.name = 'Please enter at least 2 characters.';
+
+  const date = parseIso(shipDate);
+  if (!shipDate) errors.shipDate = 'This field is required.';
+  else if (!date || shipDate < tomorrowIso() || date.getDay() === 0 || date.getDay() === 6) {
+    errors.shipDate = DATE_MESSAGE;
+  }
+  return errors;
+}
+
+export function BookingForm(): JSX.Element {
+  const [name, setName] = useState('');
+  const [shipDate, setShipDate] = useState('');
+  const [slots, setSlots] = useState<Slot[]>([]);
+  const [slot, setSlot] = useState('');
+  const [errors, setErrors] = useState<Errors>({});
+  const [submitted, setSubmitted] = useState(false);
+
+  // Load slots whenever the date changes; ignore stale responses.
+  useEffect(() => {
+    setSlots([]);
+    setSlot('');
+    if (!shipDate || validate('xx', shipDate).shipDate) return;
+
+    const controller = new AbortController();
+    fetch(`/slots?date=${encodeURIComponent(toServerDate(shipDate))}`, {
+      signal: controller.signal,
+      headers: { Accept: 'application/json' },
+    })
+      .then((r) => (r.ok ? (r.json() as Promise<Slot[]>) : Promise.reject(new Error(String(r.status)))))
+      .then((data) => {
+        setSlots(data);
+        if (data.length) setSlot(String(data[0].id));
+      })
+      .catch((e: unknown) => {
+        if (!(e instanceof DOMException && e.name === 'AbortError')) console.error('Failed to load slots', e);
+      });
+    return () => controller.abort();
+  }, [shipDate]);
+
+  // Re-validate live once the user has tried to submit (jquery-validate behaviour).
+  useEffect(() => {
+    if (submitted) setErrors(validate(name, shipDate));
+  }, [name, shipDate, submitted]);
+
+  function onSubmit(e: React.FormEvent<HTMLFormElement>): void {
+    setSubmitted(true);
+    const found = validate(name, shipDate);
+    setErrors(found);
+    if (found.name || found.shipDate) e.preventDefault();
+    // Otherwise let the browser post natively to /bookings (server redirects).
+  }
+
+  return (
+    <form id="booking" action="/bookings" method="post" onSubmit={onSubmit} noValidate>
+      <input name="name" value={name} onChange={(e) => setName(e.target.value)} aria-invalid={!!errors.name} />
+      {errors.name && <label className="error">{errors.name}</label>}
+
+      {/* Visible picker is unnamed; the hidden field carries the dd/mm/yyyy value the server expects. */}
+      <input type="date" min={tomorrowIso()} value={shipDate} onChange={(e) => setShipDate(e.target.value)} aria-invalid={!!errors.shipDate} />
+      <input type="hidden" name="ship_date" value={shipDate ? toServerDate(shipDate) : ''} />
+      {errors.shipDate && <label className="error">{errors.shipDate}</label>}
+
+      <select name="slot" value={slot} onChange={(e) => setSlot(e.target.value)}>
+        {slots.map((s) => (
+          <option key={s.id} value={s.id}>
+            {s.label}
+          </option>
+        ))}
+      </select>
+      <button type="submit">Book</button>
+    </form>
+  );
+}
