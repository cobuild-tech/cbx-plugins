+import { useToasts } from './useToasts';
+
+export default function ToastStack() {
+  const { items, dismiss } = useToasts();
+  return (
+    <ul className="toasts">
+      {items.map((t) => (
+        <li key={t.id} onClick={() => dismiss(t)}>
+          {t.text}
+        </li>
+      ))}
+    </ul>
+  );
+}
diff --git a/app/react/toasts/store.ts b/app/react/toasts/store.ts
new file mode 100644
index 0000000..38e8b07
--- /dev/null
+++ b/app/react/toasts/store.ts
@@ -0,0 +1,47 @@
+export interface Toast {
+  id: number;
+  text: string;
+}
+
+type Listener = () => void;
+
+/** Framework-agnostic toast store; usable from React (useToasts) and Ember (via the service shim). */
+export class ToastStore {
+  private items: readonly Toast[] = [];
+  private timers = new Map<number, ReturnType<typeof setTimeout>>();
+  private listeners = new Set<Listener>();
+  private nextId = 1;
+
+  show = (text: string, ms = 4000): Toast => {
+    const toast: Toast = { id: this.nextId++, text };
+    this.timers.set(toast.id, setTimeout(() => this.dismiss(toast), ms));
+    this.items = [...this.items, toast];
+    this.emit();
+    return toast;
+  };
+
+  dismiss = (toast: Toast): void => {
+    const timer = this.timers.get(toast.id);
+    if (timer !== undefined) clearTimeout(timer);
+    this.timers.delete(toast.id);
+    if (!this.items.includes(toast)) return;
+    this.items = this.items.filter((t) => t !== toast);
+    this.emit();
+  };
+
+  // Arrow properties so they can be passed directly to useSyncExternalStore.
+  subscribe = (listener: Listener): (() => void) => {
+    this.listeners.add(listener);
+    return () => {
+      this.listeners.delete(listener);
+    };
+  };
+
+  getSnapshot = (): readonly Toast[] => this.items;
+
+  private emit(): void {
+    this.listeners.forEach((l) => l());
+  }
+}
+
+export const toastStore = new ToastStore();
diff --git a/app/react/toasts/useToasts.ts b/app/react/toasts/useToasts.ts
new file mode 100644
index 0000000..7e01e08
--- /dev/null
+++ b/app/react/toasts/useToasts.ts
@@ -0,0 +1,11 @@
+import { useSyncExternalStore } from 'react';
+import { toastStore, type Toast } from './store';
+
+export function useToasts() {
+  const items = useSyncExternalStore(toastStore.subscribe, toastStore.getSnapshot);
+  return { items, show: toastStore.show, dismiss: toastStore.dismiss } as {
+    items: readonly Toast[];
+    show: typeof toastStore.show;
+    dismiss: typeof toastStore.dismiss;
+  };
+}
