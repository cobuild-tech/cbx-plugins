+import Component from '@ember/component';
+import { mountOrdersPage } from 'admin/react/orders/mount';
+
+// Thin bridge: renders the React OrdersPage inside the Ember route template.
+export default class ReactOrdersPageComponent extends Component {
+  tagName = 'div';
+
+  didInsertElement() {
+    super.didInsertElement(...arguments);
+    this._handle = mountOrdersPage(this.element, this._props());
+  }
+
+  didUpdateAttrs() {
+    super.didUpdateAttrs(...arguments);
+    this._handle?.update(this._props());
+  }
+
+  willDestroyElement() {
+    super.willDestroyElement(...arguments);
+    // Defer so we don't unmount synchronously during an Ember render.
+    const handle = this._handle;
+    this._handle = null;
+    queueMicrotask(() => handle?.unmount());
+  }
+
+  _props() {
+    return {
+      orders: this.orders.toArray?.() ?? [...this.orders],
+      status: this.status,
+      page: this.page,
+      sort: this.sort,
+      onStatusChange: this.onStatusChange,
+      onPageChange: this.onPageChange,
+      onSortChange: this.onSortChange,
+    };
+  }
+}
