+import type { Order } from './types';
+
+interface OrdersTableProps {
+  orders: Order[];
+  onSort: (sort: string) => void;
+}
+
+// Placeholder for the Ember <OrdersTable> component, which is not defined in
+// this repo (likely from an addon). Replace with the real implementation.
+const COLUMNS = ['id', 'date', 'status'] as const;
+
+export function OrdersTable({ orders, onSort }: OrdersTableProps) {
+  return (
+    <table>
+      <thead>
+        <tr>
+          {COLUMNS.map((col) => (
+            <th key={col}>
+              <button type="button" onClick={() => onSort(col)}>
+                {col}
+              </button>
+            </th>
+          ))}
+        </tr>
+      </thead>
+      <tbody>
+        {orders.map((order) => (
+          <tr key={order.id}>
+            {COLUMNS.map((col) => (
+              <td key={col}>{String(order[col] ?? '')}</td>
+            ))}
+          </tr>
+        ))}
+      </tbody>
+    </table>
+  );
+}
