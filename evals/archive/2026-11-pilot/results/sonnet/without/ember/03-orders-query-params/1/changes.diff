@@ -0,0 +1,21 @@
+import { createRoot, type Root } from 'react-dom/client';
+import { OrdersPage } from './OrdersPage';
+import type { OrdersPageProps } from './types';
+
+export interface OrdersPageHandle {
+  update(props: OrdersPageProps): void;
+  unmount(): void;
+}
+
+/** Entry point for Ember: mounts the React orders page into `element`. */
+export function mountOrdersPage(
+  element: HTMLElement,
+  props: OrdersPageProps,
+): OrdersPageHandle {
+  const root: Root = createRoot(element);
+  root.render(<OrdersPage {...props} />);
+  return {
+    update: (next) => root.render(<OrdersPage {...next} />),
+    unmount: () => root.unmount(),
+  };
+}
