diff --git a/src/react/InboxView.tsx b/src/react/InboxView.tsx
new file mode 100644
index 0000000..0698ab4
--- /dev/null
+++ b/src/react/InboxView.tsx
@@ -0,0 +1,67 @@
+import React, { useEffect, useState } from 'react';
+import type { Model } from 'backbone';
+
+export interface MailChannel {
+  on(event: string, cb: (...args: any[]) => void, ctx?: unknown): unknown;
+  off(event: string, cb?: (...args: any[]) => void, ctx?: unknown): unknown;
+  trigger(event: string, ...args: any[]): unknown;
+}
+
+export interface MailMessage {
+  subject: string;
+}
+
+export interface InboxViewProps {
+  /** Mailbox model; its `unread` attribute is the unread counter. */
+  model: Model;
+  /** Radio 'mail' channel. */
+  channel: MailChannel;
+  pollIntervalMs?: number;
+}
+
+export function InboxView({ model, channel, pollIntervalMs = 30000 }: InboxViewProps) {
+  const [unread, setUnread] = useState<number>(model.get('unread'));
+  const [subjects, setSubjects] = useState<string[]>([]);
+
+  // Keep local state in sync with the Backbone model.
+  useEffect(() => {
+    const onChange = () => setUnread(model.get('unread'));
+    model.on('change:unread', onChange);
+    return () => {
+      model.off('change:unread', onChange);
+    };
+  }, [model]);
+
+  // New messages: bump the model counter and prepend the subject.
+  useEffect(() => {
+    const onNewMessage = (msg: MailMessage) => {
+      model.set('unread', model.get('unread') + 1);
+      setSubjects((prev) => [msg.subject, ...prev]);
+    };
+    channel.on('message:new', onNewMessage);
+    return () => {
+      channel.off('message:new', onNewMessage);
+    };
+  }, [model, channel]);
+
+  // Poll trigger (cleared on unmount, replacing Marionette's onDestroy).
+  useEffect(() => {
+    const id = setInterval(() => channel.trigger('mail:poll'), pollIntervalMs);
+    return () => clearInterval(id);
+  }, [channel, pollIntervalMs]);
+
+  return (
+    <div className={unread ? 'inbox has-unread' : 'inbox'}>
+      <h2>
+        Inbox (<span className="n">{unread}</span>)
+      </h2>
+      <ul className="msgs">
+        {subjects.map((s, i) => (
+          // Text is escaped by React. Index key is fine: list is prepend-only
+          // and items have no local state.
+          <li key={subjects.length - i}>{s}</li>
+        ))}
+      </ul>
+    </div>
+  );
+}
diff --git a/src/react/InboxViewBridge.tsx b/src/react/InboxViewBridge.tsx
