@@ -0,0 +1,34 @@
+import React from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import Marionette from 'backbone.marionette';
+import Backbone from 'backbone';
+import 'backbone.radio';
+import { InboxView, type MailChannel } from './InboxView';
+
+/**
+ * Marionette view that hosts the React InboxView, so the existing layout/router
+ * (`region.show(new app.InboxView({ model }))`) keeps working unchanged.
+ */
+export const InboxViewBridge = Marionette.View.extend({
+  template: false,
+  root: null as Root | null,
+
+  onRender(this: any) {
+    const channel = (Backbone as any).Radio.channel('mail') as MailChannel;
+    this.root = createRoot(this.el);
+    this.root.render(<InboxView model={this.model} channel={channel} />);
+  },
+
+  onDestroy(this: any) {
+    this.root?.unmount();
+    this.root = null;
+  },
+} as any);
+
+declare global {
+  // eslint-disable-next-line no-var
+  var app: any;
+}
+
+// Replace the legacy global so app.js needs no changes.
+app.InboxView = InboxViewBridge;
