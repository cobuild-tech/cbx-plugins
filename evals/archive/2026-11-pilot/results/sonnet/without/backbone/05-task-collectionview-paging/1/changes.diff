--- /dev/null
+++ b/src/react/TasksView.tsx
@@ -0,0 +1,38 @@
+import React, { useEffect } from 'react';
+import _ from 'underscore';
+import { TaskRow } from './TaskRow';
+import type { TaskCollection } from './types';
+import { useBackbone } from './useBackbone';
+
+export function TasksView({ collection }: { collection: TaskCollection }) {
+  useBackbone(collection, 'add remove reset sort change:archived change:priority');
+
+  // Infinite scroll (replaces onAttach/onDestroy window handler).
+  useEffect(() => {
+    let page = 1;
+    const onScroll = _.throttle(() => {
+      if (window.innerHeight + window.scrollY >= document.body.offsetHeight - 200) {
+        collection.fetch({ remove: false, data: { page: ++page } });
+      }
+    }, 250);
+    window.addEventListener('scroll', onScroll);
+    return () => {
+      window.removeEventListener('scroll', onScroll);
+      onScroll.cancel();
+    };
+  }, [collection]);
+
+  // viewFilter + viewComparator: hide archived, highest priority first (stable sort).
+  const tasks = collection.filter((m) => !m.get('archived'));
+  tasks.sort((a, b) => b.get('priority') - a.get('priority'));
+
+  return (
+    <ul>
+      {tasks.length === 0 ? (
+        <li className="empty">No open tasks</li>
+      ) : (
+        tasks.map((m) => <TaskRow key={m.cid} model={m} />)
+      )}
+    </ul>
+  );
+}
