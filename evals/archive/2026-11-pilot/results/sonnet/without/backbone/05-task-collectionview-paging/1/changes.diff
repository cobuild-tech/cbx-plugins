@@ -0,0 +1,26 @@
+import React, { useEffect, useRef } from 'react';
+import $ from 'jquery';
+import type { TaskModel } from './types';
+import { useBackbone } from './useBackbone';
+
+export function TaskRow({ model }: { model: TaskModel }) {
+  // Original only re-rendered on change:priority; title/owner edits are cheap to include too.
+  useBackbone(model, 'change');
+  const ref = useRef<HTMLLIElement>(null);
+  const owner = model.get('owner');
+
+  // Bootstrap tooltip: init after render, dispose on cleanup (replaces TooltipBehavior).
+  useEffect(() => {
+    const $els = $(ref.current!).find('[title]');
+    $els.tooltip({ placement: 'top' });
+    return () => {
+      $els.tooltip('dispose');
+    };
+  }, [owner]);
+
+  return (
+    <li ref={ref}>
+      <span title={owner}>{model.get('title')}</span> <em>{model.get('priority')}</em>
+    </li>
+  );
+}
