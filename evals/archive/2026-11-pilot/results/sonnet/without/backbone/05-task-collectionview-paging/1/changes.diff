@@ -0,0 +1,17 @@
+import type { Collection, Model } from 'backbone';
+
+export interface TaskAttributes {
+  title: string;
+  owner: string;
+  priority: number;
+  archived?: boolean;
+}
+
+export type TaskModel = Model<TaskAttributes>;
+export type TaskCollection = Collection<TaskModel>;
+
+declare global {
+  interface JQuery {
+    tooltip(options?: { placement?: string } | 'dispose'): JQuery;
+  }
+}
diff --git a/src/react/useBackbone.ts b/src/react/useBackbone.ts
new file mode 100644
index 0000000..66b9907
--- /dev/null
+++ b/src/react/useBackbone.ts
@@ -0,0 +1,13 @@
+import { useEffect, useReducer } from 'react';
+import type { Events } from 'backbone';
+
+/** Re-render whenever the Backbone object fires any of the given events. */
+export function useBackbone(source: Events, events: string): void {
+  const [, bump] = useReducer((n: number) => n + 1, 0);
+  useEffect(() => {
+    source.on(events, bump);
+    return () => {
+      source.off(events, bump);
+    };
+  }, [source, events]);
+}
