@@ -0,0 +1,26 @@
+import React from 'react';
+import { createRoot, type Root } from 'react-dom/client';
+import Marionette from 'backbone.marionette';
+import { TasksView } from './TasksView';
+import type { TaskCollection } from './types';
+
+/**
+ * Marionette shell adapter: keeps `app.TasksView` usable in regions
+ * (`region.show(new app.TasksView())`) while rendering React inside.
+ * Uses the shared `app.tasks` collection unless one is passed in options.
+ */
+export const TasksViewAdapter = Marionette.View.extend({
+  template: false,
+  root: null as Root | null,
+  onRender(this: any) {
+    const collection: TaskCollection = this.getOption('collection') ?? (window as any).app.tasks;
+    this.root = createRoot(this.el);
+    this.root.render(<TasksView collection={collection} />);
+  },
+  onBeforeDestroy(this: any) {
+    this.root?.unmount();
+    this.root = null;
+  },
+});
+
+(window as any).app.TasksView = TasksViewAdapter;
