+-- Athena (Trino) SQL. Executed by app/api.py after "DROP TABLE IF EXISTS analytics.daily".
+-- Assumes analytics.orders has a date partition column `dt` (replaces BigQuery's _PARTITIONDATE)
+-- and items is array(row(sku varchar, qty bigint)).
+CREATE TABLE analytics.daily
+WITH (table_type = 'ICEBERG', is_external = false,
+      location = 's3://${ANALYTICS_BUCKET}/tables/daily/') AS
+SELECT day, customer_id, amount, top_items, sessions
+FROM (
+  SELECT day, customer_id, amount, top_items, sessions,
+         ROW_NUMBER() OVER (PARTITION BY customer_id ORDER BY amount DESC) AS rn
+  FROM (
+    SELECT CAST(date_trunc('day', o.created_at) AS date) AS day,
+           o.customer_id,
+           SUM(TRY_CAST(o.amount AS DECIMAL(38, 9))) AS amount,
+           slice(array_agg(CAST(ROW(i.sku, i.qty) AS ROW(sku varchar, qty bigint)) ORDER BY i.qty DESC), 1, 3) AS top_items,
+           approx_distinct(o.session_id) AS sessions
+    FROM analytics.orders o
+    CROSS JOIN UNNEST(o.items) AS i (sku, qty)
+    WHERE o.dt >= date_add('day', -1, current_date)
+    GROUP BY 1, 2
+  )
+)
+WHERE rn <= 100;
