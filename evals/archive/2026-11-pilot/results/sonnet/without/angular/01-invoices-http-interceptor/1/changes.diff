+import angular from 'angular';
+import { react2angular } from 'react2angular';
+import { InvoiceList } from './InvoiceList';
+
+// Same name and binding as before, so customer-page.html is unchanged:
+//   <invoice-list customer-id="vm.customerId"></invoice-list>
+// '$http' is injected as a prop so the AngularJS authInterceptor still applies.
+angular
+  .module('billing')
+  .component('invoiceList', react2angular(InvoiceList, ['customerId'], ['$http']));
